<Project>
    <PropertyGroup Condition="'$(MSBuildProjectName)' != 'Lyricify.Lyrics.Helper'">
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <PackageId>$(MSBuildProjectName)</PackageId>
        <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/TwilightLemon/LemonNeo</PackageProjectUrl>
        <RepositoryUrl>https://github.com/TwilightLemon/LemonNeo</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Copyright>Copyright © 2026 TwilightLemon</Copyright>
    </PropertyGroup>
</Project>
