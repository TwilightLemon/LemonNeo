<UserControl
    ClipToBounds="False"
    IsHitTestVisible="False"
    x:Class="LemonNeo.Desktop.Controls.Shared.NotificationHost"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="Path.notification">
            <Setter Property="Data" Value="{StaticResource Icon.TrackDetails}" />
        </Style>
        <Style Selector="Path.notification.success">
            <Setter Property="Data" Value="{StaticResource Icon.Done}" />
            <Setter Property="Stroke" Value="{DynamicResource Brush.AccentText}" />
        </Style>
        <Style Selector="Path.notification.warning">
            <Setter Property="Data" Value="{StaticResource Icon.Warning}" />
            <Setter Property="Stroke" Value="{DynamicResource Brush.Danger}" />
        </Style>
        <Style Selector="Path.notification.error">
            <Setter Property="Data" Value="{StaticResource Icon.Close}" />
            <Setter Property="Stroke" Value="{DynamicResource Brush.Danger}" />
        </Style>
    </UserControl.Styles>
    <Border
        Background="{DynamicResource Brush.SurfaceRaised}"
        BorderBrush="{DynamicResource Brush.Border}"
        BorderThickness="1"
        BoxShadow="0 6 18 0 #30000000"
        CornerRadius="12"
        IsVisible="False"
        Name="Card"
        Opacity="0"
        Padding="14,12">
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Duration="{DynamicResource Motion.Fast}" Property="Opacity" />
            </Transitions>
        </Border.Transitions>
        <Border.RenderTransform>
            <TranslateTransform Y="10">
                <TranslateTransform.Transitions>
                    <Transitions>
                        <DoubleTransition Duration="{DynamicResource Motion.Fast}" Property="Y" />
                    </Transitions>
                </TranslateTransform.Transitions>
            </TranslateTransform>
        </Border.RenderTransform>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Path Classes="icon notification small" Name="NotificationIcon" VerticalAlignment="Center" />
            <TextBlock
                AutomationProperties.LiveSetting="Polite"
                Grid.Column="1"
                MaxLines="5"
                Name="NotificationText"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap"
                VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
