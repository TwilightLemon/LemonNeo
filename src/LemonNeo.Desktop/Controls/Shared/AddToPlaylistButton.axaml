<UserControl
    Name="Root"
    x:Class="LemonNeo.Desktop.Controls.Shared.AddToPlaylistButton"
    x:DataType="vm:TrackListViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:i18n="using:LemonNeo.Desktop.Services"
    xmlns:vm="using:LemonNeo.Desktop.ViewModels.Shared"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Button
        Classes.compact="{Binding IsCompact, ElementName=Root}"
        Classes.ghost="{Binding IsGhost, ElementName=Root}"
        Content="{Translate {x:Static i18n:LanguageManager+Keys.AddToPlaylist}}"
        IsEnabled="{Binding HasActionTracks}"
        Name="AddButton">
        <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel Spacing="12" Width="300">
                    <TextBlock FontWeight="SemiBold" Text="{Translate {x:Static i18n:LanguageManager+Keys.TargetPlaylist}}" />
                    <ListBox
                        AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.TargetPlaylist}}"
                        Classes="playlistPicker"
                        ItemTemplate="{StaticResource PlaylistOptionTemplate}"
                        ItemsSource="{Binding Playlists}"
                        MaxHeight="240"
                        Name="PlaylistPicker"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem="{Binding TargetPlaylist}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <TextBlock
                        Classes="caption"
                        IsVisible="{Binding !Playlists.Count}"
                        Text="{Translate {x:Static i18n:LanguageManager+Keys.NoTargetPlaylists}}"
                        TextWrapping="Wrap" />
                    <Separator />
                    <ToggleSwitch
                        AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.InsertPosition}}"
                        IsChecked="{Binding InsertAtStart}"
                        Name="InsertPosition"
                        OffContent="{Translate {x:Static i18n:LanguageManager+Keys.InsertAtEnd}}"
                        OnContent="{Translate {x:Static i18n:LanguageManager+Keys.InsertAtStart}}" />
                    <Button
                        Classes="primary"
                        Click="OnAdd"
                        Content="{Translate {x:Static i18n:LanguageManager+Keys.AddToPlaylist}}"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{Binding CanAddToPlaylist}"
                        Name="ConfirmAdd" />
                    <TextBlock
                        Foreground="{DynamicResource Brush.Danger}"
                        IsVisible="{Binding HasError}"
                        MaxHeight="80"
                        Text="{Binding Error}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>