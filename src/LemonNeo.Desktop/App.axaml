<Application
    Name="Lemon Neo"
    RequestedThemeVariant="Default"
    x:Class="LemonNeo.Desktop.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:theme="using:LemonNeo.Desktop.Resources.Themes"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <theme:ThemeResources />
                <ResourceInclude Source="/Resources/Themes/Tokens.axaml" />
                <ResourceInclude Source="/Resources/Themes/Icons.axaml" />
                <ResourceInclude Source="/Resources/Themes/Controls.axaml" />
                <ResourceInclude Source="/Resources/Themes/Templates.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <!--  The caption theme derives from Fluent's official drawn decorations.  -->
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources Accent="#627C16" x:Key="Light" />
                <ColorPaletteResources Accent="#DCEC7E" x:Key="Dark" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="/Resources/Themes/WindowChrome.axaml" />
        <StyleInclude Source="/Resources/Themes/Styles.axaml" />
    </Application.Styles>
</Application>