<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:LemonNeo.Desktop.ViewModels" xmlns:core="using:LemonNeo.Core">
  <DataTemplate x:Key="ProviderOptionTemplate" x:DataType="vm:ProviderOption">
    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
  </DataTemplate>
  <DataTemplate x:Key="PlaylistOptionTemplate" x:DataType="core:Playlist">
    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
  </DataTemplate>
  <DataTemplate x:Key="TrackRowTemplate" x:DataType="vm:TrackRow">
    <Grid MinHeight="44" ToolTip.Tip="{Binding Identity}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="38" />
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="Auto" SharedSizeGroup="TrackDuration" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Number}" Classes="caption" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Spacing="5" Margin="0,0,16,0">
        <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Artists}" Classes="caption" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <TextBlock Grid.Column="2" Text="{Binding Album}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
      <TextBlock Grid.Column="3" Text="{Binding Duration}" Classes="caption" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="MetadataMatchTemplate" x:DataType="vm:MetadataMatchRow">
    <StackPanel Spacing="6" Margin="0,8">
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Artists}" Classes="muted" TextWrapping="Wrap" />
      <WrapPanel>
        <TextBlock Text="{Binding Source}" Classes="caption" Margin="0,0,16,0" />
        <TextBlock Text="{Binding Confidence}" Classes="caption" Margin="0,0,16,0" />
        <TextBlock Text="{Binding Level}" Classes="caption" />
      </WrapPanel>
      <TextBlock Text="{Binding Album}" Classes="caption" TextWrapping="Wrap" />
      <SelectableTextBlock Text="{Binding ExternalIds}" TextWrapping="Wrap" />
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="PlaybackSourceTemplate" x:DataType="vm:PlaybackSourceRow">
    <StackPanel Spacing="6">
      <WrapPanel>
        <TextBlock Text="{Binding Provider}" FontWeight="SemiBold" Margin="0,0,16,0" />
        <TextBlock Text="{Binding Confidence}" Classes="muted" Margin="0,0,16,0" />
        <TextBlock Text="{Binding Method}" Classes="muted" />
      </WrapPanel>
      <TextBlock Text="{Binding Identity}" Classes="caption" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Location}" Classes="caption" TextWrapping="Wrap" MaxHeight="60" />
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
