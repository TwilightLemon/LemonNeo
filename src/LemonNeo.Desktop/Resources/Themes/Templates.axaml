<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:core="using:LemonNeo.Core.Library"
    xmlns:i18n="using:LemonNeo.Desktop.Services"
    xmlns:metadataVm="using:LemonNeo.Desktop.ViewModels.Metadata"
    xmlns:sharedControls="using:LemonNeo.Desktop.Controls.Shared"
    xmlns:sharedVm="using:LemonNeo.Desktop.ViewModels.Shared"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:DataType="sharedVm:ProviderOption" x:Key="ProviderOptionTemplate">
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>
    <DataTemplate x:DataType="core:Playlist" x:Key="PlaylistOptionTemplate">
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>
    <DataTemplate x:DataType="sharedVm:TrackRow" x:Key="TrackRowTemplate">
        <Border
            Classes="trackRow"
            Classes.current="{Binding IsCurrent}"
            Classes.marked="{Binding IsMarked}"
            CornerRadius="8">
            <Grid MinHeight="44" ToolTip.Tip="{Binding Identity}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition SharedSizeGroup="TrackDuration" Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Classes="caption"
                    IsVisible="{Binding !IsSelectionMode}"
                    Text="{Binding Number}"
                    VerticalAlignment="Center" />
                <CheckBox
                    AutomationProperties.Name="{Binding Title}"
                    IsChecked="{Binding IsMarked}"
                    IsVisible="{Binding IsSelectionMode}"
                    MinWidth="0"
                    VerticalAlignment="Center" />
                <sharedControls:Artwork
                    CornerRadius="8"
                    Grid.Column="1"
                    Height="44"
                    HorizontalAlignment="Left"
                    Loader="{Binding ArtworkLoader}"
                    Name="TrackArtwork"
                    SourceUri="{Binding ArtworkUri}"
                    VerticalAlignment="Center"
                    Width="44" />
                <StackPanel
                    Grid.Column="2"
                    Margin="0,0,16,0"
                    Spacing="5">
                    <TextBlock
                        FontWeight="Medium"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Classes="caption"
                        Text="{Binding Artists}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock
                    Classes="muted"
                    Grid.Column="3"
                    Margin="0,0,12,0"
                    Text="{Binding Album}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
                <TextBlock
                    Classes="caption"
                    Grid.Column="4"
                    HorizontalAlignment="Right"
                    Margin="12,0,0,0"
                    Text="{Binding Duration}"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>
    </DataTemplate>
    <DataTemplate x:DataType="metadataVm:MetadataMatchRow" x:Key="MetadataMatchTemplate">
        <Border
            Background="{DynamicResource Brush.SurfaceRaised}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="0,8"
            Padding="16">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="56,*">
                    <sharedControls:Artwork
                        CornerRadius="8"
                        Height="44"
                        HorizontalAlignment="Left"
                        Loader="{Binding ArtworkLoader}"
                        SourceUri="{Binding ArtworkUri}"
                        Width="44" />
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding Title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Classes="muted"
                            Text="{Binding Artists}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <WrapPanel>
                    <TextBlock
                        Classes="caption"
                        Margin="0,0,16,0"
                        Text="{Binding Source}" />
                    <TextBlock
                        Classes="caption"
                        Margin="0,0,16,0"
                        Text="{Binding Confidence}" />
                    <TextBlock Classes="caption" Text="{Binding Level}" />
                </WrapPanel>
                <TextBlock
                    Classes="caption"
                    Text="{Binding Album}"
                    TextWrapping="Wrap" />
                <SelectableTextBlock Text="{Binding ExternalIds}" TextWrapping="Wrap" />
                <WrapPanel Margin="0,8,0,0">
                    <Button
                        Command="{Binding ReplaceMetadataCommand}"
                        CommandParameter="{Binding}"
                        Content="{Translate {x:Static i18n:LanguageManager+Keys.ReplaceMatchMetadata}}"
                        Margin="0,0,10,8"
                        Name="ReplaceMatchMetadataButton" />
                    <Button
                        Command="{Binding AddExternalIdsCommand}"
                        CommandParameter="{Binding}"
                        Content="{Translate {x:Static i18n:LanguageManager+Keys.AddMatchExternalIds}}"
                        Margin="0,0,10,8"
                        Name="AddMatchExternalIdsButton" />
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Brush.AccentText}"
                        IsVisible="{Binding HasActionStatus}"
                        Margin="2,0,0,8"
                        Text="{Binding ActionStatus}"
                        VerticalAlignment="Center" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </DataTemplate>
    <DataTemplate x:DataType="metadataVm:PlaybackSourceRow" x:Key="PlaybackSourceTemplate">
        <StackPanel Spacing="6">
            <WrapPanel>
                <TextBlock
                    FontWeight="SemiBold"
                    Margin="0,0,16,0"
                    Text="{Binding Provider}" />
                <TextBlock
                    Classes="muted"
                    Margin="0,0,16,0"
                    Text="{Binding Quality}" />
                <TextBlock Classes="muted" Text="{Binding Method}" />
            </WrapPanel>
            <TextBlock
                Classes="caption"
                Text="{Binding Identity}"
                TextWrapping="Wrap" />
            <TextBlock
                Classes="caption"
                MaxHeight="60"
                Text="{Binding Location}"
                TextWrapping="Wrap" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>