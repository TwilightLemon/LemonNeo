<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:converters="using:Avalonia.Data.Converters"
    xmlns:core="using:LemonNeo.Core.Library"
    xmlns:i18n="using:LemonNeo.Desktop.Services"
    xmlns:metadataVm="using:LemonNeo.Desktop.ViewModels.Metadata"
    xmlns:playbackControls="using:LemonNeo.Desktop.Controls.Playback"
    xmlns:sharedControls="using:LemonNeo.Desktop.Controls.Shared"
    xmlns:sharedVm="using:LemonNeo.Desktop.ViewModels.Shared"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:DataType="sharedVm:ProviderOption" x:Key="ProviderOptionTemplate">
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>
    <DataTemplate x:DataType="sharedVm:ProviderOption" x:Key="ProviderTabHeaderTemplate">
        <TextBlock
            Foreground="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=ContentPresenter, Tree=Visual}}"
            Text="{Binding Name}" />
    </DataTemplate>
    <DataTemplate x:DataType="core:Playlist" x:Key="PlaylistOptionTemplate">
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>
    <DataTemplate x:DataType="sharedVm:TrackRow" x:Key="TrackRowTemplate">
        <Border
            Classes="trackRow"
            Classes.current="{Binding IsCurrent}"
            Classes.marked="{Binding IsMarked}"
            CornerRadius="8">
            <Grid MinHeight="44" ToolTip.Tip="{Binding Identity}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition SharedSizeGroup="TrackDuration" Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Classes="caption"
                    Text="{Binding Number}"
                    VerticalAlignment="Center">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static converters:BoolConverters.And}">
                            <Binding Path="!IsSelectionMode" />
                            <Binding Path="!IsCurrent" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>
                <CheckBox
                    AutomationProperties.Name="{Binding Title}"
                    HorizontalAlignment="Left"
                    IsChecked="{Binding IsMarked}"
                    IsVisible="{Binding IsSelectionMode}"
                    MinWidth="0"
                    VerticalAlignment="Center" />
                <playbackControls:NowPlayingIndicator
                    Classes.managing="{Binding IsSelectionMode}"
                    Classes.playing="{Binding $parent[ListBox].((sharedVm:TrackListViewModel)DataContext).Playback.IsPlaying}"
                    Classes.reduceMotion="{Binding $parent[ListBox].((sharedVm:TrackListViewModel)DataContext).Playback.ReduceMotion}"
                    IsVisible="{Binding IsCurrent}" />
                <sharedControls:Artwork
                    CornerRadius="8"
                    Grid.Column="1"
                    Height="44"
                    HorizontalAlignment="Left"
                    Loader="{Binding ArtworkLoader}"
                    Name="TrackArtwork"
                    SourceUri="{Binding ArtworkUri}"
                    VerticalAlignment="Center"
                    Width="44" />
                <StackPanel
                    Grid.Column="2"
                    Margin="0,0,16,0"
                    Spacing="5">
                    <TextBlock
                        Classes="trackTitle"
                        FontWeight="Medium"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Classes="caption"
                        IsVisible="{Binding !HasArtistLinks}"
                        Text="{Binding Artists}"
                        TextTrimming="CharacterEllipsis" />
                    <ItemsControl ClipToBounds="True" IsVisible="{Binding HasArtistLinks}" ItemsSource="{Binding ArtistLinks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sharedVm:ArtistLink">
                                <Panel>
                                    <TextBlock Classes="caption" IsVisible="{Binding !CanOpen}" Text="{Binding Name}" />
                                    <Button
                                        Classes="catalogLink"
                                        Command="{Binding $parent[ListBox].((sharedVm:TrackListViewModel)DataContext).OpenCatalogItemCommand}"
                                        CommandParameter="{Binding Item}"
                                        IsVisible="{Binding CanOpen}">
                                        <TextBlock Classes="caption" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </Panel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <TextBlock
                    Classes="muted"
                    Grid.Column="3"
                    IsVisible="{Binding !HasAlbumLink}"
                    Margin="0,0,12,0"
                    Text="{Binding Album}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
                <Button
                    Classes="catalogLink"
                    Command="{Binding $parent[ListBox].((sharedVm:TrackListViewModel)DataContext).OpenCatalogItemCommand}"
                    CommandParameter="{Binding AlbumLink}"
                    Grid.Column="3"
                    HorizontalAlignment="Left"
                    IsVisible="{Binding HasAlbumLink}"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center">
                    <TextBlock Classes="muted" Text="{Binding Album}" TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock
                    Classes="caption"
                    Grid.Column="4"
                    HorizontalAlignment="Right"
                    Margin="12,0,0,0"
                    Text="{Binding Duration}"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>
    </DataTemplate>
    <DataTemplate x:DataType="metadataVm:MetadataMatchRow" x:Key="MetadataMatchTemplate">
        <Border
            Background="{DynamicResource Brush.SurfaceRaised}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="0,8"
            Padding="16">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="56,*">
                    <sharedControls:Artwork
                        CornerRadius="8"
                        Height="44"
                        HorizontalAlignment="Left"
                        Loader="{Binding ArtworkLoader}"
                        SourceUri="{Binding ArtworkUri}"
                        Width="44" />
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding Title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Classes="muted"
                            Text="{Binding Artists}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <WrapPanel>
                    <TextBlock
                        Classes="caption"
                        Margin="0,0,16,0"
                        Text="{Binding Source}" />
                    <TextBlock
                        Classes="caption"
                        Margin="0,0,16,0"
                        Text="{Binding Confidence}" />
                    <TextBlock Classes="caption" Text="{Binding Level}" />
                </WrapPanel>
                <TextBlock
                    Classes="caption"
                    Text="{Binding Album}"
                    TextWrapping="Wrap" />
                <SelectableTextBlock Text="{Binding ExternalIds}" TextWrapping="Wrap" />
                <WrapPanel Margin="0,8,0,0">
                    <Button
                        Command="{Binding ReplaceMetadataCommand}"
                        CommandParameter="{Binding}"
                        Content="{Translate {x:Static i18n:LanguageManager+Keys.ReplaceMatchMetadata}}"
                        Margin="0,0,10,8"
                        Name="ReplaceMatchMetadataButton" />
                    <Button
                        Command="{Binding AddExternalIdsCommand}"
                        CommandParameter="{Binding}"
                        Content="{Translate {x:Static i18n:LanguageManager+Keys.AddMatchExternalIds}}"
                        Margin="0,0,10,8"
                        Name="AddMatchExternalIdsButton" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </DataTemplate>
    <DataTemplate x:DataType="metadataVm:PlaybackSourceRow" x:Key="PlaybackSourceTemplate">
        <StackPanel Spacing="6">
            <WrapPanel>
                <TextBlock
                    FontWeight="SemiBold"
                    Margin="0,0,16,0"
                    Text="{Binding Provider}" />
                <TextBlock
                    Classes="muted"
                    Margin="0,0,16,0"
                    Text="{Binding Quality}" />
                <TextBlock Classes="muted" Text="{Binding Method}" />
            </WrapPanel>
            <TextBlock
                Classes="caption"
                Text="{Binding Identity}"
                TextWrapping="Wrap" />
            <TextBlock
                Classes="caption"
                MaxHeight="60"
                Text="{Binding Location}"
                TextWrapping="Wrap" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
