<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <!--  Retain Avalonia's caption actions, resize behavior, and fullscreen popover.  -->
        <ControlTheme
            BasedOn="{StaticResource {x:Type WindowDrawnDecorations}}"
            TargetType="WindowDrawnDecorations"
            x:Key="LemonWindowDecorations">
            <!--  Reuse the existing toolbar as the drag area; keep only the three standard window buttons.  -->
            <Style Selector="^ /template/ Panel#PART_TitleBar">
                <Setter Property="Opacity" Value="0" />
            </Style>
            <Style Selector="^ /template/ Panel#PART_TitleTextPanel">
                <Setter Property="Opacity" Value="0" />
            </Style>
            <Style Selector="^ /template/ Button#PART_FullScreenButton">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </ControlTheme>
    </Styles.Resources>
</Styles>