<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:LemonNeo.Desktop.Controls" xmlns:vm="using:LemonNeo.Desktop.ViewModels" xmlns:i18n="using:LemonNeo.Desktop.Infrastructure"
             x:Class="LemonNeo.Desktop.Views.SearchView" x:DataType="vm:SearchViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <controls:PageHeader Title="{Binding PageTitle}" Summary="{Binding PageSummary}">
      <controls:PageHeader.Actions>
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsBusy}" ToolTip.Tip="{Binding Status}">
          <ProgressBar IsIndeterminate="True" Width="60" Height="3" VerticalAlignment="Center" AutomationProperties.Name="{Binding Status}" />
          <Button Classes="ghost" Command="{Binding CancelOperationCommand}" Content="{Translate {x:Static i18n:LanguageManager+Keys.CancelOperation}}" />
        </StackPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>
    <Border Grid.Row="1" IsVisible="{Binding HasError}" Background="{DynamicResource Brush.DangerSoft}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" MaxHeight="90" />
        <Button Grid.Column="1" Classes="ghost" Content="×" Command="{Binding DismissErrorCommand}" AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.DismissError}}" />
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <Grid RowDefinitions="Auto,*">
        <WrapPanel Margin="0,0,0,12" IsEnabled="{Binding CanInteract}">
          <Button Classes="primary" Content="{Translate {x:Static i18n:LanguageManager+Keys.Play}}" Command="{Binding PlaySelectedCommand}" IsEnabled="{Binding CanInspectTrack}" Margin="0,0,8,8" />
          <Button Content="{Translate {x:Static i18n:LanguageManager+Keys.TrackDetails}}" Command="{Binding InspectTrackCommand}" IsEnabled="{Binding CanInspectTrack}" Margin="0,0,8,8" />
          <Button Content="{Translate {x:Static i18n:LanguageManager+Keys.AddToPlaylist}}" IsEnabled="{Binding CanInspectTrack}" Margin="0,0,8,8">
            <Button.Flyout>
              <Flyout>
                <StackPanel Width="280" Spacing="12">
                  <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.TargetPlaylist}}" />
                  <ComboBox ItemsSource="{Binding Playlists}" SelectedItem="{Binding TargetPlaylist}" ItemTemplate="{StaticResource PlaylistOptionTemplate}"
                            HorizontalAlignment="Stretch" AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.TargetPlaylist}}" />
                  <Button Classes="primary" Content="{Translate {x:Static i18n:LanguageManager+Keys.AddToPlaylist}}" Command="{Binding AddToPlaylistCommand}" IsEnabled="{Binding CanAddToPlaylist}" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </WrapPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}" ItemTemplate="{StaticResource TrackRowTemplate}" Grid.IsSharedSizeScope="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 IsVisible="{Binding HasTracks}" IsEnabled="{Binding CanInteract}" DoubleTapped="OnTrackDoubleTapped" KeyDown="OnTrackKeyDown" />
        <StackPanel Grid.Row="1" IsVisible="{Binding !HasTracks}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400" Spacing="8">
          <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.NoResults}}" FontSize="20" TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.NoResultsDescription}}" Classes="caption" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
