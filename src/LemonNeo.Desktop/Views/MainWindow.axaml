<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LemonNeo.Desktop.ViewModels" xmlns:core="using:LemonNeo.Core"
        xmlns:views="using:LemonNeo.Desktop.Views" xmlns:controls="using:LemonNeo.Desktop.Controls"
        xmlns:i18n="using:LemonNeo.Desktop.Infrastructure"
        x:Class="LemonNeo.Desktop.Views.MainWindow" x:DataType="vm:MainViewModel"
        Title="Lemon Neo" Width="1180" Height="790" MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterScreen">
  <Grid Name="ShellRoot" RowDefinitions="56,*,Auto" ColumnDefinitions="230,1,*" ClipToBounds="True">
    <Border Name="Sidebar" Grid.RowSpan="3" Background="{DynamicResource Brush.Sidebar}" Padding="16,20,16,12">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Margin="12,0,0,16" Spacing="7">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Background="{DynamicResource Brush.Accent}" CornerRadius="12" Width="34" Height="34">
              <Path Classes="icon" Data="{StaticResource Icon.Music}" Fill="{DynamicResource Brush.OnAccent}" />
            </Border>
            <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.AppName}}" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Classes="caption" Text="{Translate {x:Static i18n:LanguageManager+Keys.Tagline}}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,12">
          <Button Classes="nav" Classes.active="{Binding Navigation.IsLibrary}" Command="{Binding Navigation.NavigateCommand}" CommandParameter="Library">
            <StackPanel Orientation="Horizontal" Spacing="12"><Path Classes="icon" Data="{StaticResource Icon.Library}" /><TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Library}}" /></StackPanel>
          </Button>
          <Button Classes="nav" Classes.active="{Binding Navigation.IsSearch}" Command="{Binding Navigation.NavigateCommand}" CommandParameter="Search">
            <StackPanel Orientation="Horizontal" Spacing="12"><Path Classes="icon" Data="{StaticResource Icon.Search}" /><TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Search}}" /></StackPanel>
          </Button>
          <Button Classes="nav" Classes.active="{Binding Navigation.IsOnline}" Command="{Binding Navigation.NavigateCommand}" CommandParameter="Online">
            <StackPanel Orientation="Horizontal" Spacing="12"><Path Classes="icon" Data="{StaticResource Icon.Folder}" /><TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Online}}" /></StackPanel>
          </Button>
        </StackPanel>
        <Grid Grid.Row="2" RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="16,0,8,4">
            <TextBlock Classes="caption" Text="{Translate {x:Static i18n:LanguageManager+Keys.Playlists}}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="ghost icon" Click="OnCreatePlaylist" IsEnabled="{Binding SharedContext.IsInitialized}"
                    ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.CreatePlaylist}}" AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.CreatePlaylist}}">
              <Path Classes="icon" Data="{StaticResource Icon.Add}" />
            </Button>
          </Grid>
          <ListBox Grid.Row="1" ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist}" IsEnabled="{Binding SharedContext.IsInitialized}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:Playlist"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Classes="caption" Text="{Binding Items.Count}" Margin="8,0,0,0" VerticalAlignment="Center" /></Grid></DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
        <StackPanel Grid.Row="3" Spacing="4" Margin="0,8,0,0">
          <Button Classes="nav" Classes.active="{Binding Navigation.IsTools}" Command="{Binding Navigation.NavigateCommand}" CommandParameter="Tools">
            <StackPanel Orientation="Horizontal" Spacing="12"><Path Classes="icon" Data="{StaticResource Icon.Queue}" /><TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Tools}}" /></StackPanel>
          </Button>
          <Button Classes="nav" Classes.active="{Binding Navigation.IsSettings}" Command="{Binding Navigation.NavigateCommand}" CommandParameter="Settings">
            <StackPanel Orientation="Horizontal" Spacing="12"><Path Classes="icon" Data="{StaticResource Icon.Settings}" /><TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Settings}}" /></StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Column="1" Grid.RowSpan="3" Background="{DynamicResource Brush.Border}" />
    <Border Name="TopBar" Grid.Column="2" Padding="24,10" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Name="BackButton" Classes="ghost compact" Command="{Binding Navigation.BackCommand}" ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Back}}" AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Back}}">
            <Path Classes="icon" Data="{StaticResource Icon.Back}" />
          </Button>
          <Button Name="ForwardButton" Classes="ghost compact" Command="{Binding Navigation.ForwardCommand}" ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Forward}}" AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Forward}}">
            <Path Classes="icon" Data="{StaticResource Icon.Forward}" />
          </Button>
        </StackPanel>
        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Width="420" HorizontalAlignment="Left" Margin="16,0,12,0" VerticalAlignment="Center">
          <TextBox Name="GlobalSearch" Classes="toolbarSearch" Text="{Binding SearchQuery}" KeyDown="OnSearchKeyDown"
                   PlaceholderText="{Translate {x:Static i18n:LanguageManager+Keys.SearchMusic}}"
                   AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.SearchMusic}}" IsEnabled="{Binding SharedContext.IsInitialized}" />
          <Button Grid.Column="1" Classes="ghost compact" Margin="4,0,0,0" Command="{Binding SearchCommand}"
                  ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.SearchMusic}}" AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.SearchMusic}}">
            <Path Classes="icon" Data="{StaticResource Icon.Search}" />
          </Button>
        </Grid>
        <ProgressBar Grid.Column="2" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="40" Height="3" VerticalAlignment="Center" AutomationProperties.Name="{Binding Status}" />
      </Grid>
    </Border>
    <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,*" Margin="32,20,32,24">
      <Border IsVisible="{Binding HasError}" Background="{DynamicResource Brush.DangerSoft}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" MaxHeight="90" />
          <Button Grid.Column="1" Classes="ghost" Content="{Translate {x:Static i18n:LanguageManager+Keys.Retry}}" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" IsVisible="{Binding CanRetryStartup}" />
          <Button Grid.Column="2" Classes="ghost" Content="×" Command="{Binding DismissErrorCommand}" AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.DismissError}}" />
        </Grid>
      </Border>
      <ContentControl Name="PageContent" Grid.Row="1" Content="{Binding Navigation.Host}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
    <Border Name="PlaybackBar" Grid.Row="2" Grid.Column="2" MinHeight="96" Background="{DynamicResource Brush.Surface}">
      <Grid>
        <Grid RowDefinitions="Auto,*" Margin="20,16">
          <Grid IsVisible="{Binding Playback.HasError}" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
            <TextBlock Text="{Binding Playback.Error}" Foreground="{DynamicResource Brush.Danger}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Playback.Error}" />
            <Button Grid.Column="1" Classes="ghost compact" Content="×" MinHeight="20" Height="20" Padding="4,0" Command="{Binding Playback.DismissErrorCommand}" AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.DismissError}}" />
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*">
            <Button Name="NowPlayingButton" Classes="ghost" Command="{Binding Navigation.NavigateCommand}" CommandParameter="Lyrics"
                    HorizontalContentAlignment="Stretch" Padding="8,0" Margin="0,0,20,0" CornerRadius="12"
                    ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Lyrics}}" AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Lyrics}}">
              <Grid ColumnDefinitions="48,*">
                <controls:Artwork Width="48" Height="48" CornerRadius="10" Source="{Binding Playback.NowArtwork}"
                                  VerticalAlignment="Center" AutomationProperties.Name="{Binding Playback.NowTitle}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" Spacing="4">
                  <TextBlock Text="{Binding Playback.NowTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Playback.NowTitle}" />
                  <TextBlock Text="{Binding Playback.NowArtist}" Classes="caption" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Playback.NowArtist}" />
                </StackPanel>
              </Grid>
            </Button>
            <StackPanel Name="PlaybackControls" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <Button Name="PreviousButton" Classes="ghost icon" Command="{Binding Playback.PreviousCommand}" IsEnabled="{Binding Playback.CanPrevious}" Padding="0"
                      ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Previous}}" AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Previous}}">
                <Viewbox Height="22" MaxWidth="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path Data="{StaticResource Icon.Playback.Previous}" Fill="{DynamicResource Brush.Text}" Stretch="Uniform" />
                </Viewbox>
              </Button>
              <Button Name="PlayPauseButton" Classes="primary" Command="{Binding Playback.TogglePlaybackCommand}" IsEnabled="{Binding Playback.CanTogglePlayback}"
                      Width="48" Height="48" Padding="0" CornerRadius="24" ToolTip.Tip="{Binding Playback.PlayLabel}" AutomationProperties.Name="{Binding Playback.PlayLabel}">
                <Grid>
                  <Viewbox Height="24" MaxWidth="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !Playback.IsPlaying}">
                    <Path Data="{StaticResource Icon.Playback.Play}" Fill="{DynamicResource Brush.OnAccent}" Stretch="Uniform" />
                  </Viewbox>
                  <Viewbox Height="24" MaxWidth="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Playback.IsPlaying}">
                    <Path Data="{StaticResource Icon.Playback.Pause}" Fill="{DynamicResource Brush.OnAccent}" Stretch="Uniform" />
                  </Viewbox>
                </Grid>
              </Button>
              <Button Name="NextButton" Classes="ghost icon" Command="{Binding Playback.NextCommand}" IsEnabled="{Binding Playback.CanNext}" Padding="0"
                      ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Next}}" AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Next}}">
                <Viewbox Height="22" MaxWidth="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path Data="{StaticResource Icon.Playback.Next}" Fill="{DynamicResource Brush.Text}" Stretch="Uniform" />
                </Viewbox>
              </Button>
            </StackPanel>
            <Grid Grid.Column="2" ColumnDefinitions="Auto,*" Margin="16,0,0,0">
              <Button Name="PlaybackModeButton" Classes="ghost icon" Padding="0" Command="{Binding Playback.CycleModeCommand}" IsEnabled="{Binding Playback.CanInteract}"
                      VerticalAlignment="Center" ToolTip.Tip="{Binding Playback.ModeLabel}" AutomationProperties.Name="{Binding Playback.ModeLabel}">
                <Grid>
                  <Viewbox Height="20" MaxWidth="22" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Playback.IsSequential}">
                    <Path Data="{StaticResource Icon.Playback.Sequential}" Fill="{DynamicResource Brush.TextSecondary}" Stretch="Uniform" />
                  </Viewbox>
                  <Viewbox Height="20" MaxWidth="22" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Playback.IsRepeatAll}">
                    <Path Data="{StaticResource Icon.Playback.RepeatAll}" Fill="{DynamicResource Brush.TextSecondary}" Stretch="Uniform" />
                  </Viewbox>
                  <Viewbox Height="20" MaxWidth="22" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Playback.IsShuffle}">
                    <Path Data="{StaticResource Icon.Playback.Shuffle}" Fill="{DynamicResource Brush.TextSecondary}" Stretch="Uniform" />
                  </Viewbox>
                </Grid>
              </Button>
              <Grid Grid.Column="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="8,0,0,0">
                <TextBlock Text="{Binding Playback.TimeLabel}" Classes="caption" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <Button Name="QueueButton" Grid.Column="1" Classes="ghost icon" Command="{Binding ToggleQueueCommand}" Padding="0" Margin="8,0,0,0"
                        ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Queue}}" AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Queue}}">
                  <Viewbox Height="20" MaxWidth="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{StaticResource Icon.Playback.Queue}" Fill="{DynamicResource Brush.TextSecondary}" Stretch="Uniform" />
                  </Viewbox>
                </Button>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
        <Slider Name="Timeline" Theme="{StaticResource PlaybackTimeline}" Minimum="0" Maximum="{Binding Playback.DurationSeconds}"
                Value="{Binding Playback.PositionSeconds, Mode=OneWay}" IsEnabled="{Binding Playback.CanSeek}" Margin="0,-10,0,0" VerticalAlignment="Top"
                AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Seek}}" />
        <ProgressBar Name="PlaybackLoading" IsIndeterminate="True" IsVisible="{Binding Playback.IsBusy}" Height="2" MinHeight="0" Margin="0,-1,0,0"
                     VerticalAlignment="Top" Background="Transparent" Foreground="{DynamicResource Brush.AccentText}" IsHitTestVisible="False" AutomationProperties.Name="{Binding Playback.Status}" />
      </Grid>
    </Border>
    <Popup Name="QueuePopup" IsOpen="{Binding IsQueueOpen, Mode=TwoWay}" PlacementTarget="ShellRoot"
           Placement="AnchorAndGravity" PlacementAnchor="TopRight" PlacementGravity="BottomLeft" PlacementConstraintAdjustment="None"
           ShouldUseOverlayLayer="True" IsLightDismissEnabled="True" OverlayDismissEventPassThrough="False"
           Opened="OnQueueOpened" Closed="OnQueueClosed">
      <Border Name="QueueCard" Width="380" Height="{Binding #ShellRoot.Bounds.Height}" CornerRadius="16,0,0,16"
              Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0" Padding="20,24,20,16"
              Focusable="True" KeyDown="OnQueueKeyDown">
        <Grid>
          <ContentControl Content="{Binding QueueDrawer}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <ContentControl.DataTemplates>
              <DataTemplate DataType="{x:Type vm:PlaybackQueueViewModel}"><views:QueueDrawerView /></DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>
          <Button Name="CloseQueueButton" Classes="ghost compact" Content="×" Command="{Binding CloseQueueCommand}" HorizontalAlignment="Right" VerticalAlignment="Top"
                  ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.CloseQueue}}" AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.CloseQueue}}" />
        </Grid>
      </Border>
    </Popup>
  </Grid>
</Window>
