<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LemonNeo.Desktop.ViewModels" xmlns:i18n="using:LemonNeo.Desktop.Infrastructure"
             xmlns:controls="using:LemonNeo.Desktop.Controls"
             x:Class="LemonNeo.Desktop.Views.QueueDrawerView" x:DataType="vm:PlaybackQueueViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <StackPanel Spacing="6" Margin="0,0,40,0">
      <TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Classes="caption" Text="{Binding TrackCount}" />
    </StackPanel>
    <TextBox Name="QueueFilter" Grid.Row="1" Text="{Binding Filter}" Margin="0,16,0,12"
             PlaceholderText="{Translate {x:Static i18n:LanguageManager+Keys.SearchPlaceholder}}"
             AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.SearchPlaceholder}}" />
    <ListBox Name="QueueTracks" Grid.Row="2" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}"
             IsVisible="{Binding HasTracks}" Tapped="OnTrackTapped" KeyDown="OnTrackKeyDown"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.Styles>
        <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,2" /></Style>
        <Style Selector="Border.queueTrack"><Setter Property="Background" Value="Transparent" /></Style>
        <Style Selector="Border.queueTrack.current"><Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" /></Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:QueueTrackViewModel">
          <Border Classes="queueTrack" Classes.current="{Binding IsCurrent}" CornerRadius="10" Padding="8,12" MinHeight="64" ToolTip.Tip="{Binding Row.Title}">
            <Grid ColumnDefinitions="4,56,*,Auto">
              <Border IsVisible="{Binding IsCurrent}" Width="3" Height="24" CornerRadius="2" Background="{DynamicResource Brush.AccentText}" VerticalAlignment="Center" />
              <controls:Artwork Name="QueueTrackArtwork" Grid.Column="1" Width="40" Height="40" CornerRadius="8"
                                VerticalAlignment="Center" SourceUri="{Binding Row.ArtworkUri}" Loader="{Binding Row.ArtworkLoader}" />
              <StackPanel Grid.Column="2" Spacing="5" Margin="8,0,8,0">
                <TextBlock Text="{Binding Row.Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="caption" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Grid.Column="3" Classes="caption" Text="{Binding Row.Duration}" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="2" IsVisible="{Binding !HasTracks}" VerticalAlignment="Center" Spacing="8" Margin="12">
      <TextBlock Text="{Binding EmptyTitle}" FontSize="20" TextWrapping="Wrap" TextAlignment="Center" />
      <TextBlock Classes="caption" Text="{Binding EmptyDescription}" TextWrapping="Wrap" TextAlignment="Center" />
    </StackPanel>
    <Button Name="ClearQueueButton" Grid.Row="3" Classes="ghost" HorizontalAlignment="Right" Margin="0,12,0,0"
            Content="{Translate {x:Static i18n:LanguageManager+Keys.ClearQueue}}" Command="{Binding ClearQueueCommand}" IsEnabled="{Binding CanClearQueue}" />
  </Grid>
</UserControl>
