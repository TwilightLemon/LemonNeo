<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sharedControls="using:LemonNeo.Desktop.Controls.Shared" xmlns:toolsVm="using:LemonNeo.Desktop.ViewModels.Tools" xmlns:i18n="using:LemonNeo.Desktop.Services"
             x:Class="LemonNeo.Desktop.Views.Tools.ToolsView" x:DataType="toolsVm:ToolsViewModel">
  <UserControl.Resources>
    <ItemsPanelTemplate x:Key="PluginTagsPanel"><WrapPanel /></ItemsPanelTemplate>
    <DataTemplate x:Key="PluginNamespaceTemplate" x:DataType="x:String">
      <Border Classes="namespaceTag"><SelectableTextBlock Text="{Binding}" FontFamily="{DynamicResource Font.Code}" FontSize="12" TextWrapping="Wrap" /></Border>
    </DataTemplate>
    <DataTemplate x:Key="PluginCapabilityTemplate" x:DataType="x:String">
      <Border Classes="capabilityTag"><TextBlock Text="{Binding}" Classes="caption" TextWrapping="Wrap" /></Border>
    </DataTemplate>
    <DataTemplate x:Key="PluginDetailTemplate" x:DataType="toolsVm:PluginDetail">
      <Grid ColumnDefinitions="140,*" Margin="0,0,0,10">
        <TextBlock Text="{Binding Label}" Classes="caption" TextWrapping="Wrap" Margin="0,2,12,0" />
        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.namespaceTag, Border.capabilityTag">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="Margin" Value="0,0,8,6" />
      <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    </Style>
    <Style Selector="ItemsControl.playableNamespaces Border.namespaceTag"><Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" /></Style>
    <Style Selector="ItemsControl.playableNamespaces SelectableTextBlock"><Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" /></Style>
    <Style Selector="Expander.pluginDetails"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*">
    <sharedControls:PageHeader Title="{Binding PageTitle}" Summary="{Binding PageSummary}">
      <sharedControls:PageHeader.Actions>
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsBusy}" ToolTip.Tip="{Binding Status}">
          <ProgressBar IsIndeterminate="True" Width="60" Height="3" VerticalAlignment="Center" AutomationProperties.Name="{Binding Status}" />
          <Button Classes="ghost" Command="{Binding CancelOperationCommand}" Content="{Translate {x:Static i18n:LanguageManager+Keys.CancelOperation}}" />
        </StackPanel>
      </sharedControls:PageHeader.Actions>
    </sharedControls:PageHeader>
    <Border Grid.Row="1" IsVisible="{Binding HasError}" Background="{DynamicResource Brush.DangerSoft}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" MaxHeight="90" />
        <Button Grid.Column="1" Classes="ghost" Content="×" Command="{Binding DismissErrorCommand}" AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.DismissError}}" />
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <TabControl>
        <TabItem Header="{Translate {x:Static i18n:LanguageManager+Keys.Plugins}}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="18" Margin="0,16,12,16">
              <Border Classes="card">
                <StackPanel Spacing="16">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.PluginOverview}}" Classes="section" />
                    <TextBlock Text="{Binding PluginSummary}" Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.SupportedNamespaces}}" FontWeight="SemiBold" />
                    <ItemsControl x:Name="SupportedNamespacesList" ItemsSource="{Binding SupportedNamespaces}" ItemsPanel="{StaticResource PluginTagsPanel}" ItemTemplate="{StaticResource PluginNamespaceTemplate}" />
                    <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.NoSupportedNamespaces}}" Classes="caption" IsVisible="{Binding !HasSupportedNamespaces}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.PlayableNamespaces}}" FontWeight="SemiBold" />
                    <ItemsControl x:Name="PlayableNamespacesList" Classes="playableNamespaces" ItemsSource="{Binding PlayableNamespaces}" ItemsPanel="{StaticResource PluginTagsPanel}" ItemTemplate="{StaticResource PluginNamespaceTemplate}" />
                    <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.NoPlayableNamespaces}}" Classes="caption" IsVisible="{Binding !HasPlayableNamespaces}" TextWrapping="Wrap" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.NoLoadedPlugins}}" Classes="muted" IsVisible="{Binding !HasProviderGroups}" TextWrapping="Wrap" />
              <ItemsControl x:Name="PluginProviderGroups" ItemsSource="{Binding ProviderGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="toolsVm:PluginProviderGroup">
                    <StackPanel Spacing="12" Margin="0,0,0,24">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding Name}" Classes="section" />
                        <TextBlock Text="{Binding Count}" Classes="caption" VerticalAlignment="Center" />
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="toolsVm:PluginInformation">
                            <Border Classes="card" Margin="0,0,0,12">
                              <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                  <TextBlock Text="{Binding Name}" Classes="section" TextWrapping="Wrap" />
                                  <SelectableTextBlock Text="{Binding Id}" FontFamily="{DynamicResource Font.Code}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" />
                                  <TextBlock Text="{Binding PluginSummary}" Classes="caption" IsVisible="{Binding HasPluginSummary}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" Classes="muted" IsVisible="{Binding HasDescription}" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Capabilities}" ItemsPanel="{StaticResource PluginTagsPanel}" ItemTemplate="{StaticResource PluginCapabilityTemplate}" />
                                <StackPanel Spacing="6" IsVisible="{Binding HasSupportedNamespaces}">
                                  <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.SupportedNamespaces}}" Classes="caption" />
                                  <ItemsControl ItemsSource="{Binding SupportedNamespaces}" ItemsPanel="{StaticResource PluginTagsPanel}" ItemTemplate="{StaticResource PluginNamespaceTemplate}" />
                                </StackPanel>
                                <StackPanel Spacing="6" IsVisible="{Binding HasPlayableNamespaces}">
                                  <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.PlayableNamespaces}}" Classes="caption" />
                                  <ItemsControl Classes="playableNamespaces" ItemsSource="{Binding PlayableNamespaces}" ItemsPanel="{StaticResource PluginTagsPanel}" ItemTemplate="{StaticResource PluginNamespaceTemplate}" />
                                </StackPanel>
                                <Expander Classes="pluginDetails" Header="{Translate {x:Static i18n:LanguageManager+Keys.PluginDetails}}" IsVisible="{Binding HasDetails}">
                                  <ItemsControl ItemsSource="{Binding Details}" ItemTemplate="{StaticResource PluginDetailTemplate}" Margin="0,12,0,0" />
                                </Expander>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Background="{DynamicResource Brush.DangerSoft}" CornerRadius="10" Padding="20" IsVisible="{Binding HasPluginFailures}">
                <StackPanel Spacing="12">
                  <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.PluginLoadFailures}}" Classes="section" Foreground="{DynamicResource Brush.Danger}" />
                  <ItemsControl ItemsSource="{Binding PluginFailures}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="toolsVm:PluginDetail">
                        <StackPanel Spacing="4" Margin="0,0,0,8">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <SelectableTextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="{Translate {x:Static i18n:LanguageManager+Keys.Sync}}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="18" Margin="0,16,12,16" IsEnabled="{Binding CanInteract}">
              <Border Classes="card">
                <StackPanel Spacing="12">
                  <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Library}}" Classes="section" />
                  <WrapPanel>
                    <Button Content="{Translate {x:Static i18n:LanguageManager+Keys.Save}}" Command="{Binding SaveCommand}" Margin="0,0,10,8" />
                    <Button Content="{Translate {x:Static i18n:LanguageManager+Keys.Refresh}}" Command="{Binding RefreshCommand}" Margin="0,0,0,8" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.SyncDescription}}" Classes="muted" TextWrapping="Wrap" />
              <ComboBox ItemsSource="{Binding SyncProviders}" SelectedItem="{Binding SelectedSyncProvider}" ItemTemplate="{StaticResource ProviderOptionTemplate}"
                        HorizontalAlignment="Stretch" AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.SyncProvider}}" />
              <WrapPanel>
                <Button Content="{Translate {x:Static i18n:LanguageManager+Keys.SyncStatus}}" Command="{Binding SyncCommand}" CommandParameter="status" Margin="0,0,10,8" />
                <Button Content="{Translate {x:Static i18n:LanguageManager+Keys.SyncPull}}" Command="{Binding SyncCommand}" CommandParameter="pull" Margin="0,0,10,8" />
                <Button Content="{Translate {x:Static i18n:LanguageManager+Keys.SyncPush}}" Command="{Binding SyncCommand}" CommandParameter="push" Margin="0,0,10,8" />
              </WrapPanel>
              <SelectableTextBlock Text="{Binding SyncDetails}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding SyncConflicts}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger}" Margin="0,5" /></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="{Translate {x:Static i18n:LanguageManager+Keys.Help}}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.HelpText}}" TextWrapping="Wrap" LineHeight="26" Margin="0,16,12,16" />
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</UserControl>
