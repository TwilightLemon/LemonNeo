<UserControl
    x:Class="LemonNeo.Desktop.Views.Search.SearchView"
    x:DataType="searchVm:SearchViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:i18n="using:LemonNeo.Desktop.Services"
    xmlns:searchVm="using:LemonNeo.Desktop.ViewModels.Search"
    xmlns:sharedControls="using:LemonNeo.Desktop.Controls.Shared"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,Auto,*">
        <sharedControls:PageHeader Summary="{Binding PageSummary}" Title="{Binding PageTitle}">
            <sharedControls:PageHeader.Actions>
                <StackPanel
                    IsVisible="{Binding IsBusy}"
                    Orientation="Horizontal"
                    Spacing="10"
                    ToolTip.Tip="{Binding Status}">
                    <ProgressBar
                        AutomationProperties.Name="{Binding Status}"
                        Height="3"
                        IsIndeterminate="True"
                        VerticalAlignment="Center"
                        Width="60" />
                    <Button
                        Classes="ghost"
                        Command="{Binding CancelOperationCommand}"
                        Content="{Translate {x:Static i18n:LanguageManager+Keys.CancelOperation}}" />
                </StackPanel>
            </sharedControls:PageHeader.Actions>
        </sharedControls:PageHeader>
        <Border
            Background="{DynamicResource Brush.DangerSoft}"
            CornerRadius="10"
            Grid.Row="1"
            IsVisible="{Binding HasError}"
            Margin="0,0,0,12"
            Padding="14">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    Foreground="{DynamicResource Brush.Danger}"
                    MaxHeight="90"
                    Text="{Binding Error}"
                    TextWrapping="Wrap" />
                <Button
                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.DismissError}}"
                    Classes="ghost icon"
                    Command="{Binding DismissErrorCommand}"
                    Grid.Column="1">
                    <Path Classes="icon" Data="{StaticResource Icon.Close}" />
                </Button>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid RowDefinitions="Auto,*">
                <WrapPanel IsEnabled="{Binding CanInteract}" Margin="0,0,0,12">
                    <Button
                        Classes="primary"
                        Command="{Binding PlaySelectedCommand}"
                        Content="{Translate {x:Static i18n:LanguageManager+Keys.Play}}"
                        IsEnabled="{Binding CanInspectTrack}"
                        Margin="0,0,8,8" />
                    <Button
                        Command="{Binding InspectTrackCommand}"
                        Content="{Translate {x:Static i18n:LanguageManager+Keys.TrackDetails}}"
                        IsEnabled="{Binding CanInspectTrack}"
                        Margin="0,0,8,8" />
                    <sharedControls:AddToPlaylistButton Margin="0,0,8,8" />
                    <Button
                        Command="{Binding ToggleSelectionCommand}"
                        Content="{Translate {x:Static i18n:LanguageManager+Keys.MultiSelect}}"
                        IsVisible="{Binding !IsSelectionMode}"
                        Margin="0,0,8,8" />
                    <StackPanel
                        IsVisible="{Binding IsSelectionMode}"
                        Margin="0,0,8,8"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center" />
                        <Button
                            Classes="ghost"
                            Command="{Binding SelectAllCommand}"
                            Content="{Translate {x:Static i18n:LanguageManager+Keys.SelectAllTracks}}" />
                        <Button
                            Classes="ghost"
                            Command="{Binding ClearSelectionCommand}"
                            Content="{Translate {x:Static i18n:LanguageManager+Keys.ClearTrackSelection}}" />
                        <Button Command="{Binding ToggleSelectionCommand}" Content="{Translate {x:Static i18n:LanguageManager+Keys.FinishSelection}}" />
                    </StackPanel>
                </WrapPanel>
                <ListBox
                    Classes="trackList"
                    Classes.managing="{Binding IsSelectionMode}"
                    DoubleTapped="OnTrackDoubleTapped"
                    Grid.IsSharedSizeScope="True"
                    Grid.Row="1"
                    IsEnabled="{Binding CanInteract}"
                    IsVisible="{Binding HasTracks}"
                    ItemTemplate="{StaticResource TrackRowTemplate}"
                    ItemsSource="{Binding Tracks}"
                    KeyDown="OnTrackKeyDown"
                    Name="TrackList"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding SelectedTrack}" />
                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding !HasTracks}"
                    MaxWidth="400"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontSize="20"
                        Text="{Translate {x:Static i18n:LanguageManager+Keys.NoResults}}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Classes="caption"
                        Text="{Translate {x:Static i18n:LanguageManager+Keys.NoResultsDescription}}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>