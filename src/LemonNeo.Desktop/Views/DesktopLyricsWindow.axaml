<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:LemonNeo.Desktop.Controls" xmlns:vm="using:LemonNeo.Desktop.ViewModels"
        xmlns:i18n="using:LemonNeo.Desktop.Infrastructure"
        x:Class="LemonNeo.Desktop.Views.DesktopLyricsWindow" x:DataType="vm:LyricsViewModel"
        Title="{Translate {x:Static i18n:LanguageManager+Keys.DesktopLyrics}}"
        Width="760" Height="300" MinWidth="320" MinHeight="110" SizeToContent="Manual"
        WindowDecorations="None" CanResize="True" CanMinimize="False" CanMaximize="False"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Background="#01000000" TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="#D9202328" WindowStartupLocation="Manual">
  <Window.Styles>
    <Style Selector="Border#HoverCard">
      <Setter Property="Background" Value="#01000000" />
    </Style>
    <Style Selector="Border#HoverCard:pointerover, Border#HoverCard.settingsOpen">
      <Setter Property="Background" Value="#D9202328" />
    </Style>
    <Style Selector="Border#Toolbar">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border#HoverCard:pointerover Border#Toolbar, Border#HoverCard.settingsOpen Border#Toolbar">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="Button.desktopControl">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Button.desktopControl Path.icon"><Setter Property="Fill" Value="White" /></Style>
    <Style Selector="Button.lineMode.active">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
    </Style>
  </Window.Styles>
  <!-- A nearly transparent input surface receives hover/drag on both native backends. -->
  <Border Name="HoverCard" Margin="6" CornerRadius="16" Padding="16,6,16,14" PointerPressed="OnDragWindow">
    <Grid RowDefinitions="40,*,Auto">
      <Border Name="Toolbar" VerticalAlignment="Center">
        <Grid ColumnDefinitions="*,Auto,*">
          <TextBlock Text="⋮⋮" Foreground="#BFFFFFFF" FontSize="20" VerticalAlignment="Center"
                     ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.DragDesktopLyrics}}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Name="DesktopPreviousButton" Classes="ghost desktopControl" Command="{Binding Playback.PreviousCommand}"
                    IsEnabled="{Binding Playback.CanPrevious}" ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Previous}}"
                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Previous}}">
              <Path Classes="icon" Data="{StaticResource Icon.Previous}" />
            </Button>
            <Button Name="DesktopPlayPauseButton" Classes="ghost desktopControl" Command="{Binding Playback.TogglePlaybackCommand}"
                    IsEnabled="{Binding Playback.CanTogglePlayback}" ToolTip.Tip="{Binding Playback.PlayLabel}"
                    AutomationProperties.Name="{Binding Playback.PlayLabel}">
              <Grid>
                <Path Classes="icon" Data="{StaticResource Icon.Play}" IsVisible="{Binding !Playback.IsPlaying}" />
                <Path Classes="icon" Data="{StaticResource Icon.Pause}" IsVisible="{Binding Playback.IsPlaying}" />
              </Grid>
            </Button>
            <Button Name="DesktopNextButton" Classes="ghost desktopControl" Command="{Binding Playback.NextCommand}"
                    IsEnabled="{Binding Playback.CanNext}" ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Next}}"
                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Next}}">
              <Path Classes="icon" Data="{StaticResource Icon.Next}" />
            </Button>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
            <Button Name="DesktopLyricsSettingsButton" Classes="ghost desktopControl"
                    ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.LyricsDisplaySettings}}"
                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.LyricsDisplaySettings}}">
              <Path Classes="icon" Data="{StaticResource Icon.Settings}" />
              <Button.Flyout>
                <Flyout Placement="TopEdgeAlignedRight" Opened="OnSettingsOpened" Closed="OnSettingsClosed">
                  <StackPanel Width="240" Spacing="16" Margin="8">
                    <TextBlock Classes="section" Text="{Translate {x:Static i18n:LanguageManager+Keys.DesktopLyrics}}" />
                    <StackPanel Spacing="8">
                      <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.DesktopLyricsLines}}" />
                      <Grid ColumnDefinitions="*,*">
                        <Button Classes="lineMode" Classes.active="{Binding IsSingleDesktopLine}" Margin="0,0,4,0"
                                Command="{Binding SingleDesktopLineCommand}" Content="{Translate {x:Static i18n:LanguageManager+Keys.SingleLyricLine}}" />
                        <Button Grid.Column="1" Classes="lineMode" Classes.active="{Binding IsTwoDesktopLines}" Margin="4,0,0,0"
                                Command="{Binding TwoDesktopLinesCommand}" Content="{Translate {x:Static i18n:LanguageManager+Keys.TwoLyricLines}}" />
                      </Grid>
                    </StackPanel>
                    <ToggleSwitch IsChecked="{Binding DesktopShowTranslation, Mode=TwoWay}" Content="{Translate {x:Static i18n:LanguageManager+Keys.ShowTranslation}}" />
                    <ToggleSwitch IsChecked="{Binding DesktopShowRomanization, Mode=TwoWay}" Content="{Translate {x:Static i18n:LanguageManager+Keys.ShowRomanization}}" />
                    <StackPanel Spacing="8">
                      <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.LyricsFontSize}}" />
                      <Slider Minimum="16" Maximum="48" TickFrequency="1" IsSnapToTickEnabled="True"
                              Value="{Binding DesktopLyricFontSize, Mode=TwoWay}"
                              AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.LyricsFontSize}}" />
                    </StackPanel>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button Name="DesktopLyricsCloseButton" Classes="ghost desktopControl" Content="×" Click="OnCloseWindow"
                    ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.CloseDesktopLyrics}}"
                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.CloseDesktopLyrics}}" />
          </StackPanel>
        </Grid>
      </Border>
      <controls:LyricsPresenter Name="DesktopLyricsTimeline" Grid.Row="1" MinHeight="40"
                                Document="{Binding Document}" EmptyText="{Binding Playback.NowTitle}"
                                PositionMilliseconds="{Binding PositionMilliseconds}" IsPlaying="{Binding Playback.IsPlaying}" IsStopped="{Binding IsStopped}"
                                DurationMilliseconds="{Binding DurationMilliseconds}"
                                VisibleLineCount="{Binding DesktopLyricLineCount}" FontSize="{Binding DesktopLyricFontSize}"
                                ShowRomanization="{Binding DesktopShowRomanization}" ShowTranslation="{Binding DesktopShowTranslation}"
                                BoldLyrics="True" TextAlignment="Center" ReduceMotion="{Binding ReduceMotion}"
                                Foreground="White" UnreachedBrush="White" ReachedBrush="#FFFFD166">
        <controls:LyricsPresenter.Effect>
          <DropShadowEffect Color="Black" BlurRadius="4" OffsetX="0" OffsetY="1" Opacity="1" />
        </controls:LyricsPresenter.Effect>
      </controls:LyricsPresenter>
      <TextBlock Name="DesktopLyricsError" Grid.Row="2" Margin="0,8,0,0" IsVisible="{Binding HasError}" Text="{Binding Error}"
                 Foreground="#FFFFB4AB" TextWrapping="Wrap" />
    </Grid>
  </Border>
</Window>
