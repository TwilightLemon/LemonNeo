<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LemonNeo.Desktop.ViewModels" xmlns:i18n="using:LemonNeo.Desktop.Infrastructure"
             xmlns:controls="using:LemonNeo.Desktop.Controls"
             x:Class="LemonNeo.Desktop.Views.LibraryView" x:DataType="vm:MainViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <TextBox Text="{Binding Filter}" PlaceholderText="{Translate {x:Static i18n:LanguageManager+Keys.SearchPlaceholder}}"
               AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.SearchPlaceholder}}" Margin="0,0,12,0" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Classes="primary" Command="{Binding PlayAllCommand}" IsEnabled="{Binding CanPlay}" Content="{Translate {x:Static i18n:LanguageManager+Keys.PlayAll}}" />
        <Button Command="{Binding ClearQueueCommand}" IsVisible="{Binding IsQueue}" IsEnabled="{Binding CanInteract}" Content="{Translate {x:Static i18n:LanguageManager+Keys.ClearQueue}}" />
      </StackPanel>
    </Grid>
    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
      <ComboBox Width="190" ItemsSource="{Binding PlaybackSources}" SelectedItem="{Binding SelectedPlaybackSource}" ItemTemplate="{StaticResource ProviderOptionTemplate}"
                IsVisible="{Binding IsLibrary}" IsEnabled="{Binding CanInteract}" Margin="0,0,8,8" AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSource}}" />
      <Button Content="{Translate {x:Static i18n:LanguageManager+Keys.TrackDetails}}" Command="{Binding InspectTrackCommand}" IsEnabled="{Binding CanInspectTrack}" Margin="0,0,8,8" />
      <Button Content="{Translate {x:Static i18n:LanguageManager+Keys.TrackActions}}" IsVisible="{Binding HasSelectedPlaylist}" IsEnabled="{Binding CanInteract}" Margin="0,0,8,8">
        <Button.Flyout>
          <MenuFlyout>
            <MenuItem Header="{Translate {x:Static i18n:LanguageManager+Keys.NewTrack}}" Command="{Binding NewTrackCommand}" IsEnabled="{Binding CanEditPlaylist}" />
            <MenuItem Header="{Translate {x:Static i18n:LanguageManager+Keys.RemoveTrack}}" Command="{Binding RemoveTrackCommand}" IsEnabled="{Binding CanEditTrack}" />
            <Separator />
            <MenuItem Header="{Translate {x:Static i18n:LanguageManager+Keys.MoveUp}}" Command="{Binding MoveTrackUpCommand}" IsEnabled="{Binding CanMoveUp}" />
            <MenuItem Header="{Translate {x:Static i18n:LanguageManager+Keys.MoveDown}}" Command="{Binding MoveTrackDownCommand}" IsEnabled="{Binding CanMoveDown}" />
            <MenuItem Header="{Translate {x:Static i18n:LanguageManager+Keys.MoveTo}}" Click="OnMoveTrack" IsEnabled="{Binding CanEditTrack}" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
      <Button Content="{Translate {x:Static i18n:LanguageManager+Keys.PlaylistActions}}" IsVisible="{Binding HasSelectedPlaylist}" IsEnabled="{Binding CanEditPlaylist}" Margin="0,0,8,8">
        <Button.Flyout>
          <MenuFlyout>
            <MenuItem Header="{Translate {x:Static i18n:LanguageManager+Keys.EditPlaylist}}" Click="OnEditPlaylist" />
            <MenuItem Header="{Translate {x:Static i18n:LanguageManager+Keys.DeletePlaylist}}" Click="OnDeletePlaylist" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </WrapPanel>
    <Expander Grid.Row="2" Header="{Translate {x:Static i18n:LanguageManager+Keys.MatchPlaylist}}" IsVisible="{Binding HasSelectedPlaylist}" Margin="0,0,0,10">
      <StackPanel Spacing="10" IsEnabled="{Binding CanInteract}">
        <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.MetadataTargets}}" Classes="caption" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Text="{Binding MetadataTargets}" PlaceholderText="{Binding MetadataNamespaces}" Margin="0,0,10,0"
                   AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.MetadataTargets}}" />
          <Button Grid.Column="1" Content="{Translate {x:Static i18n:LanguageManager+Keys.MatchPlaylist}}" Command="{Binding MatchPlaylistCommand}" />
        </Grid>
        <TextBlock Text="{Binding InspectionMessages}" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
    </Expander>
    <ListBox Name="TrackList" Grid.Row="3" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}" ItemTemplate="{StaticResource TrackRowTemplate}" Grid.IsSharedSizeScope="True"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             IsVisible="{Binding HasTracks}" IsEnabled="{Binding CanInteract}" DoubleTapped="OnTrackDoubleTapped" KeyDown="OnTrackKeyDown" />
    <controls:EmptyState Grid.Row="3" IsVisible="{Binding !HasTracks}" Title="{Binding EmptyTitle}" Description="{Binding EmptyDescription}" Icon="{StaticResource Icon.Music}" />
  </Grid>
</UserControl>
