<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:LemonNeo.Desktop.Controls" xmlns:vm="using:LemonNeo.Desktop.ViewModels" xmlns:i18n="using:LemonNeo.Desktop.Infrastructure"
             x:Class="LemonNeo.Desktop.Views.OnlineView" x:DataType="vm:OnlineViewModel">
  <UserControl.Styles>
    <Style Selector="ListBox.categoryMenu ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <controls:PageHeader Title="{Binding PageTitle}">
      <controls:PageHeader.Actions>
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsBusy}" ToolTip.Tip="{Binding Status}">
          <ProgressBar IsIndeterminate="True" Width="60" Height="3" VerticalAlignment="Center" AutomationProperties.Name="{Binding Status}" />
          <Button Classes="ghost" Command="{Binding CancelOperationCommand}" Content="{Translate {x:Static i18n:LanguageManager+Keys.CancelOperation}}" />
        </StackPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>
    <Border Grid.Row="1" IsVisible="{Binding HasError}" Background="{DynamicResource Brush.DangerSoft}" Padding="14" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" MaxHeight="90" Margin="0,0,12,0" />
        <Button Grid.Column="1" Classes="ghost compact" Content="×" Command="{Binding DismissErrorCommand}" AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.DismissError}}" />
      </Grid>
    </Border>
    <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" IsVisible="{Binding HasServices}">
      <ListBox Name="ServiceTabs" Classes="serviceTabs" ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}" ItemContainerTheme="{StaticResource ServiceTabTheme}"
               Padding="0" IsEnabled="{Binding CanInteract}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Online}}">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ProviderOption"><TextBlock Text="{Binding Name}" /></DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Grid Name="PlaylistSection" Grid.Row="3" ColumnDefinitions="Auto,*" Margin="0,20,0,0">
      <Border Name="PlaylistCategorySidebar" Width="192" Padding="0,0,16,0" Margin="0,0,20,0" BorderBrush="{DynamicResource Brush.Border}"
              BorderThickness="0,0,1,0" IsVisible="{Binding HasCategoryMenu}">
        <ListBox Name="PlaylistCategoryMenu" Classes="categoryMenu" ItemsSource="{Binding PlaylistCategories}" SelectedItem="{Binding SelectedCategory}"
                 Padding="0" IsEnabled="{Binding CanInteract}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.PlaylistCategories}}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RemotePlaylistCategory">
              <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" MinHeight="24" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <Grid Name="PlaylistContent" Grid.Column="1" RowDefinitions="*,Auto">
        <Grid ClipToBounds="True">
          <StackPanel Name="RemoteEmptyState" Spacing="8" MaxWidth="440" VerticalAlignment="Center" HorizontalAlignment="Left" IsVisible="{Binding !HasRemotePlaylists}">
            <TextBlock Text="{Binding RemoteEmptyTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding RemoteEmptyDescription}" Classes="caption" TextWrapping="Wrap" />
          </StackPanel>
          <ListBox Name="RemotePlaylistList" ItemsSource="{Binding RemotePlaylists}" SelectedItem="{Binding SelectedRemotePlaylist}" IsVisible="{Binding HasRemotePlaylists}"
                   IsEnabled="{Binding CanInteract}" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.RemotePlaylists}}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:RemotePlaylistRow">
                <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="44" ToolTip.Tip="{Binding Name}">
                  <Path Classes="icon" Data="{StaticResource Icon.Music}" VerticalAlignment="Center" Margin="0,0,18,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0" />
                  <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TrackCount}" HorizontalAlignment="Right" />
                    <TextBlock Classes="caption" Text="{Translate {x:Static i18n:LanguageManager+Keys.RemoteTracksLabel}}" HorizontalAlignment="Right" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
        <Border Name="PlaylistImportBar" Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0"
                IsVisible="{Binding HasSelectedRemotePlaylist}">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock Text="{Binding SelectedRemotePlaylist.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding SelectedPlaylistSummary}" Classes="caption" />
            </StackPanel>
            <Button Name="ImportSelectedButton" Grid.Column="1" Classes="primary" Command="{Binding ImportRemoteCommand}" IsEnabled="{Binding CanImportRemote}">
              <StackPanel Orientation="Horizontal" Spacing="8"><Path Classes="icon" Data="{StaticResource Icon.Download}" /><TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.ImportRemote}}" /></StackPanel>
            </Button>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
