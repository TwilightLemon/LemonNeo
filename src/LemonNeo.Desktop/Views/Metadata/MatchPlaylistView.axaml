<UserControl
    x:Class="LemonNeo.Desktop.Views.Metadata.MatchPlaylistView"
    x:DataType="metadataVm:MatchPlaylistPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:i18n="using:LemonNeo.Desktop.Services"
    xmlns:metadataVm="using:LemonNeo.Desktop.ViewModels.Metadata"
    xmlns:sharedControls="using:LemonNeo.Desktop.Controls.Shared"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,Auto,*">
        <sharedControls:PageHeader
            Description="{Binding PageDescription}"
            Summary="{Binding PageSummary}"
            Title="{Binding PageTitle}">
            <sharedControls:PageHeader.Actions>
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding CloseCommand}" Content="{Translate {x:Static i18n:LanguageManager+Keys.Back}}" />
                        <Button
                            Classes="primary"
                            Command="{Binding MatchPlaylistCommand}"
                            Content="{Translate {x:Static i18n:LanguageManager+Keys.MatchPlaylist}}" />
                    </StackPanel>
                    <StackPanel
                        IsVisible="{Binding IsBusy}"
                        Orientation="Horizontal"
                        Spacing="10">
                        <ProgressBar
                            AutomationProperties.Name="{Binding Status}"
                            Height="3"
                            IsIndeterminate="True"
                            VerticalAlignment="Center"
                            Width="60" />
                        <Button
                            Classes="ghost"
                            Command="{Binding CancelOperationCommand}"
                            Content="{Translate {x:Static i18n:LanguageManager+Keys.CancelOperation}}" />
                    </StackPanel>
                </StackPanel>
            </sharedControls:PageHeader.Actions>
        </sharedControls:PageHeader>
        <Border
            Background="{DynamicResource Brush.DangerSoft}"
            CornerRadius="10"
            Grid.Row="1"
            IsVisible="{Binding HasError}"
            Margin="0,0,0,12"
            Padding="14">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    Foreground="{DynamicResource Brush.Danger}"
                    MaxHeight="90"
                    Text="{Binding Error}"
                    TextWrapping="Wrap" />
                <Button
                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.DismissError}}"
                    Classes="ghost icon"
                    Command="{Binding DismissErrorCommand}"
                    Grid.Column="1">
                    <Path Classes="icon" Data="{StaticResource Icon.Close}" />
                </Button>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,16" Spacing="18">
                <StackPanel IsEnabled="{Binding CanInteract}" Spacing="10">
                    <TextBlock Classes="section" Text="{Translate {x:Static i18n:LanguageManager+Keys.MetadataTargets}}" />
                    <ItemsControl
                        IsVisible="{Binding HasMetadataSources}"
                        ItemsSource="{Binding MetadataSources}"
                        Name="MetadataSourceSelector">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="metadataVm:MetadataSourceOption">
                                <CheckBox
                                    Content="{Binding Namespace}"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                    Margin="0,0,20,8" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Classes="muted"
                        IsVisible="{Binding !HasMetadataSources}"
                        Text="{Translate {x:Static i18n:LanguageManager+Keys.NoMetadataSources}}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Classes="caption"
                        IsVisible="{Binding HasMetadataSources}"
                        Text="{Translate {x:Static i18n:LanguageManager+Keys.SelectMetadataSources}}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock
                    IsVisible="{Binding HasStatus}"
                    Text="{Binding Status}"
                    TextWrapping="Wrap" />
                <SelectableTextBlock
                    Classes="muted"
                    Text="{Binding InspectionMessages}"
                    TextWrapping="Wrap" />
                <StackPanel IsVisible="{Binding HasResults}" Spacing="10">
                    <TextBlock Classes="section" Text="{Translate {x:Static i18n:LanguageManager+Keys.MatchResults}}" />
                    <TextBlock
                        Classes="caption"
                        Text="{Translate {x:Static i18n:LanguageManager+Keys.MatchResultsHint}}"
                        TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="metadataVm:PlaylistMatchResultRow">
                                <Button
                                    Classes="ghost"
                                    Command="{Binding OpenTrackCommand}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Margin="0,0,0,10"
                                    Padding="0"
                                    ToolTip.Tip="{Binding OpenTrackHint}">
                                    <Border
                                        Classes="card"
                                        HorizontalAlignment="Stretch"
                                        Padding="18">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <TextBlock
                                                    Classes="caption"
                                                    Text="{Binding Number}"
                                                    VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Title}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Classes="muted"
                                                        Text="{Binding Artists}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Classes="caption"
                                                        Text="{Binding Identity}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    Spacing="4">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource Brush.Danger}"
                                                        HorizontalAlignment="Right"
                                                        IsVisible="{Binding !IsSuccessful}"
                                                        Text="{Binding Result}" />
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource Brush.AccentText}"
                                                        HorizontalAlignment="Right"
                                                        IsVisible="{Binding IsSuccessful}"
                                                        Text="{Binding Result}" />
                                                    <TextBlock
                                                        Classes="caption"
                                                        HorizontalAlignment="Right"
                                                        Text="{Binding Details}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Classes="caption"
                                                        HorizontalAlignment="Right"
                                                        Text="{Binding MatchSource}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                            <ItemsControl IsVisible="{Binding HasChanges}" ItemsSource="{Binding Changes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="metadataVm:PlaylistTrackChangeRow">
                                                        <Grid
                                                            ColumnDefinitions="120,*,Auto,*"
                                                            ColumnSpacing="12"
                                                            Margin="0,6,0,0">
                                                            <TextBlock
                                                                FontWeight="Medium"
                                                                Text="{Binding Field}"
                                                                TextWrapping="Wrap" />
                                                            <StackPanel Grid.Column="1" Spacing="3">
                                                                <TextBlock Classes="caption" Text="{Translate {x:Static i18n:LanguageManager+Keys.BeforeMatch}}" />
                                                                <TextBlock Text="{Binding Before}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <TextBlock
                                                                Classes="muted"
                                                                Grid.Column="2"
                                                                Text="→"
                                                                VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="3" Spacing="3">
                                                                <TextBlock Classes="caption" Text="{Translate {x:Static i18n:LanguageManager+Keys.AfterMatch}}" />
                                                                <TextBlock Text="{Binding After}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>