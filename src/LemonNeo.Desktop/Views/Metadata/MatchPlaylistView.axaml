<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sharedControls="using:LemonNeo.Desktop.Controls.Shared" xmlns:metadataVm="using:LemonNeo.Desktop.ViewModels.Metadata"
             xmlns:i18n="using:LemonNeo.Desktop.Services"
             x:Class="LemonNeo.Desktop.Views.Metadata.MatchPlaylistView" x:DataType="metadataVm:MatchPlaylistPageViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <sharedControls:PageHeader Title="{Binding PageTitle}" Description="{Binding PageDescription}" Summary="{Binding PageSummary}">
      <sharedControls:PageHeader.Actions>
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Translate {x:Static i18n:LanguageManager+Keys.Back}}" Command="{Binding CloseCommand}" />
            <Button Classes="primary" Content="{Translate {x:Static i18n:LanguageManager+Keys.MatchPlaylist}}" Command="{Binding MatchPlaylistCommand}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsBusy}">
            <ProgressBar IsIndeterminate="True" Width="60" Height="3" VerticalAlignment="Center" AutomationProperties.Name="{Binding Status}" />
            <Button Classes="ghost" Content="{Translate {x:Static i18n:LanguageManager+Keys.CancelOperation}}" Command="{Binding CancelOperationCommand}" />
          </StackPanel>
        </StackPanel>
      </sharedControls:PageHeader.Actions>
    </sharedControls:PageHeader>
    <Border Grid.Row="1" IsVisible="{Binding HasError}" Background="{DynamicResource Brush.DangerSoft}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" MaxHeight="90" />
        <Button Grid.Column="1" Classes="ghost icon" Command="{Binding DismissErrorCommand}" AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.DismissError}}">
          <Path Classes="icon" Data="{StaticResource Icon.Close}" />
        </Button>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="18" Margin="0,0,12,16">
        <StackPanel Spacing="10" IsEnabled="{Binding CanInteract}">
          <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.MetadataTargets}}" Classes="section" />
          <ItemsControl Name="MetadataSourceSelector" ItemsSource="{Binding MetadataSources}" IsVisible="{Binding HasMetadataSources}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="metadataVm:MetadataSourceOption">
                <CheckBox Content="{Binding Namespace}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,20,8" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.NoMetadataSources}}" IsVisible="{Binding !HasMetadataSources}" Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.SelectMetadataSources}}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasMetadataSources}" />
        </StackPanel>
        <TextBlock Text="{Binding Status}" IsVisible="{Binding HasStatus}" TextWrapping="Wrap" />
        <SelectableTextBlock Text="{Binding InspectionMessages}" Classes="muted" TextWrapping="Wrap" />
        <StackPanel Spacing="10" IsVisible="{Binding HasResults}">
          <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.MatchResults}}" Classes="section" />
          <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.MatchResultsHint}}" Classes="caption" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Results}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="metadataVm:PlaylistMatchResultRow">
                <Button Classes="ghost" Command="{Binding OpenTrackCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding OpenTrackHint}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="0" Margin="0,0,0,10">
                  <Border Classes="card" Padding="18" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <TextBlock Text="{Binding Number}" Classes="caption" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="4">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Artists}" Classes="muted" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Identity}" Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right">
                          <TextBlock Text="{Binding Result}" Foreground="{DynamicResource Brush.Danger}"
                                     FontWeight="SemiBold" HorizontalAlignment="Right" IsVisible="{Binding !IsSuccessful}" />
                          <TextBlock Text="{Binding Result}" Foreground="{DynamicResource Brush.AccentText}"
                                     FontWeight="SemiBold" HorizontalAlignment="Right" IsVisible="{Binding IsSuccessful}" />
                          <TextBlock Text="{Binding Details}" Classes="caption" HorizontalAlignment="Right" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding MatchSource}" Classes="caption" HorizontalAlignment="Right" TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>
                      <ItemsControl ItemsSource="{Binding Changes}" IsVisible="{Binding HasChanges}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="metadataVm:PlaylistTrackChangeRow">
                            <Grid ColumnDefinitions="120,*,Auto,*" ColumnSpacing="12" Margin="0,6,0,0">
                              <TextBlock Text="{Binding Field}" FontWeight="Medium" TextWrapping="Wrap" />
                              <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.BeforeMatch}}" Classes="caption" />
                                <TextBlock Text="{Binding Before}" TextWrapping="Wrap" />
                              </StackPanel>
                              <TextBlock Grid.Column="2" Text="→" Classes="muted" VerticalAlignment="Center" />
                              <StackPanel Grid.Column="3" Spacing="3">
                                <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.AfterMatch}}" Classes="caption" />
                                <TextBlock Text="{Binding After}" TextWrapping="Wrap" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
