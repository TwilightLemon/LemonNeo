<UserControl
    x:Class="LemonNeo.Desktop.Views.Metadata.TrackEditorView"
    x:DataType="metadataVm:TrackEditorPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:converters="using:Avalonia.Data.Converters"
    xmlns:i18n="using:LemonNeo.Desktop.Services"
    xmlns:metadataVm="using:LemonNeo.Desktop.ViewModels.Metadata"
    xmlns:sharedControls="using:LemonNeo.Desktop.Controls.Shared"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,Auto,*">
        <sharedControls:PageHeader
            Description="{Binding PageDescription}"
            Summary="{Binding PageSummary}"
            Title="{Binding PageTitle}">
            <sharedControls:PageHeader.Actions>
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding CloseEditorCommand}" Content="{Translate {x:Static i18n:LanguageManager+Keys.Back}}" />
                        <Button
                            Classes="primary"
                            Command="{Binding SaveEditorCommand}"
                            Content="{Translate {x:Static i18n:LanguageManager+Keys.Save}}"
                            IsEnabled="{Binding CanSaveEditor}" />
                    </StackPanel>
                    <StackPanel
                        IsVisible="{Binding IsBusy}"
                        Orientation="Horizontal"
                        Spacing="10"
                        ToolTip.Tip="{Binding Status}">
                        <ProgressBar
                            AutomationProperties.Name="{Binding Status}"
                            Height="3"
                            IsIndeterminate="True"
                            VerticalAlignment="Center"
                            Width="60" />
                        <Button
                            Classes="ghost"
                            Command="{Binding CancelOperationCommand}"
                            Content="{Translate {x:Static i18n:LanguageManager+Keys.CancelOperation}}" />
                    </StackPanel>
                </StackPanel>
            </sharedControls:PageHeader.Actions>
        </sharedControls:PageHeader>
        <Border
            Background="{DynamicResource Brush.DangerSoft}"
            CornerRadius="10"
            Grid.Row="1"
            IsVisible="{Binding HasError}"
            Margin="0,0,0,12"
            Padding="14">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    Foreground="{DynamicResource Brush.Danger}"
                    MaxHeight="90"
                    Text="{Binding Error}"
                    TextWrapping="Wrap" />
                <Button
                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.DismissError}}"
                    Classes="ghost icon"
                    Command="{Binding DismissErrorCommand}"
                    Grid.Column="1">
                    <Path Classes="icon" Data="{StaticResource Icon.Close}" />
                </Button>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid RowDefinitions="Auto,Auto,*">
                <WrapPanel IsVisible="{Binding EditorNeedsPlaylist}" Margin="0,0,0,12">
                    <ComboBox
                        AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.TargetPlaylist}}"
                        IsEnabled="{Binding CanInteract}"
                        IsVisible="{Binding EditorNeedsPlaylist}"
                        ItemTemplate="{StaticResource PlaylistOptionTemplate}"
                        ItemsSource="{Binding Playlists}"
                        Margin="0,0,10,8"
                        PlaceholderText="{Translate {x:Static i18n:LanguageManager+Keys.TargetPlaylist}}"
                        SelectedItem="{Binding TargetPlaylist}"
                        Width="220" />
                </WrapPanel>
                <TextBlock
                    Classes="muted"
                    Grid.Row="1"
                    Margin="0,0,0,8"
                    MaxHeight="80"
                    Text="{Binding InspectionMessages}"
                    TextWrapping="Wrap" />
                <TabControl Grid.Row="2">
                    <TabItem Header="{Translate {x:Static i18n:LanguageManager+Keys.TrackDetails}}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <StackPanel
                                IsEnabled="{Binding CanInteract}"
                                Margin="0,16,12,16"
                                Spacing="14">
                                <TextBlock Classes="caption" Text="{Translate {x:Static i18n:LanguageManager+Keys.ItemId}}" />
                                <SelectableTextBlock Text="{Binding Editor.ItemIdentity}" />
                                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                    <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.TrackTitle}}" VerticalAlignment="Center" />
                                    <TextBox
                                        AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.TrackTitle}}"
                                        Grid.Column="1"
                                        Margin="0,0,0,12"
                                        Text="{Binding Editor.Title}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Text="{Translate {x:Static i18n:LanguageManager+Keys.ArtistsLabel}}"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.ArtistsLabel}}"
                                        Grid.Column="1"
                                        Grid.Row="1"
                                        Margin="0,0,0,12"
                                        PlaceholderText="{Translate {x:Static i18n:LanguageManager+Keys.ArtistsHint}}"
                                        Text="{Binding Editor.Artists}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Text="{Translate {x:Static i18n:LanguageManager+Keys.AlbumLabel}}"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.AlbumLabel}}"
                                        Grid.Column="1"
                                        Grid.Row="2"
                                        Margin="0,0,0,12"
                                        Text="{Binding Editor.Album}" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Margin="0,0,8,0"
                                        Text="{Translate {x:Static i18n:LanguageManager+Keys.DurationSecondsLabel}}"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.DurationSecondsLabel}}"
                                        Grid.Column="1"
                                        Grid.Row="3"
                                        Margin="0,0,0,12"
                                        Text="{Binding Editor.DurationSeconds}" />
                                    <TextBlock
                                        Grid.Row="4"
                                        Text="{Translate {x:Static i18n:LanguageManager+Keys.ArtworkUriLabel}}"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.ArtworkUriLabel}}"
                                        Grid.Column="1"
                                        Grid.Row="4"
                                        Margin="0,0,0,12"
                                        Text="{Binding Editor.ArtworkUri}" />
                                    <TextBlock
                                        Grid.Row="5"
                                        Text="{Translate {x:Static i18n:LanguageManager+Keys.ProviderId}}"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.ProviderId}}"
                                        Grid.Column="1"
                                        Grid.Row="5"
                                        Margin="0,0,0,12"
                                        Text="{Binding Editor.ProviderId}" />
                                    <TextBlock
                                        Grid.Row="6"
                                        Text="{Translate {x:Static i18n:LanguageManager+Keys.TrackId}}"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.TrackId}}"
                                        Grid.Column="1"
                                        Grid.Row="6"
                                        Text="{Binding Editor.TrackId}" />
                                </Grid>
                                <TextBlock
                                    Classes="section"
                                    Margin="0,8,0,0"
                                    Text="{Translate {x:Static i18n:LanguageManager+Keys.ExternalIds}}" />
                                <ItemsControl ItemsSource="{Binding Editor.ExternalIds}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="metadataVm:ExternalIdEditor">
                                            <Grid ColumnDefinitions="130,100,*,40" Margin="0,0,0,10">
                                                <TextBox
                                                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Namespace}}"
                                                    Margin="0,0,8,0"
                                                    PlaceholderText="{Translate {x:Static i18n:LanguageManager+Keys.Namespace}}"
                                                    Text="{Binding Namespace}" />
                                                <TextBox
                                                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Kind}}"
                                                    Grid.Column="1"
                                                    Margin="0,0,8,0"
                                                    PlaceholderText="{Translate {x:Static i18n:LanguageManager+Keys.Kind}}"
                                                    Text="{Binding Kind}" />
                                                <TextBox
                                                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Value}}"
                                                    Grid.Column="2"
                                                    Margin="0,0,8,0"
                                                    PlaceholderText="{Translate {x:Static i18n:LanguageManager+Keys.Value}}"
                                                    Text="{Binding Value}" />
                                                <Button
                                                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.RemoveExternalId}}"
                                                    Classes="ghost icon"
                                                    Click="OnRemoveExternalId"
                                                    Grid.Column="3"
                                                    ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.RemoveExternalId}}">
                                                    <Path Classes="icon" Data="{StaticResource Icon.Close}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button
                                    Command="{Binding Editor.AddExternalIdCommand}"
                                    Content="{Translate {x:Static i18n:LanguageManager+Keys.AddExternalId}}"
                                    HorizontalAlignment="Left" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{Translate {x:Static i18n:LanguageManager+Keys.MetadataLabel}}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <StackPanel
                                IsEnabled="{Binding CanInteract}"
                                Margin="0,16,12,16"
                                Spacing="14">
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        Classes="caption"
                                        Text="{Translate {x:Static i18n:LanguageManager+Keys.MetadataSearchSources}}"
                                        TextWrapping="Wrap" />
                                    <ItemsControl
                                        IsVisible="{Binding HasMetadataSources}"
                                        ItemsSource="{Binding MetadataSources}"
                                        Name="MetadataSourceSelector">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="metadataVm:MetadataSourceOption">
                                                <CheckBox
                                                    Content="{Binding Namespace}"
                                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                    Margin="0,0,20,8" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock
                                        Classes="muted"
                                        IsVisible="{Binding !HasMetadataSources}"
                                        Text="{Translate {x:Static i18n:LanguageManager+Keys.NoMetadataSources}}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="caption" Text="{Translate {x:Static i18n:LanguageManager+Keys.MetadataSearchQuery}}" />
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBox
                                            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.MetadataSearchQuery}}"
                                            Name="MetadataSearchQueryBox"
                                            Text="{Binding MetadataSearchQuery, Mode=TwoWay}" />
                                        <Button
                                            Command="{Binding UseTrackSearchQueryCommand}"
                                            Content="{Translate {x:Static i18n:LanguageManager+Keys.UseTrackSearchQuery}}"
                                            Grid.Column="1"
                                            Margin="10,0,0,0" />
                                        <Button
                                            Classes="primary"
                                            Command="{Binding MetadataCommand}"
                                            Content="{Translate {x:Static i18n:LanguageManager+Keys.MetadataLookup}}"
                                            Grid.Column="2"
                                            Margin="10,0,0,0"
                                            Name="FindMetadataMatchesButton" />
                                    </Grid>
                                </StackPanel>
                                <ItemsControl
                                    ItemTemplate="{StaticResource MetadataMatchTemplate}"
                                    ItemsSource="{Binding MetadataMatches}"
                                    Name="MetadataMatchesList" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{Translate {x:Static i18n:LanguageManager+Keys.LyricsDetailsLabel}}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <StackPanel
                                IsEnabled="{Binding CanInteract}"
                                Margin="0,16,12,16"
                                Spacing="16">
                                <Button
                                    Command="{Binding LyricsDetailsCommand}"
                                    Content="{Translate {x:Static i18n:LanguageManager+Keys.LoadLyrics}}"
                                    HorizontalAlignment="Left" />
                                <SelectableTextBlock Text="{Binding LyricsDetails}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{Translate {x:Static i18n:LanguageManager+Keys.SourcesLabel}}">
                        <Grid
                            IsEnabled="{Binding CanInteract}"
                            Margin="0,16,0,0"
                            RowDefinitions="Auto,*,Auto">
                            <Button
                                Command="{Binding SourcesCommand}"
                                Content="{Translate {x:Static i18n:LanguageManager+Keys.FindSources}}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,16" />
                            <ListBox
                                Grid.Row="1"
                                ItemTemplate="{StaticResource PlaybackSourceTemplate}"
                                ItemsSource="{Binding DiscoveredSources}"
                                SelectedItem="{Binding SelectedSource}" />
                            <StackPanel
                                Grid.Row="2"
                                Margin="{DynamicResource Space.PlaybackFooterInset}"
                                Spacing="10">
                                <SelectableTextBlock
                                    MaxHeight="80"
                                    Text="{Binding SelectedSource.Location}"
                                    TextWrapping="Wrap" />
                                <Button
                                    Classes="primary"
                                    Command="{Binding PlaySourceCommand}"
                                    Content="{Translate {x:Static i18n:LanguageManager+Keys.PlaySource}}"
                                    HorizontalAlignment="Left"
                                    IsEnabled="{Binding SelectedSource, Converter={x:Static converters:ObjectConverters.IsNotNull}}"
                                    Margin="0,16,0,0" />
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>