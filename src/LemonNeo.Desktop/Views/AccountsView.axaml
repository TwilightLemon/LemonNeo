<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:LemonNeo.Desktop.Controls" xmlns:vm="using:LemonNeo.Desktop.ViewModels" xmlns:i18n="using:LemonNeo.Desktop.Infrastructure"
             x:Class="LemonNeo.Desktop.Views.AccountsView" x:DataType="vm:AccountsViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <controls:PageHeader Title="{Binding PageTitle}">
      <controls:PageHeader.Actions>
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsBusy}" ToolTip.Tip="{Binding Status}">
          <ProgressBar IsIndeterminate="True" Width="60" Height="3" VerticalAlignment="Center" AutomationProperties.Name="{Binding Status}" />
          <Button Classes="ghost" Command="{Binding CancelOperationCommand}" Content="{Translate {x:Static i18n:LanguageManager+Keys.CancelOperation}}" />
        </StackPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>
    <Border Grid.Row="1" IsVisible="{Binding HasError}" Background="{DynamicResource Brush.DangerSoft}" Padding="14" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" MaxHeight="90" Margin="0,0,12,0" />
        <Button Grid.Column="1" Classes="ghost compact" Content="×" Command="{Binding DismissErrorCommand}" AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.DismissError}}" />
      </Grid>
    </Border>
    <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" IsVisible="{Binding HasServices}">
      <ListBox Name="AccountServiceTabs" Classes="serviceTabs" ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}" ItemContainerTheme="{StaticResource ServiceTabTheme}"
               Padding="0" IsEnabled="{Binding CanInteract}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.AuthenticationProvider}}">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ProviderOption"><TextBlock Text="{Binding Name}" /></DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <Grid Grid.Row="3" Margin="0,24,0,0">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasServices}">
        <StackPanel Spacing="20" IsEnabled="{Binding CanInteract}">
          <Grid Name="SignedInAccount" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsAuthenticated}">
            <Border Name="AccountAvatar" Width="56" Height="56" CornerRadius="28" ClipToBounds="True" Background="{DynamicResource Brush.SurfaceRaised}"
                    Margin="0,0,16,0" VerticalAlignment="Center">
              <Grid>
                <Path Name="AccountAvatarPlaceholder" Width="28" Height="28" Stretch="Uniform" Data="{StaticResource Icon.Account}"
                      Fill="{DynamicResource Brush.TextSecondary}" IsVisible="{Binding !HasAccountAvatar}" />
                <Image Name="AccountAvatarImage" Source="{Binding AccountAvatar}" Stretch="UniformToFill" />
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock Text="{Binding AccountName}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding AccountName}" />
              <TextBlock Text="{Binding AccountId}" Classes="caption" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{Binding AuthenticationStatus}" Classes="caption" Foreground="{DynamicResource Brush.AccentText}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Button Name="CookieLoginToggle" Classes="ghost" Command="{Binding ToggleCookieEditorCommand}" Content="{Translate {x:Static i18n:LanguageManager+Keys.UpdateSignIn}}" Padding="10,6" MinHeight="32" />
              <Button Name="SignOutButton" Classes="ghost" Command="{Binding LogoutCommand}" IsEnabled="{Binding CanLogout}"
                      Content="{Translate {x:Static i18n:LanguageManager+Keys.Logout}}" Padding="10,6" MinHeight="32" />
            </StackPanel>
          </Grid>
          <StackPanel Name="CookieLoginForm" Spacing="12" MaxWidth="560" HorizontalAlignment="Left" IsVisible="{Binding IsCookieEditorOpen}">
            <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.CookieLogin}}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.CookieHint}}" Classes="caption" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Name="CookieInput" Text="{Binding Cookie}" MinWidth="280" Margin="0,0,10,0"
                       PlaceholderText="{Translate {x:Static i18n:LanguageManager+Keys.Cookie}}" AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Cookie}}" />
              <Button Name="SignInButton" Grid.Column="1" Classes="primary" Command="{Binding LoginCommand}" IsEnabled="{Binding CanLogin}" Content="{Translate {x:Static i18n:LanguageManager+Keys.Login}}" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <StackPanel Spacing="8" MaxWidth="440" HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding !HasServices}">
        <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.NoAccountServices}}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.NoAccountServicesDescription}}" Classes="caption" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
