<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="using:LemonNeo.Desktop.Infrastructure" x:Class="LemonNeo.Desktop.Views.ConfirmationDialog"
        Title="{Translate {x:Static i18n:LanguageManager+Keys.DeletePlaylist}}" Width="440" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="28" Spacing="24">
    <TextBlock Name="Message" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
      <Button Content="{Translate {x:Static i18n:LanguageManager+Keys.Cancel}}" Click="OnCancel" IsCancel="True" />
      <Button Classes="danger" Content="{Translate {x:Static i18n:LanguageManager+Keys.DeletePlaylist}}" Click="OnConfirm" />
    </StackPanel>
  </StackPanel>
</Window>
