<UserControl
    x:Class="LemonNeo.Desktop.Views.Playback.QueueDrawerView"
    x:DataType="playbackVm:PlaybackQueueViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:i18n="using:LemonNeo.Desktop.Services"
    xmlns:playbackVm="using:LemonNeo.Desktop.ViewModels.Playback"
    xmlns:sharedControls="using:LemonNeo.Desktop.Controls.Shared"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,Auto,*">
        <StackPanel Margin="0,0,40,0" Spacing="6">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Text="{Binding PageTitle}" />
            <TextBlock Classes="caption" Text="{Binding TrackCount}" />
        </StackPanel>
        <TextBox
            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.SearchPlaceholder}}"
            Grid.Row="1"
            Margin="0,16,0,12"
            Name="QueueFilter"
            PlaceholderText="{Translate {x:Static i18n:LanguageManager+Keys.SearchPlaceholder}}"
            Text="{Binding Filter}" />
        <ListBox
            Classes="queueList"
            Grid.Row="2"
            IsVisible="{Binding HasTracks}"
            ItemsSource="{Binding Tracks}"
            KeyDown="OnTrackKeyDown"
            Name="QueueTracks"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectedItem="{Binding SelectedTrack}"
            Tapped="OnTrackTapped">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,2" />
                </Style>
                <Style Selector="Border.queueTrack">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="playbackVm:QueueTrackViewModel">
                    <Border
                        Classes="queueTrack"
                        Classes.current="{Binding IsCurrent}"
                        CornerRadius="10"
                        MinHeight="64"
                        Padding="8,12"
                        ToolTip.Tip="{Binding Row.Title}">
                        <Grid ColumnDefinitions="4,56,*,Auto">
                            <Border
                                Background="{DynamicResource Brush.AccentText}"
                                CornerRadius="2"
                                Height="24"
                                IsVisible="{Binding IsCurrent}"
                                VerticalAlignment="Center"
                                Width="3" />
                            <sharedControls:Artwork
                                CornerRadius="8"
                                Grid.Column="1"
                                Height="40"
                                Loader="{Binding Row.ArtworkLoader}"
                                Name="QueueTrackArtwork"
                                SourceUri="{Binding Row.ArtworkUri}"
                                VerticalAlignment="Center"
                                Width="40" />
                            <StackPanel
                                Grid.Column="2"
                                Margin="8,0,8,0"
                                Spacing="5">
                                <TextBlock
                                    FontWeight="Medium"
                                    Text="{Binding Row.Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Classes="caption"
                                    Text="{Binding Description}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                                Classes="caption"
                                Grid.Column="3"
                                Text="{Binding Row.Duration}"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border
            Classes="floatingAction"
            Grid.Row="2"
            HorizontalAlignment="Right"
            IsVisible="{Binding HasPlayingTrack}"
            Margin="0,0,12,12"
            VerticalAlignment="Bottom">
            <Button
                AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.LocatePlayingTrack}}"
                Classes="primary floating"
                Click="OnLocatePlaying"
                Name="LocatePlayingButton"
                ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.LocatePlayingTrack}}">
                <Path
                    Classes="icon"
                    Data="{StaticResource Icon.Locate}"
                    Height="22"
                    Width="22" />
            </Button>
        </Border>
        <StackPanel
            Grid.Row="2"
            IsVisible="{Binding !HasTracks}"
            Margin="12"
            Spacing="8"
            VerticalAlignment="Center">
            <TextBlock
                FontSize="20"
                Text="{Binding EmptyTitle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                Classes="caption"
                Text="{Binding EmptyDescription}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>