<Window
    CanResize="False"
    SizeToContent="Height"
    Title="{Translate {x:Static i18n:LanguageManager+Keys.MoveTo}}"
    Width="380"
    WindowStartupLocation="CenterOwner"
    x:Class="LemonNeo.Desktop.Views.Library.MoveTrackDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:i18n="using:LemonNeo.Desktop.Services"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="28" Spacing="20">
        <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.DestinationPosition}}" TextWrapping="Wrap" />
        <NumericUpDown
            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.DestinationPosition}}"
            FormatString="0"
            Increment="1"
            Minimum="1"
            Name="DestinationInput" />
        <StackPanel
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="10">
            <Button
                Click="OnCancel"
                Content="{Translate {x:Static i18n:LanguageManager+Keys.Cancel}}"
                IsCancel="True" />
            <Button
                Classes="primary"
                Click="OnMove"
                Content="{Translate {x:Static i18n:LanguageManager+Keys.Move}}"
                IsDefault="True"
                Name="MoveButton" />
        </StackPanel>
    </StackPanel>
</Window>