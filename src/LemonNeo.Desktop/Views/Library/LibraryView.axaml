<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:libraryVm="using:LemonNeo.Desktop.ViewModels.Library" xmlns:i18n="using:LemonNeo.Desktop.Services"
             xmlns:sharedControls="using:LemonNeo.Desktop.Controls.Shared"
             x:Class="LemonNeo.Desktop.Views.Library.LibraryView" x:DataType="libraryVm:LibraryViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <sharedControls:PageHeader Title="{Binding PageTitle}" Description="{Binding PageDescription}" Summary="{Binding PageSummary}">
      <sharedControls:PageHeader.Actions>
        <StackPanel Spacing="8">
          <Button Classes="primary" Command="{Binding PlayAllCommand}" IsEnabled="{Binding CanPlay}" Content="{Translate {x:Static i18n:LanguageManager+Keys.PlayAll}}" />
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsBusy}" ToolTip.Tip="{Binding Status}">
            <ProgressBar IsIndeterminate="True" Width="60" Height="3" VerticalAlignment="Center" AutomationProperties.Name="{Binding Status}" />
            <Button Classes="ghost" Command="{Binding CancelOperationCommand}" Content="{Translate {x:Static i18n:LanguageManager+Keys.CancelOperation}}" />
          </StackPanel>
        </StackPanel>
      </sharedControls:PageHeader.Actions>
    </sharedControls:PageHeader>
    <Border Grid.Row="1" IsVisible="{Binding HasError}" Background="{DynamicResource Brush.DangerSoft}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" MaxHeight="90" />
        <Button Grid.Column="1" Classes="ghost" Content="×" Command="{Binding DismissErrorCommand}" AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.DismissError}}" />
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <Grid RowDefinitions="Auto,*">
        <Grid Name="LibraryToolbar" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
          <TextBox Name="LibraryFilter" Text="{Binding Filter}" PlaceholderText="{Translate {x:Static i18n:LanguageManager+Keys.SearchPlaceholder}}"
                   AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.SearchPlaceholder}}" Margin="0,0,12,0" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Command="{Binding ClearQueueCommand}" IsVisible="{Binding IsQueue}" IsEnabled="{Binding CanInteract}" Content="{Translate {x:Static i18n:LanguageManager+Keys.ClearQueue}}" />
            <Button Name="TrackDetailsButton" Content="{Translate {x:Static i18n:LanguageManager+Keys.TrackDetails}}" Command="{Binding InspectTrackCommand}" IsEnabled="{Binding CanInspectTrack}" />
            <Button Name="TrackActionsButton" Content="{Translate {x:Static i18n:LanguageManager+Keys.TrackActions}}" IsVisible="{Binding HasSelectedPlaylist}" IsEnabled="{Binding CanInteract}">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="{Translate {x:Static i18n:LanguageManager+Keys.NewTrack}}" Command="{Binding NewTrackCommand}" IsEnabled="{Binding CanEditPlaylist}" />
                  <MenuItem Header="{Translate {x:Static i18n:LanguageManager+Keys.RemoveTrack}}" Command="{Binding RemoveTrackCommand}" IsEnabled="{Binding CanEditTrack}" />
                  <Separator />
                  <MenuItem Header="{Translate {x:Static i18n:LanguageManager+Keys.MoveUp}}" Command="{Binding MoveTrackUpCommand}" IsEnabled="{Binding CanMoveUp}" />
                  <MenuItem Header="{Translate {x:Static i18n:LanguageManager+Keys.MoveDown}}" Command="{Binding MoveTrackDownCommand}" IsEnabled="{Binding CanMoveDown}" />
                  <MenuItem Header="{Translate {x:Static i18n:LanguageManager+Keys.MoveTo}}" Click="OnMoveTrack" IsEnabled="{Binding CanEditTrack}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button Name="PlaylistActionsButton" Content="{Translate {x:Static i18n:LanguageManager+Keys.PlaylistActions}}" IsVisible="{Binding HasSelectedPlaylist}" IsEnabled="{Binding CanEditPlaylist}">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="{Translate {x:Static i18n:LanguageManager+Keys.MatchPlaylist}}" Command="{Binding MatchPlaylistCommand}" />
                  <MenuItem Header="{Translate {x:Static i18n:LanguageManager+Keys.EditPlaylist}}" Click="OnEditPlaylist" />
                  <MenuItem Header="{Translate {x:Static i18n:LanguageManager+Keys.DeletePlaylist}}" Click="OnDeletePlaylist" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>
        <ListBox Name="TrackList" Grid.Row="1" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}" ItemTemplate="{StaticResource TrackRowTemplate}" Grid.IsSharedSizeScope="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 IsVisible="{Binding HasTracks}" IsEnabled="{Binding CanInteract}" DoubleTapped="OnTrackDoubleTapped" KeyDown="OnTrackKeyDown" />
        <sharedControls:EmptyState Grid.Row="1" IsVisible="{Binding !HasTracks}" Title="{Binding EmptyTitle}" Description="{Binding EmptyDescription}" Icon="{StaticResource Icon.Music}" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
