<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:libraryVm="using:LemonNeo.Desktop.ViewModels.Library" xmlns:i18n="using:LemonNeo.Desktop.Services"
             xmlns:sharedControls="using:LemonNeo.Desktop.Controls.Shared"
             x:Class="LemonNeo.Desktop.Views.Library.LibraryView" x:DataType="libraryVm:LibraryViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <sharedControls:PageHeader Title="{Binding PageTitle}" Description="{Binding PageDescription}" Summary="{Binding PageSummary}">
      <sharedControls:PageHeader.Actions>
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Command="{Binding PlayAllCommand}" IsEnabled="{Binding CanPlay}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Classes="icon" Data="{StaticResource Icon.Play}" Width="14" Height="14" />
                <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.PlayAll}}" />
              </StackPanel>
            </Button>
            <Button Name="PlaylistActionsButton" Classes="ghost icon" IsVisible="{Binding HasSelectedPlaylist}" IsEnabled="{Binding CanEditPlaylist}"
                    ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.PlaylistMore}}" AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.PlaylistMore}}">
              <Path Classes="icon" Data="{StaticResource Icon.More}" VerticalAlignment="Center" />
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="{Translate {x:Static i18n:LanguageManager+Keys.NewTrack}}" Command="{Binding NewTrackCommand}" />
                  <MenuItem Header="{Translate {x:Static i18n:LanguageManager+Keys.MatchPlaylist}}" Command="{Binding MatchPlaylistCommand}" />
                  <MenuItem Header="{Translate {x:Static i18n:LanguageManager+Keys.EditPlaylist}}" Click="OnEditPlaylist" />
                  <Separator />
                  <MenuItem Header="{Translate {x:Static i18n:LanguageManager+Keys.DeletePlaylist}}" Click="OnDeletePlaylist" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsBusy}" ToolTip.Tip="{Binding Status}">
            <ProgressBar IsIndeterminate="True" Width="60" Height="3" VerticalAlignment="Center" AutomationProperties.Name="{Binding Status}" />
            <Button Classes="ghost" Command="{Binding CancelOperationCommand}" Content="{Translate {x:Static i18n:LanguageManager+Keys.CancelOperation}}" />
          </StackPanel>
        </StackPanel>
      </sharedControls:PageHeader.Actions>
    </sharedControls:PageHeader>
    <Border Grid.Row="1" IsVisible="{Binding HasError}" Background="{DynamicResource Brush.DangerSoft}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" MaxHeight="90" />
        <Button Grid.Column="1" Classes="ghost" Content="×" Command="{Binding DismissErrorCommand}" AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.DismissError}}" />
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <Grid RowDefinitions="Auto,*">
        <StackPanel Name="LibraryToolbar" Spacing="12" Margin="0,0,0,14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBox Name="LibraryFilter" Text="{Binding Filter}" PlaceholderText="{Translate {x:Static i18n:LanguageManager+Keys.SearchPlaceholder}}"
                     AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.SearchPlaceholder}}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsSelectionMode}">
                <sharedControls:AddToPlaylistButton />
                <Button Name="TrackDetailsButton" Content="{Translate {x:Static i18n:LanguageManager+Keys.TrackDetails}}" Command="{Binding InspectTrackCommand}"
                        IsEnabled="{Binding CanInspectTrack}" />
              </StackPanel>
              <Button Name="ManageTracksButton" Content="{Binding SelectionModeLabel}" Command="{Binding ToggleSelectionCommand}"
                      IsEnabled="{Binding CanInteract}" />
            </StackPanel>
          </Grid>
          <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="10" Padding="10,6" IsVisible="{Binding IsSelectionMode}">
            <WrapPanel>
              <TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center" Margin="4,0,14,0" />
              <Button Classes="ghost compact" Command="{Binding SelectAllCommand}" Content="{Translate {x:Static i18n:LanguageManager+Keys.SelectAllTracks}}" Margin="0,2,8,2" />
              <Button Classes="ghost compact" Command="{Binding ClearSelectionCommand}" Content="{Translate {x:Static i18n:LanguageManager+Keys.ClearTrackSelection}}" Margin="0,2,8,2" />
              <sharedControls:AddToPlaylistButton IsGhost="True" IsCompact="True" Margin="0,2,8,2" />
              <Button Classes="danger compact" Command="{Binding RemoveTrackCommand}" IsEnabled="{Binding CanRemoveTracks}" IsVisible="{Binding HasSelectedPlaylist}"
                      Content="{Translate {x:Static i18n:LanguageManager+Keys.RemoveSelectedTracks}}" Margin="0,2,8,2" />
              <TextBlock Classes="caption" Text="{Translate {x:Static i18n:LanguageManager+Keys.DragTracksToReorder}}" IsVisible="{Binding CanReorderTracks}" VerticalAlignment="Center" Margin="6,0,0,0" />
            </WrapPanel>
          </Border>
        </StackPanel>
        <ListBox Name="TrackList" Classes="trackList" Classes.managing="{Binding IsSelectionMode}" Grid.Row="1" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}" ItemTemplate="{StaticResource TrackRowTemplate}" Grid.IsSharedSizeScope="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 IsVisible="{Binding HasTracks}" IsEnabled="{Binding CanInteract}" DoubleTapped="OnTrackDoubleTapped" KeyDown="OnTrackKeyDown" />
        <Border Grid.Row="1" Classes="floatingAction" IsVisible="{Binding HasPlayingTrack}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="{DynamicResource Space.PlaybackFloatingInset}">
          <Button Name="LocatePlayingButton" Classes="primary floating" Click="OnLocatePlaying"
                  ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.LocatePlayingTrack}}" AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.LocatePlayingTrack}}">
            <Path Classes="icon" Data="{StaticResource Icon.Locate}" Width="22" Height="22" />
          </Button>
        </Border>
        <sharedControls:EmptyState Grid.Row="1" IsVisible="{Binding !HasTracks}" Title="{Binding EmptyTitle}" Description="{Binding EmptyDescription}" Icon="{StaticResource Icon.Music}" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
