<Window
    Classes="acrylicDialog"
    CanResize="False"
    SizeToContent="Height"
    Title="{Translate {x:Static i18n:LanguageManager+Keys.CreatePlaylist}}"
    Width="430"
    WindowStartupLocation="CenterOwner"
    x:Class="LemonNeo.Desktop.Views.Library.PlaylistDialog"
    x:DataType="libraryVm:PlaylistDialogViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:converters="using:Avalonia.Data.Converters"
    xmlns:i18n="using:LemonNeo.Desktop.Services"
    xmlns:libraryVm="using:LemonNeo.Desktop.ViewModels.Library"
    xmlns:sharedControls="using:LemonNeo.Desktop.Controls.Shared"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="28" Spacing="20">
        <TextBlock
            Classes="section"
            Name="DialogHeading"
            Text="{Translate {x:Static i18n:LanguageManager+Keys.CreatePlaylist}}" />
        <StackPanel IsVisible="{Binding IsNew}" Spacing="8">
            <Button
                Click="OnImportFolder"
                Content="{Translate {x:Static i18n:LanguageManager+Keys.ImportFromFolder}}"
                HorizontalAlignment="Left"
                Name="ImportFolderButton" />
            <TextBlock
                Classes="caption"
                IsVisible="{Binding HasFolder}"
                Text="{Binding FolderPath}"
                TextWrapping="Wrap" />
            <CheckBox
                IsVisible="{Binding HasFolder}"
                IsChecked="{Binding Synchronize}"
                Content="{Translate {x:Static i18n:LanguageManager+Keys.ImportWithAutoSync}}"
                ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.PlaylistSyncReadOnlyHint}}" />
        </StackPanel>
        <TextBox
            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.PlaylistName}}"
            IsReadOnly="{Binding !CanEditDetails}"
            Name="PlaylistName"
            PlaceholderText="{Translate {x:Static i18n:LanguageManager+Keys.PlaylistName}}"
            Text="{Binding Name}" />
        <TextBox
            AcceptsReturn="True"
            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.PlaylistDescriptionLabel}}"
            IsReadOnly="{Binding !CanEditDetails}"
            MaxHeight="150"
            MinHeight="70"
            Name="PlaylistDescription"
            PlaceholderText="{Translate {x:Static i18n:LanguageManager+Keys.PlaylistDescriptionLabel}}"
            Text="{Binding Description}"
            TextWrapping="Wrap" />
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" IsVisible="{Binding !IsNew}">
            <sharedControls:Artwork
                CornerRadius="8"
                Height="72"
                Loader="{Binding ArtworkLoader}"
                SourceUri="{Binding ArtworkUri}"
                VerticalAlignment="Top"
                Width="72" />
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                <TextBlock
                    Classes="caption"
                    Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaylistCover}}" />
                <WrapPanel>
                    <Button
                        Click="OnChooseArtwork"
                        Content="{Translate {x:Static i18n:LanguageManager+Keys.ChoosePlaylistCover}}"
                        Margin="0,0,6,0"
                        Name="ChooseArtworkButton" />
                    <Button
                        Classes="ghost"
                        Click="OnRemoveArtwork"
                        Content="{Translate {x:Static i18n:LanguageManager+Keys.RemovePlaylistCover}}"
                        IsEnabled="{Binding HasArtwork}" />
                </WrapPanel>
                <TextBlock
                    Foreground="{DynamicResource Brush.Danger}"
                    IsVisible="{Binding ArtworkError, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"
                    Text="{Binding ArtworkError}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <StackPanel
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="10">
            <Button
                Click="OnCancel"
                Content="{Translate {x:Static i18n:LanguageManager+Keys.Cancel}}"
                IsCancel="True" />
            <Button
                Classes="primary"
                Click="OnCreate"
                Content="{Translate {x:Static i18n:LanguageManager+Keys.Create}}"
                IsDefault="True"
                IsEnabled="{Binding CanSave}"
                Name="CreateButton" />
        </StackPanel>
    </StackPanel>
</Window>
