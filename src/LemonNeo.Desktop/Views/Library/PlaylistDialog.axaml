<Window
    CanResize="False"
    SizeToContent="Height"
    Title="{Translate {x:Static i18n:LanguageManager+Keys.CreatePlaylist}}"
    Width="430"
    WindowStartupLocation="CenterOwner"
    x:Class="LemonNeo.Desktop.Views.Library.PlaylistDialog"
    x:DataType="libraryVm:PlaylistDialogViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:i18n="using:LemonNeo.Desktop.Services"
    xmlns:libraryVm="using:LemonNeo.Desktop.ViewModels.Library"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="28" Spacing="20">
        <TextBlock
            Classes="section"
            Name="DialogHeading"
            Text="{Translate {x:Static i18n:LanguageManager+Keys.CreatePlaylist}}" />
        <StackPanel IsVisible="{Binding IsNew}" Spacing="8">
            <Button
                Click="OnImportFolder"
                Content="{Translate {x:Static i18n:LanguageManager+Keys.ImportFromFolder}}"
                HorizontalAlignment="Left"
                Name="ImportFolderButton" />
            <TextBlock
                Classes="caption"
                IsVisible="{Binding HasFolder}"
                Text="{Binding FolderPath}"
                TextWrapping="Wrap" />
        </StackPanel>
        <TextBox
            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.PlaylistName}}"
            Name="PlaylistName"
            PlaceholderText="{Translate {x:Static i18n:LanguageManager+Keys.PlaylistName}}"
            Text="{Binding Name}" />
        <TextBox
            AcceptsReturn="True"
            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.PlaylistDescriptionLabel}}"
            MaxHeight="150"
            MinHeight="70"
            Name="PlaylistDescription"
            PlaceholderText="{Translate {x:Static i18n:LanguageManager+Keys.PlaylistDescriptionLabel}}"
            Text="{Binding Description}"
            TextWrapping="Wrap" />
        <StackPanel
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="10">
            <Button
                Click="OnCancel"
                Content="{Translate {x:Static i18n:LanguageManager+Keys.Cancel}}"
                IsCancel="True" />
            <Button
                Classes="primary"
                Click="OnCreate"
                Content="{Translate {x:Static i18n:LanguageManager+Keys.Create}}"
                IsDefault="True"
                IsEnabled="{Binding CanSave}"
                Name="CreateButton" />
        </StackPanel>
    </StackPanel>
</Window>