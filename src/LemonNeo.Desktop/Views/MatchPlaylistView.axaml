<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:LemonNeo.Desktop.Controls" xmlns:vm="using:LemonNeo.Desktop.ViewModels"
             xmlns:i18n="using:LemonNeo.Desktop.Infrastructure"
             x:Class="LemonNeo.Desktop.Views.MatchPlaylistView" x:DataType="vm:MatchPlaylistPageViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <controls:PageHeader Title="{Binding PageTitle}" Description="{Binding PageDescription}" Summary="{Binding PageSummary}">
      <controls:PageHeader.Actions>
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Translate {x:Static i18n:LanguageManager+Keys.Back}}" Command="{Binding CloseCommand}" />
            <Button Classes="primary" Content="{Translate {x:Static i18n:LanguageManager+Keys.MatchPlaylist}}" Command="{Binding MatchPlaylistCommand}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsBusy}">
            <ProgressBar IsIndeterminate="True" Width="60" Height="3" VerticalAlignment="Center" AutomationProperties.Name="{Binding Status}" />
            <Button Classes="ghost" Content="{Translate {x:Static i18n:LanguageManager+Keys.CancelOperation}}" Command="{Binding CancelOperationCommand}" />
          </StackPanel>
        </StackPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>
    <Border Grid.Row="1" IsVisible="{Binding HasError}" Background="{DynamicResource Brush.DangerSoft}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" MaxHeight="90" />
        <Button Grid.Column="1" Classes="ghost" Content="×" Command="{Binding DismissErrorCommand}" AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.DismissError}}" />
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="18" Margin="0,0,12,16">
        <StackPanel Spacing="10" IsEnabled="{Binding CanInteract}">
          <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.MetadataTargets}}" Classes="section" />
          <ItemsControl Name="MetadataSourceSelector" ItemsSource="{Binding MetadataSources}" IsVisible="{Binding HasMetadataSources}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MetadataSourceOption">
                <CheckBox Content="{Binding Namespace}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,20,8" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.NoMetadataSources}}" IsVisible="{Binding !HasMetadataSources}" Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.SelectMetadataSources}}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasMetadataSources}" />
        </StackPanel>
        <TextBlock Text="{Binding Status}" IsVisible="{Binding HasStatus}" TextWrapping="Wrap" />
        <SelectableTextBlock Text="{Binding InspectionMessages}" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
