<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LemonNeo.Desktop.Views.Shared.MessageDialog"
        Width="460" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="28" Spacing="24">
    <TextBlock Name="Message" TextWrapping="Wrap" />
    <Button Name="AcceptButton" Classes="primary" HorizontalAlignment="Right" MinWidth="88"
            Click="OnAccept" IsDefault="True" IsCancel="True" />
  </StackPanel>
</Window>
