<Window
    CanResize="False"
    SizeToContent="Height"
    Width="460"
    WindowStartupLocation="CenterOwner"
    x:Class="LemonNeo.Desktop.Views.Shared.MessageDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="28" Spacing="24">
        <TextBlock Name="Message" TextWrapping="Wrap" />
        <Button
            Classes="primary"
            Click="OnAccept"
            HorizontalAlignment="Right"
            IsCancel="True"
            IsDefault="True"
            MinWidth="88"
            Name="AcceptButton" />
    </StackPanel>
</Window>