<UserControl
    x:Class="LemonNeo.Desktop.Views.Online.OnlineView"
    x:DataType="onlineVm:OnlineViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:i18n="using:LemonNeo.Desktop.Services"
    xmlns:onlineVm="using:LemonNeo.Desktop.ViewModels.Online"
    xmlns:sharedControls="using:LemonNeo.Desktop.Controls.Shared"
    xmlns:sharedVm="using:LemonNeo.Desktop.ViewModels.Shared"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="ListBox.categoryMenu ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <sharedControls:PageHeader Title="{Binding PageTitle}">
            <sharedControls:PageHeader.Actions>
                <StackPanel
                    IsVisible="{Binding IsBusy}"
                    Orientation="Horizontal"
                    Spacing="10"
                    ToolTip.Tip="{Binding Status}">
                    <ProgressBar
                        AutomationProperties.Name="{Binding Status}"
                        Height="3"
                        IsIndeterminate="True"
                        VerticalAlignment="Center"
                        Width="60" />
                    <Button
                        Classes="ghost"
                        Command="{Binding CancelOperationCommand}"
                        Content="{Translate {x:Static i18n:LanguageManager+Keys.CancelOperation}}" />
                </StackPanel>
            </sharedControls:PageHeader.Actions>
        </sharedControls:PageHeader>
        <Border
            Background="{DynamicResource Brush.DangerSoft}"
            Grid.Row="1"
            IsVisible="{Binding HasError}"
            Margin="0,0,0,12"
            Padding="14">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    Foreground="{DynamicResource Brush.Danger}"
                    Margin="0,0,12,0"
                    MaxHeight="90"
                    Text="{Binding Error}"
                    TextWrapping="Wrap" />
                <Button
                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.DismissError}}"
                    Classes="ghost compact"
                    Command="{Binding DismissErrorCommand}"
                    Grid.Column="1">
                    <Path
                        Classes="icon"
                        Data="{StaticResource Icon.Close}"
                        Height="14"
                        Width="14" />
                </Button>
            </Grid>
        </Border>
        <Border
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1"
            Grid.Row="2"
            IsVisible="{Binding HasServices}">
            <ListBox
                AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Online}}"
                Classes="serviceTabs"
                IsEnabled="{Binding CanInteract}"
                ItemContainerTheme="{StaticResource ServiceTabTheme}"
                ItemsSource="{Binding Services}"
                Name="ServiceTabs"
                Padding="0"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectedItem="{Binding SelectedService}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="sharedVm:ProviderOption">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid
            ColumnDefinitions="Auto,*"
            Grid.Row="3"
            Margin="0,20,0,0"
            Name="PlaylistSection">
            <Border
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,1,0"
                IsVisible="{Binding HasCategoryMenu}"
                Margin="0,0,20,0"
                Name="PlaylistCategorySidebar"
                Padding="0,0,16,0"
                Width="192">
                <ListBox
                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.PlaylistCategories}}"
                    Classes="categoryMenu"
                    IsEnabled="{Binding CanInteract}"
                    ItemsSource="{Binding PlaylistCategories}"
                    Name="PlaylistCategoryMenu"
                    Padding="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding SelectedCategory}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="onlineVm:RemotePlaylistCategory">
                            <TextBlock
                                MinHeight="24"
                                Text="{Binding Name}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Grid
                Grid.Column="1"
                Name="PlaylistContent"
                RowDefinitions="*,Auto">
                <Grid ClipToBounds="True">
                    <StackPanel
                        HorizontalAlignment="Left"
                        IsVisible="{Binding !HasRemotePlaylists}"
                        MaxWidth="440"
                        Name="RemoteEmptyState"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="{Binding RemoteEmptyTitle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Classes="caption"
                            Text="{Binding RemoteEmptyDescription}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ListBox
                        AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.RemotePlaylists}}"
                        IsEnabled="{Binding CanInteract}"
                        IsVisible="{Binding HasRemotePlaylists}"
                        ItemsSource="{Binding RemotePlaylists}"
                        Name="RemotePlaylistList"
                        Padding="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem="{Binding SelectedRemotePlaylist}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="onlineVm:RemotePlaylistRow">
                                <Grid
                                    ColumnDefinitions="Auto,*,Auto"
                                    MinHeight="44"
                                    ToolTip.Tip="{Binding Name}">
                                    <Path
                                        Classes="icon"
                                        Data="{StaticResource Icon.Music}"
                                        Margin="0,0,18,0"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Grid.Column="1"
                                        Margin="0,0,16,0"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <StackPanel
                                        Grid.Column="2"
                                        Spacing="3"
                                        VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding TrackCount}" />
                                        <TextBlock
                                            Classes="caption"
                                            HorizontalAlignment="Right"
                                            Text="{Translate {x:Static i18n:LanguageManager+Keys.RemoteTracksLabel}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                <Border
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,1,0,0"
                    Grid.Row="1"
                    IsVisible="{Binding HasSelectedRemotePlaylist}"
                    Margin="{DynamicResource Space.PlaybackFooterInset}"
                    Name="PlaylistImportBar"
                    Padding="0,12,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel
                            Margin="0,0,12,0"
                            Spacing="4"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{Binding SelectedRemotePlaylist.Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="caption" Text="{Binding SelectedPlaylistSummary}" />
                        </StackPanel>
                        <Button
                            Classes="primary"
                            Command="{Binding ImportRemoteCommand}"
                            Grid.Column="1"
                            IsEnabled="{Binding CanImportRemote}"
                            Name="ImportSelectedButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Classes="icon" Data="{StaticResource Icon.Download}" />
                                <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.ImportRemote}}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>