<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LemonNeo.Desktop.ViewModels" xmlns:i18n="using:LemonNeo.Desktop.Infrastructure"
             xmlns:controls="using:LemonNeo.Desktop.Controls"
             x:Class="LemonNeo.Desktop.Views.LyricsView" x:DataType="vm:LyricsViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <controls:PageHeader Title="{Binding PageTitle}" Description="{Binding PageDescription}" Summary="{Binding PageSummary}">
      <controls:PageHeader.Actions>
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsBusy}" ToolTip.Tip="{Binding Status}">
          <ProgressBar IsIndeterminate="True" Width="60" Height="3" VerticalAlignment="Center" AutomationProperties.Name="{Binding Status}" />
          <Button Classes="ghost" Command="{Binding CancelOperationCommand}" Content="{Translate {x:Static i18n:LanguageManager+Keys.CancelOperation}}" />
        </StackPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>
    <Border Grid.Row="1" IsVisible="{Binding HasError}" Background="{DynamicResource Brush.DangerSoft}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" MaxHeight="90" />
        <Button Grid.Column="1" Classes="ghost" Content="×" Command="{Binding DismissErrorCommand}" AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.DismissError}}" />
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <Grid>
        <controls:EmptyState IsVisible="{Binding !Playback.HasCurrentTrack}" Title="{Translate {x:Static i18n:LanguageManager+Keys.NoTrack}}"
                             Description="{Translate {x:Static i18n:LanguageManager+Keys.NoTrackDescription}}" Icon="{StaticResource Icon.Music}" />
        <ScrollViewer IsVisible="{Binding Playback.HasCurrentTrack}" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="28" HorizontalAlignment="Stretch" Margin="16">
            <controls:Artwork Width="160" Height="160" CornerRadius="32" Source="{Binding Playback.NowArtwork}"
                              HorizontalAlignment="Center" AutomationProperties.Name="{Binding Playback.NowTitle}" />
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding Playback.NowTitle}" FontSize="26" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Playback.NowArtist}" Classes="muted" TextAlignment="Center" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Playback.PlaybackLabel}" Classes="caption" TextAlignment="Center" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Playback.PlaybackDetails}" Classes="caption" TextAlignment="Center" TextWrapping="Wrap" />
              <WrapPanel HorizontalAlignment="Center" IsEnabled="{Binding Playback.CanInteract}">
                <Button Classes="ghost" Content="{Translate {x:Static i18n:LanguageManager+Keys.Sequential}}" Command="{Binding Playback.ModeCommand}" CommandParameter="Sequential" />
                <Button Classes="ghost" Content="{Translate {x:Static i18n:LanguageManager+Keys.RepeatAll}}" Command="{Binding Playback.ModeCommand}" CommandParameter="RepeatAll" />
                <Button Classes="ghost" Content="{Translate {x:Static i18n:LanguageManager+Keys.Shuffle}}" Command="{Binding Playback.ModeCommand}" CommandParameter="Shuffle" />
              </WrapPanel>
            </StackPanel>
            <StackPanel Spacing="24" IsVisible="{Binding HasTimedLyrics}">
              <TextBlock Text="{Binding PreviousLyric}" Classes="muted" TextAlignment="Center" TextWrapping="Wrap" Opacity="0.6" />
              <controls:LyricText Segments="{Binding RomanizationSegments}" FontSize="18" IsVisible="{Binding HasRomanization}"
                                  Foreground="{DynamicResource Brush.TextSecondary}" ReachedBrush="{DynamicResource Brush.AccentText}" TextAlignment="Center" TextWrapping="Wrap" />
              <controls:LyricText Segments="{Binding CurrentLyricSegments}" FontSize="24" FontWeight="SemiBold"
                                  Foreground="{DynamicResource Brush.TextSecondary}" ReachedBrush="{DynamicResource Brush.AccentText}" TextAlignment="Center" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Translation}" Classes="muted" IsVisible="{Binding HasTranslation}" TextAlignment="Center" TextWrapping="Wrap" />
              <TextBlock Text="{Binding NextLyric}" Classes="muted" TextAlignment="Center" TextWrapping="Wrap" Opacity="0.6" />
            </StackPanel>
            <StackPanel IsVisible="{Binding !HasTimedLyrics}" Spacing="18">
              <TextBlock Text="{Binding LyricsText}" Classes="muted" TextAlignment="Center" TextWrapping="Wrap" />
              <controls:LyricText Segments="{Binding RomanizationSegments}" IsVisible="{Binding HasRomanization}" Foreground="{DynamicResource Brush.TextSecondary}"
                                  ReachedBrush="{DynamicResource Brush.AccentText}" TextAlignment="Center" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Translation}" IsVisible="{Binding HasTranslation}" Classes="muted" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
