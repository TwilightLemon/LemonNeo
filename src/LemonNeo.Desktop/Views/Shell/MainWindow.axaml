<Window
    Background="Transparent"
    ExtendClientAreaTitleBarHeightHint="56"
    Height="790"
    Icon="/Resources/Icons/App.ico"
    MinHeight="620"
    MinWidth="880"
    Name="DesktopWindow"
    Title="Lemon Neo"
    TransparencyBackgroundFallback="{DynamicResource Brush.Sidebar}"
    TransparencyLevelHint="AcrylicBlur, Blur, None"
    Width="1180"
    WindowDecorations="Full"
    WindowDecorationsTheme="{StaticResource LemonWindowDecorations}"
    WindowStartupLocation="CenterScreen"
    x:Class="LemonNeo.Desktop.Views.Shell.MainWindow"
    x:DataType="shellVm:MainViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:backgroundControls="using:LemonNeo.Desktop.Controls.Backgrounds"
    xmlns:i18n="using:LemonNeo.Desktop.Services"
    xmlns:playbackControls="using:LemonNeo.Desktop.Controls.Playback"
    xmlns:playbackViews="using:LemonNeo.Desktop.Views.Playback"
    xmlns:playbackVm="using:LemonNeo.Desktop.ViewModels.Playback"
    xmlns:sharedControls="using:LemonNeo.Desktop.Controls.Shared"
    xmlns:shellVm="using:LemonNeo.Desktop.ViewModels.Shell"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.Resources>
        <Thickness x:Key="Space.PlaybackInset">0,0,0,132</Thickness>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="Border#TopBar">
            <Setter Property="Padding" Value="24,10" />
        </Style>
        <Style Selector="Border#Sidebar">
            <Setter Property="Padding" Value="16,20,16,12" />
        </Style>
        <Style Selector="Border#TopBar.windows">
            <Setter Property="Padding" Value="24,10,164,10" />
        </Style>
        <Style Selector="Border#Sidebar.macos">
            <Setter Property="Padding" Value="16,32,16,12" />
        </Style>
        <Style Selector="backgroundControls|AppleMusicMeshBackground#DynamicArtworkBackground">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.RowSpan" Value="2" />
            <Setter Property="Opacity" Value="{DynamicResource Opacity.DynamicArtworkBackground}" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Duration="{DynamicResource Motion.Normal}" Property="Opacity" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="backgroundControls|AppleMusicMeshBackground#DynamicArtworkBackground.lyrics">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border#ContentBackground">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.RowSpan" Value="2" />
        </Style>
        <Style Selector="Grid#PageArea">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Margin" Value="32,20,32,0" />
        </Style>
        <Style Selector="Border#PlaybackBar">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.Row" Value="1" />
        </Style>
        <Style Selector="Border#Sidebar.lyricsExpanded, Border#TopBar.lyricsExpanded">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border#ContentBackground.lyricsExpanded, backgroundControls|AppleMusicMeshBackground#DynamicArtworkBackground.lyricsExpanded, Border#PlaybackBar.lyricsExpanded">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
        </Style>
        <Style Selector="Grid#PageArea.lyricsExpanded">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.RowSpan" Value="2" />
            <Setter Property="Margin" Value="32,48,32,0" />
        </Style>
        <Style Selector="ContentControl#PageContent ListBox:not(.serviceTabs):not(.playlistPicker) /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="Margin" Value="{DynamicResource Space.PlaybackInset}" />
        </Style>
        <Style Selector="ContentControl#PageContent ScrollViewer:not(#PART_ScrollViewer):not(#LyricsScrollViewer)">
            <Setter Property="Padding" Value="{DynamicResource Space.PlaybackInset}" />
        </Style>
    </Window.Styles>
    <Grid
        ClipToBounds="True"
        ColumnDefinitions="230,*"
        Name="ShellRoot"
        RowDefinitions="56,*">
        <Border
            Background="{DynamicResource Brush.Canvas}"
            Classes.lyricsExpanded="{Binding IsLyricsExpanded}"
            IsHitTestVisible="False"
            Name="ContentBackground" />
        <backgroundControls:AppleMusicMeshBackground
            ArtworkSource="{Binding Playback}"
            BassPulseScale="{Binding VisualEffects.AppleMusicMeshBassPulseScale}"
            BlurScale="{Binding VisualEffects.AppleMusicMeshBlurScale}"
            Classes.lyrics="{Binding Navigation.IsLyrics}"
            Classes.lyricsExpanded="{Binding IsLyricsExpanded}"
            FrameRateLimit="{Binding VisualEffects.AppleMusicMeshFrameRateLimit}"
            IsAnimationEnabled="{Binding Playback.CanAnimateBackground}"
            IsHitTestVisible="False"
            IsMeshEnabled="True"
            IsPlaying="{Binding Playback.IsPlaying}"
            IsVisible="{Binding IsAppleMusicMeshBackgroundVisible}"
            Name="DynamicArtworkBackground"
            PresetSlot="{Binding VisualEffects.AppleMusicMeshPresetSlot}"
            PulseSource="{Binding Playback}"
            RenderScale="{Binding VisualEffects.AppleMusicMeshRenderScale}"
            RotationScale="{Binding VisualEffects.AppleMusicMeshRotationScale}" />
        <Border
            Background="{DynamicResource Brush.SidebarTranslucent}"
            Classes.lyricsExpanded="{Binding IsLyricsExpanded}"
            Grid.RowSpan="2"
            Name="Sidebar">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <StackPanel
                    Margin="12,0,0,16"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Viewbox
                        Height="34"
                        VerticalAlignment="Center"
                        Width="34">
                        <Grid Height="56" Width="56">
                            <Border Background="{DynamicResource Brush.Accent}" CornerRadius="20" />
                            <Path
                                Data="{StaticResource Icon.AppMusic}"
                                Fill="{DynamicResource Brush.OnAccent}"
                                Height="56"
                                Stretch="None"
                                Width="56" />
                        </Grid>
                    </Viewbox>
                    <TextBlock
                        FontSize="23"
                        FontWeight="SemiBold"
                        Text="{Translate {x:Static i18n:LanguageManager+Keys.AppName}}"
                        VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel
                    Grid.Row="1"
                    Margin="0,0,0,12"
                    Spacing="4">
                    <StackPanel.Styles>
                        <Style Selector="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </StackPanel.Styles>
                    <Button
                        Classes="nav"
                        Classes.active="{Binding Navigation.IsLibrary}"
                        Command="{Binding Navigation.NavigateCommand}"
                        CommandParameter="Library">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="icon" Data="{StaticResource Icon.Library}" />
                            <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Library}}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Classes="nav"
                        Classes.active="{Binding Navigation.IsSearch}"
                        Command="{Binding Navigation.NavigateCommand}"
                        CommandParameter="Search">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="icon" Data="{StaticResource Icon.Search}" />
                            <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Search}}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Classes="nav"
                        Classes.active="{Binding Navigation.IsAccounts}"
                        Command="{Binding Navigation.NavigateCommand}"
                        CommandParameter="Accounts"
                        Name="AccountsNavigationButton">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="icon" Data="{StaticResource Icon.Account}" />
                            <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Accounts}}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Classes="nav"
                        Classes.active="{Binding Navigation.IsOnline}"
                        Command="{Binding Navigation.NavigateCommand}"
                        CommandParameter="Online">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="icon" Data="{StaticResource Icon.Folder}" />
                            <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Online}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Grid Grid.Row="2" RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto" Margin="16,0,8,4">
                        <TextBlock
                            Classes="caption"
                            Text="{Translate {x:Static i18n:LanguageManager+Keys.Playlists}}"
                            VerticalAlignment="Center" />
                        <Button
                            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.CreatePlaylist}}"
                            Classes="ghost icon"
                            Click="OnCreatePlaylist"
                            Grid.Column="1"
                            IsEnabled="{Binding SharedContext.IsInitialized}"
                            ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.CreatePlaylist}}">
                            <Path
                                Classes="icon"
                                Data="{StaticResource Icon.Add}"
                                Height="14"
                                Stretch="Fill"
                                Width="14" />
                        </Button>
                    </Grid>
                    <ListBox
                        Grid.Row="1"
                        IsEnabled="{Binding SharedContext.IsInitialized}"
                        ItemsSource="{Binding Playlists}"
                        Name="PlaylistList"
                        SelectedItem="{Binding SelectedPlaylist}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="shellVm:PlaylistMenuItemViewModel">
                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Classes="caption"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Text="{Binding TrackCount}"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                <StackPanel
                    Grid.Row="3"
                    Margin="0,8,0,0"
                    Spacing="4">
                    <StackPanel.Styles>
                        <Style Selector="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </StackPanel.Styles>
                    <Button
                        Classes="nav"
                        Classes.active="{Binding Navigation.IsTools}"
                        Command="{Binding Navigation.NavigateCommand}"
                        CommandParameter="Tools">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="icon" Data="{StaticResource Icon.Queue}" />
                            <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Tools}}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Classes="nav"
                        Classes.active="{Binding Navigation.IsSettings}"
                        Command="{Binding Navigation.NavigateCommand}"
                        CommandParameter="Settings">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="icon" Data="{StaticResource Icon.Settings}" />
                            <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Settings}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Border
            Background="Transparent"
            IsVisible="False"
            Name="MacCaptionDragArea"
            WindowDecorationProperties.ElementRole="TitleBar" />
        <Border
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,0"
            Classes.lyricsExpanded="{Binding IsLyricsExpanded}"
            Grid.Column="1"
            Name="TopBar"
            WindowDecorationProperties.ElementRole="TitleBar">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition MaxWidth="448" Width="5*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center"
                    WindowDecorationProperties.ElementRole="User">
                    <Button
                        AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Back}}"
                        Classes="ghost compact"
                        Command="{Binding Navigation.BackCommand}"
                        Name="BackButton"
                        ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Back}}">
                        <Path Classes="icon" Data="{StaticResource Icon.Back}" />
                    </Button>
                    <Button
                        AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Forward}}"
                        Classes="ghost compact"
                        Command="{Binding Navigation.ForwardCommand}"
                        Name="ForwardButton"
                        ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Forward}}">
                        <Path Classes="icon" Data="{StaticResource Icon.Forward}" />
                    </Button>
                </StackPanel>
                <Grid
                    ColumnDefinitions="*,Auto"
                    Grid.Column="1"
                    Margin="16,0,12,0"
                    Name="SearchArea"
                    VerticalAlignment="Center"
                    WindowDecorationProperties.ElementRole="User">
                    <TextBox
                        AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.SearchMusic}}"
                        Classes="toolbarSearch"
                        IsEnabled="{Binding SharedContext.IsInitialized}"
                        KeyDown="OnSearchKeyDown"
                        Name="GlobalSearch"
                        PlaceholderText="{Translate {x:Static i18n:LanguageManager+Keys.SearchMusic}}"
                        Text="{Binding SearchQuery}"
                        VerticalContentAlignment="Center" />
                    <Button
                        AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.SearchMusic}}"
                        Classes="ghost compact"
                        Command="{Binding SearchCommand}"
                        Grid.Column="1"
                        Margin="4,0,0,0"
                        ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.SearchMusic}}">
                        <Path Classes="icon" Data="{StaticResource Icon.Search}" />
                    </Button>
                </Grid>
                <ProgressBar
                    AutomationProperties.Name="{Binding Status}"
                    Grid.Column="3"
                    Height="3"
                    IsHitTestVisible="False"
                    IsIndeterminate="True"
                    IsVisible="{Binding IsBusy}"
                    VerticalAlignment="Center"
                    Width="40" />
            </Grid>
        </Border>
        <Grid
            Classes.lyricsExpanded="{Binding IsLyricsExpanded}"
            Name="PageArea"
            RowDefinitions="Auto,*">
            <Border
                Background="{DynamicResource Brush.DangerSoft}"
                CornerRadius="10"
                IsVisible="{Binding HasError}"
                Margin="0,0,0,12"
                Padding="14">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        Foreground="{DynamicResource Brush.Danger}"
                        MaxHeight="90"
                        Text="{Binding Error}"
                        TextWrapping="Wrap" />
                    <Button
                        AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.DismissError}}"
                        Classes="ghost icon"
                        Command="{Binding DismissErrorCommand}"
                        Grid.Column="1">
                        <Path Classes="icon" Data="{StaticResource Icon.Close}" />
                    </Button>
                </Grid>
            </Border>
            <ContentControl
                Classes.lyrics="{Binding Navigation.IsLyrics}"
                Content="{Binding Navigation.Host}"
                Grid.Row="1"
                HorizontalContentAlignment="Stretch"
                Name="PageContent"
                SizeChanged="OnPageContentSizeChanged"
                VerticalContentAlignment="Stretch" />
            <Grid
                Grid.Row="1"
                HorizontalAlignment="Left"
                IsVisible="{Binding Navigation.IsLyrics}"
                VerticalAlignment="Top"
                ZIndex="2">
                <Button
                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.ExpandLyricsView}}"
                    Classes="ghost compact"
                    Command="{Binding ToggleLyricsExpandedCommand}"
                    IsVisible="{Binding !IsLyricsExpanded}"
                    Name="ExpandLyricsViewButton"
                    ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.ExpandLyricsView}}">
                    <Path Classes="icon" Data="{StaticResource Icon.Expand}" />
                </Button>
                <Button
                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.RestoreLyricsView}}"
                    Classes="ghost compact"
                    Command="{Binding ToggleLyricsExpandedCommand}"
                    IsVisible="{Binding IsLyricsExpanded}"
                    Name="RestoreLyricsViewButton"
                    ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.RestoreLyricsView}}">
                    <Path Classes="icon" Data="{StaticResource Icon.Restore}" />
                </Button>
            </Grid>
        </Grid>
        <Border
            Background="Transparent"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            BoxShadow="0 8 28 0 #24000000"
            Classes.lyricsExpanded="{Binding IsLyricsExpanded}"
            CornerRadius="20"
            Margin="20,0,20,20"
            MaxWidth="1020"
            MinHeight="100"
            Name="PlaybackBar"
            SizeChanged="OnPlaybackBarSizeChanged"
            VerticalAlignment="Bottom"
            ZIndex="1">
            <Grid>
                <sharedControls:FrostedGlass
                    Background="{DynamicResource Brush.PlaybackSurface}"
                    CornerRadius="20"
                    IsHitTestVisible="False" />
                <playbackControls:AudioVisualizer
                    Fill="{DynamicResource Brush.Accent}"
                    Height="64"
                    IsHitTestVisible="False"
                    IsPlaying="{Binding Playback.IsPlaying}"
                    IsVisible="{Binding Playback.CanVisualizeAudio}"
                    Margin="20,0,20,2"
                    Opacity="0.34"
                    Source="{Binding Playback}"
                    StripCount="{Binding VisualEffects.AudioVisualizerStripCount}"
                    VerticalAlignment="Bottom" />
                <Grid Margin="16,24,16,16" RowDefinitions="Auto,*">
                    <Grid
                        ColumnDefinitions="*,Auto"
                        IsVisible="{Binding Playback.HasError}"
                        Margin="0,0,0,4">
                        <TextBlock
                            Foreground="{DynamicResource Brush.Danger}"
                            Text="{Binding Playback.Error}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip.Tip="{Binding Playback.Error}" />
                        <Button
                            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.DismissError}}"
                            Classes="ghost compact"
                            Command="{Binding Playback.DismissErrorCommand}"
                            Grid.Column="1"
                            Height="20"
                            MinHeight="20"
                            Padding="4,0">
                            <Path
                                Classes="icon"
                                Data="{StaticResource Icon.Close}"
                                Height="12"
                                Width="12" />
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto,*" Grid.Row="1">
                        <Button
                            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Lyrics}}"
                            Classes="ghost"
                            Command="{Binding Navigation.NavigateCommand}"
                            CommandParameter="Lyrics"
                            CornerRadius="12"
                            HorizontalContentAlignment="Stretch"
                            Margin="0,0,76,0"
                            Name="NowPlayingButton"
                            Padding="8,0"
                            ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Lyrics}}">
                            <Grid ColumnDefinitions="48,*">
                                <sharedControls:TransitionArtwork
                                    AutomationProperties.Name="{Binding Playback.NowTitle}"
                                    CornerRadius="10"
                                    Height="48"
                                    ReduceMotion="{Binding Lyrics.ReduceMotion}"
                                    Source="{Binding Playback.NowArtworkReference}"
                                    VerticalAlignment="Center"
                                    Width="48" />
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{Binding Playback.NowTitle}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip.Tip="{Binding Playback.NowTitle}" />
                                    <TextBlock
                                        Classes="caption"
                                        Text="{Binding Playback.NowArtist}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip.Tip="{Binding Playback.NowArtist}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button
                            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.DesktopLyrics}}"
                            Classes="ghost icon"
                            Classes.active="{Binding #DesktopWindow.IsDesktopLyricsOpen}"
                            Click="OnToggleDesktopLyrics"
                            HorizontalAlignment="Right"
                            Margin="0,0,16,0"
                            Name="DesktopLyricsButton"
                            Padding="0"
                            ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.DesktopLyrics}}"
                            VerticalAlignment="Center">
                            <Path Classes="icon" Data="{StaticResource Icon.DesktopLyrics}" />
                        </Button>
                        <StackPanel
                            Grid.Column="1"
                            Name="PlaybackControls"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                            <Button
                                AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Previous}}"
                                Classes="ghost icon"
                                Command="{Binding Playback.PreviousCommand}"
                                IsEnabled="{Binding Playback.CanPrevious}"
                                Name="PreviousButton"
                                Padding="0"
                                ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Previous}}">
                                <Viewbox
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    MaxWidth="22"
                                    VerticalAlignment="Center">
                                    <Path
                                        Data="{StaticResource Icon.Playback.Previous}"
                                        Fill="{DynamicResource Brush.Text}"
                                        Stretch="Uniform" />
                                </Viewbox>
                            </Button>
                            <Button
                                AutomationProperties.Name="{Binding Playback.PlayLabel}"
                                Classes="primary"
                                Command="{Binding Playback.TogglePlaybackCommand}"
                                CornerRadius="24"
                                Height="48"
                                IsEnabled="{Binding Playback.CanTogglePlayback}"
                                Name="PlayPauseButton"
                                Padding="0"
                                ToolTip.Tip="{Binding Playback.PlayLabel}"
                                Width="48">
                                <Grid>
                                    <Viewbox
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        IsVisible="{Binding !Playback.IsPlaying}"
                                        Margin="4,0,0,0"
                                        MaxWidth="22"
                                        VerticalAlignment="Center">
                                        <Path
                                            Data="{StaticResource Icon.Playback.Play}"
                                            Fill="{DynamicResource Brush.OnAccent}"
                                            Stretch="Uniform" />
                                    </Viewbox>
                                    <Viewbox
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        IsVisible="{Binding Playback.IsPlaying}"
                                        MaxWidth="22"
                                        VerticalAlignment="Center">
                                        <Path
                                            Data="{StaticResource Icon.Playback.Pause}"
                                            Fill="{DynamicResource Brush.OnAccent}"
                                            Stretch="Uniform" />
                                    </Viewbox>
                                </Grid>
                            </Button>
                            <Button
                                AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Next}}"
                                Classes="ghost icon"
                                Command="{Binding Playback.NextCommand}"
                                IsEnabled="{Binding Playback.CanNext}"
                                Name="NextButton"
                                Padding="0"
                                ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Next}}">
                                <Viewbox
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    MaxWidth="22"
                                    VerticalAlignment="Center">
                                    <Path
                                        Data="{StaticResource Icon.Playback.Next}"
                                        Fill="{DynamicResource Brush.Text}"
                                        Stretch="Uniform" />
                                </Viewbox>
                            </Button>
                        </StackPanel>
                        <Grid
                            ColumnDefinitions="Auto,*"
                            Grid.Column="2"
                            Margin="16,0,0,0">
                            <Button
                                AutomationProperties.Name="{Binding Playback.ModeLabel}"
                                Classes="ghost icon"
                                Command="{Binding Playback.CycleModeCommand}"
                                IsEnabled="{Binding Playback.CanInteract}"
                                Name="PlaybackModeButton"
                                Padding="0"
                                ToolTip.Tip="{Binding Playback.ModeLabel}"
                                VerticalAlignment="Center">
                                <Grid>
                                    <Viewbox
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        IsVisible="{Binding Playback.IsSequential}"
                                        MaxWidth="20"
                                        VerticalAlignment="Center">
                                        <Path
                                            Data="{StaticResource Icon.Playback.Sequential}"
                                            Fill="{DynamicResource Brush.TextSecondary}"
                                            Stretch="Uniform" />
                                    </Viewbox>
                                    <Viewbox
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        IsVisible="{Binding Playback.IsRepeatAll}"
                                        MaxWidth="20"
                                        VerticalAlignment="Center">
                                        <Path
                                            Data="{StaticResource Icon.Playback.RepeatAll}"
                                            Fill="{DynamicResource Brush.TextSecondary}"
                                            Stretch="Uniform" />
                                    </Viewbox>
                                    <Viewbox
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        IsVisible="{Binding Playback.IsShuffle}"
                                        MaxWidth="20"
                                        VerticalAlignment="Center">
                                        <Path
                                            Data="{StaticResource Icon.Playback.Shuffle}"
                                            Fill="{DynamicResource Brush.TextSecondary}"
                                            Stretch="Uniform" />
                                    </Viewbox>
                                </Grid>
                            </Button>
                            <Grid
                                ColumnDefinitions="*,Auto,Auto"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                                    <Button
                                        AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSourceDetails}}"
                                        Classes="ghost"
                                        Click="OnToggleSourceDetails"
                                        IsEnabled="{Binding Playback.HasSourceDetails}"
                                        Name="CurrentAudioQuality"
                                        Padding="6,2"
                                        ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSourceDetails}}">
                                        <TextBlock Classes="caption" Text="{Binding Playback.QualityLabel}" />
                                    </Button>
                                    <TextBlock
                                        Classes="caption"
                                        Text="{Binding Playback.TimeLabel}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                                <Button
                                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Volume}}"
                                    Classes="ghost icon"
                                    Click="OnToggleVolume"
                                    Grid.Column="1"
                                    IsEnabled="{Binding Playback.CanAdjustVolume}"
                                    Margin="8,0,0,0"
                                    Name="VolumeButton"
                                    Padding="0"
                                    ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Volume}}">
                                    <Grid>
                                        <Viewbox
                                            Height="18"
                                            IsVisible="{Binding !Playback.IsMuted}"
                                            MaxWidth="20">
                                            <Path
                                                Data="{StaticResource Icon.Volume}"
                                                Fill="{DynamicResource Brush.TextSecondary}"
                                                Stretch="Uniform" />
                                        </Viewbox>
                                        <Viewbox
                                            Height="18"
                                            IsVisible="{Binding Playback.IsMuted}"
                                            MaxWidth="20">
                                            <Path
                                                Data="{StaticResource Icon.VolumeMuted}"
                                                Fill="{DynamicResource Brush.TextSecondary}"
                                                Stretch="Uniform" />
                                        </Viewbox>
                                    </Grid>
                                </Button>
                                <Button
                                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Queue}}"
                                    Classes="ghost icon"
                                    Command="{Binding ToggleQueueCommand}"
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    Name="QueueButton"
                                    Padding="0"
                                    ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Queue}}">
                                    <Viewbox
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        MaxWidth="20"
                                        VerticalAlignment="Center">
                                        <Path
                                            Data="{StaticResource Icon.Playback.Queue}"
                                            Fill="{DynamicResource Brush.TextSecondary}"
                                            Stretch="Uniform" />
                                    </Viewbox>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
                <Slider
                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Seek}}"
                    IsEnabled="{Binding Playback.CanSeek}"
                    IsVisible="{Binding !Playback.IsBusy}"
                    Margin="20,2,20,0"
                    Maximum="{Binding Playback.DurationSeconds}"
                    Minimum="0"
                    Name="Timeline"
                    Theme="{StaticResource PlaybackTimeline}"
                    Value="{Binding Playback.PositionSeconds, Mode=OneWay}"
                    VerticalAlignment="Top" />
                <ProgressBar
                    AutomationProperties.Name="{Binding Playback.Status}"
                    Background="Transparent"
                    Foreground="{DynamicResource Brush.AccentText}"
                    Height="2"
                    IsHitTestVisible="False"
                    IsIndeterminate="True"
                    IsVisible="{Binding Playback.IsBusy}"
                    Margin="20,10,20,0"
                    MinHeight="0"
                    Name="PlaybackLoading"
                    VerticalAlignment="Top" />
            </Grid>
        </Border>
        <Popup
            Closed="OnSourceDetailsClosed"
            IsLightDismissEnabled="True"
            IsOpen="{Binding Playback.IsSourceDetailsOpen, Mode=TwoWay}"
            Name="SourceDetailsPopup"
            Opened="OnSourceDetailsOpened"
            OverlayDismissEventPassThrough="False"
            Placement="TopEdgeAlignedRight"
            PlacementTarget="CurrentAudioQuality"
            ShouldUseOverlayLayer="True"
            VerticalOffset="-8">
            <Border
                Background="{DynamicResource Brush.SurfaceRaised}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                BoxShadow="0 4 20 0 #26000000"
                CornerRadius="16"
                Focusable="True"
                KeyDown="OnSourceDetailsKeyDown"
                Name="SourceDetailsCard"
                Padding="20"
                Width="420">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" MaxHeight="440">
                    <StackPanel Spacing="16">
                        <TextBlock FontWeight="SemiBold" Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSourceDetails}}" />
                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="16"
                            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                            RowSpacing="8">
                            <TextBlock Classes="caption" Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSourceType}}" />
                            <SelectableTextBlock
                                Grid.Column="1"
                                Text="{Binding Playback.SourceType}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Classes="caption"
                                Grid.Row="1"
                                Text="{Translate {x:Static i18n:LanguageManager+Keys.ProviderId}}" />
                            <SelectableTextBlock
                                Grid.Column="1"
                                Grid.Row="1"
                                Text="{Binding Playback.SourceProvider}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Classes="caption"
                                Grid.Row="2"
                                Text="{Translate {x:Static i18n:LanguageManager+Keys.Namespace}}" />
                            <SelectableTextBlock
                                Grid.Column="1"
                                Grid.Row="2"
                                Text="{Binding Playback.SourceNamespace}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Classes="caption"
                                Grid.Row="3"
                                Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSourceKind}}" />
                            <SelectableTextBlock
                                Grid.Column="1"
                                Grid.Row="3"
                                Text="{Binding Playback.SourceKind}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Classes="caption"
                                Grid.Row="4"
                                Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSourceId}}" />
                            <SelectableTextBlock
                                Grid.Column="1"
                                Grid.Row="4"
                                Text="{Binding Playback.SourceId}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Classes="caption"
                                Grid.Row="5"
                                Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSourceQuality}}" />
                            <SelectableTextBlock
                                Grid.Column="1"
                                Grid.Row="5"
                                Text="{Binding Playback.QualityLabel}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Classes="caption"
                                Grid.Row="6"
                                Text="{Binding Playback.BitrateOrigin}" />
                            <SelectableTextBlock
                                Grid.Column="1"
                                Grid.Row="6"
                                Text="{Binding Playback.SourceBitrate}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Classes="caption"
                                Grid.Row="7"
                                Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSourcePlayer}}" />
                            <SelectableTextBlock
                                Grid.Column="1"
                                Grid.Row="7"
                                Text="{Binding Playback.SourcePlayer}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Classes="caption"
                                Grid.Row="8"
                                Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackCodec}}" />
                            <SelectableTextBlock
                                Grid.Column="1"
                                Grid.Row="8"
                                Text="{Binding Playback.SourceCodec}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Classes="caption"
                                Grid.Row="9"
                                Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSampleRate}}" />
                            <SelectableTextBlock
                                Grid.Column="1"
                                Grid.Row="9"
                                Text="{Binding Playback.SourceSampleRate}" />
                            <TextBlock
                                Classes="caption"
                                Grid.Row="10"
                                Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackBitDepth}}" />
                            <SelectableTextBlock
                                Grid.Column="1"
                                Grid.Row="10"
                                Text="{Binding Playback.SourceBitDepth}" />
                            <TextBlock
                                Classes="caption"
                                Grid.Row="11"
                                Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackChannels}}" />
                            <SelectableTextBlock
                                Grid.Column="1"
                                Grid.Row="11"
                                Text="{Binding Playback.SourceChannels}" />
                        </Grid>
                        <StackPanel Spacing="6">
                            <TextBlock Classes="caption" Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSourceLocation}}" />
                            <SelectableTextBlock
                                FontSize="12"
                                Name="PlaybackSourceLocation"
                                Text="{Binding Playback.SourceLocation}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
        <Popup
            Closed="OnVolumeClosed"
            IsLightDismissEnabled="True"
            Name="VolumePopup"
            Opened="OnVolumeOpened"
            OverlayDismissEventPassThrough="False"
            Placement="TopEdgeAlignedRight"
            PlacementTarget="VolumeButton"
            ShouldUseOverlayLayer="True"
            VerticalOffset="-8">
            <Border
                Background="{DynamicResource Brush.SurfaceRaised}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                BoxShadow="0 4 20 0 #26000000"
                CornerRadius="16"
                KeyDown="OnVolumeKeyDown"
                Padding="16"
                Width="220">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Volume}}" />
                        <TextBlock
                            Classes="caption"
                            Grid.Column="1"
                            Text="{Binding Playback.VolumeLabel}" />
                    </Grid>
                    <Slider
                        AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Volume}}"
                        IsEnabled="{Binding Playback.CanAdjustVolume}"
                        LargeChange="10"
                        Maximum="100"
                        Minimum="0"
                        Name="VolumeSlider"
                        SmallChange="1"
                        Value="{Binding Playback.VolumePercent, Mode=TwoWay}" />
                </StackPanel>
            </Border>
        </Popup>
        <Popup
            Closed="OnQueueClosed"
            IsLightDismissEnabled="True"
            IsOpen="{Binding IsQueueOpen, Mode=TwoWay}"
            Name="QueuePopup"
            Opened="OnQueueOpened"
            OverlayDismissEventPassThrough="False"
            Placement="AnchorAndGravity"
            PlacementAnchor="TopRight"
            PlacementConstraintAdjustment="None"
            PlacementGravity="BottomLeft"
            PlacementTarget="ShellRoot"
            ShouldUseOverlayLayer="True">
            <Border
                Background="Transparent"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1,0,0,0"
                CornerRadius="16,0,0,16"
                Focusable="True"
                Height="{Binding #ShellRoot.Bounds.Height}"
                KeyDown="OnQueueKeyDown"
                Name="QueueCard"
                Width="380">
                <Grid>
                    <sharedControls:FrostedGlass
                        Background="{DynamicResource Brush.PlaybackSurface}"
                        CornerRadius="16"
                        IsHitTestVisible="False" />
                    <ContentControl
                        Content="{Binding QueueDrawer}"
                        HorizontalContentAlignment="Stretch"
                        Padding="20,24,20,16"
                        VerticalContentAlignment="Stretch">
                        <ContentControl.DataTemplates>
                            <DataTemplate DataType="{x:Type playbackVm:PlaybackQueueViewModel}">
                                <playbackViews:QueueDrawerView />
                            </DataTemplate>
                        </ContentControl.DataTemplates>
                    </ContentControl>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
