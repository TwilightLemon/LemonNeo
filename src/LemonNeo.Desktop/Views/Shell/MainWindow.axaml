<Window
    Background="Transparent"
    ExtendClientAreaTitleBarHeightHint="56"
    Height="790"
    Icon="/Resources/Icons/App.ico"
    MinHeight="620"
    MinWidth="880"
    Name="DesktopWindow"
    Title="Lemon Neo"
    TransparencyBackgroundFallback="{DynamicResource Brush.Sidebar}"
    TransparencyLevelHint="AcrylicBlur, Blur, None"
    Width="1180"
    WindowDecorations="Full"
    WindowDecorationsTheme="{StaticResource LemonWindowDecorations}"
    WindowStartupLocation="CenterScreen"
    x:Class="LemonNeo.Desktop.Views.Shell.MainWindow"
    x:DataType="shellVm:MainViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:backgroundControls="using:LemonNeo.Desktop.Controls.Backgrounds"
    xmlns:i18n="using:LemonNeo.Desktop.Services"
    xmlns:playbackControls="using:LemonNeo.Desktop.Controls.Playback"
    xmlns:playbackViews="using:LemonNeo.Desktop.Views.Playback"
    xmlns:playbackVm="using:LemonNeo.Desktop.ViewModels.Playback"
    xmlns:sharedControls="using:LemonNeo.Desktop.Controls.Shared"
    xmlns:shellVm="using:LemonNeo.Desktop.ViewModels.Shell"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.Resources>
        <Thickness x:Key="Space.PlaybackInset">0,0,0,104</Thickness>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="Border#TopBar">
            <Setter Property="Padding" Value="24,10" />
        </Style>
        <Style Selector="Border#Sidebar">
            <Setter Property="Padding" Value="16,20,16,12" />
        </Style>
        <Style Selector="Border#TopBar.windows">
            <Setter Property="Padding" Value="24,10,164,10" />
        </Style>
        <Style Selector="Border#Sidebar.macos">
            <Setter Property="Padding" Value="16,32,16,12" />
        </Style>
        <Style Selector="backgroundControls|AppleMusicMeshBackground#DynamicArtworkBackground">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.RowSpan" Value="2" />
            <Setter Property="Opacity" Value="{DynamicResource Opacity.DynamicArtworkBackground}" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Duration="{DynamicResource Motion.Normal}" Property="Opacity" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="backgroundControls|AppleMusicMeshBackground#DynamicArtworkBackground.lyrics">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="backgroundControls|AppleMusicMeshBackground#DynamicArtworkBackground.lyricsOnly:not(.lyrics)">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="backgroundControls|AppleMusicMeshBackground#DynamicArtworkBackground.disabled, backgroundControls|AppleMusicMeshBackground#DynamicArtworkBackground.lyricsOnly:not(.lyrics):transparent">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border#ContentBackground">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.RowSpan" Value="2" />
        </Style>
        <Style Selector="Grid#PageArea">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Margin" Value="32,20,32,0" />
        </Style>
        <Style Selector="Border#PlaybackBar, Grid#PlaybackNotifications">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.Row" Value="1" />
        </Style>
        <Style Selector="Border#Sidebar.lyricsExpanded, Border#TopBar.lyricsExpanded">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border#ContentBackground.lyricsExpanded, backgroundControls|AppleMusicMeshBackground#DynamicArtworkBackground.lyricsExpanded, Border#PlaybackBar.lyricsExpanded, Grid#PlaybackNotifications.lyricsExpanded">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
        </Style>
        <Style Selector="Grid#PageArea.lyricsExpanded">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.RowSpan" Value="2" />
            <Setter Property="Margin" Value="32,48,32,0" />
        </Style>
        <Style Selector="ContentControl#PageContent ListBox:not(.playlistPicker) /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="Margin" Value="{DynamicResource Space.PlaybackInset}" />
        </Style>
        <Style Selector="ContentControl#PageContent ScrollViewer:not(#PART_ScrollViewer):not(#LyricsScrollViewer)">
            <Setter Property="Padding" Value="{DynamicResource Space.PlaybackInset}" />
        </Style>
        <Style Selector="Panel#NowPlayingArtwork">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Duration="{DynamicResource Motion.Fast}" Property="RenderTransform" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button#NowPlayingArtworkButton:pointerover Panel#NowPlayingArtwork, Button#NowPlayingArtworkButton:focus-visible Panel#NowPlayingArtwork">
            <Setter Property="RenderTransform" Value="scale(1.08)" />
        </Style>
        <Style Selector="Border#ArtworkExpand, Grid#SeekTimes">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Duration="{DynamicResource Motion.Fast}" Property="Opacity" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button#NowPlayingArtworkButton:pointerover Border#ArtworkExpand, Button#NowPlayingArtworkButton:focus-visible Border#ArtworkExpand">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Grid#TrackInfo">
            <Setter Property="Effect">
                <BlurEffect Radius="0" />
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <EffectTransition Duration="{DynamicResource Motion.Normal}" Property="Effect" />
                    <DoubleTransition Duration="{DynamicResource Motion.Normal}" Property="Opacity" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid#NowPlaying.seekHover Grid#TrackInfo, Grid#NowPlaying.scrubbing Grid#TrackInfo">
            <Setter Property="Effect">
                <BlurEffect Radius="5" />
            </Setter>
            <Setter Property="Opacity" Value="0.24" />
        </Style>
        <Style Selector="Grid#NowPlaying.seekHover Grid#SeekTimes, Grid#NowPlaying.scrubbing Grid#SeekTimes">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="TextBlock.seekTime">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFeatures" Value="tnum" />
        </Style>
        <Style Selector="Button.qualityBadge">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="17" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
    </Window.Styles>
    <Grid
        ClipToBounds="True"
        ColumnDefinitions="230,*"
        Name="ShellRoot"
        RowDefinitions="56,*">
        <Border
            Background="{DynamicResource Brush.Canvas}"
            Classes.lyricsExpanded="{Binding IsLyricsExpanded}"
            IsHitTestVisible="False"
            Name="ContentBackground" />
        <backgroundControls:AppleMusicMeshBackground
            ArtworkSource="{Binding Playback}"
            BassPulseScale="{Binding VisualEffects.AppleMusicMeshBassPulseScale}"
            BlurScale="{Binding VisualEffects.AppleMusicMeshBlurScale}"
            Classes.disabled="{Binding !VisualEffects.AppleMusicMeshEnabled}"
            Classes.lyrics="{Binding Navigation.IsLyricsPageTarget}"
            Classes.lyricsExpanded="{Binding IsLyricsExpanded}"
            Classes.lyricsOnly="{Binding VisualEffects.AppleMusicMeshLyricsOnly}"
            FrameRateLimit="{Binding VisualEffects.AppleMusicMeshFrameRateLimit}"
            IsAnimationEnabled="{Binding Playback.CanAnimateBackground}"
            IsHitTestVisible="False"
            IsMeshEnabled="True"
            IsPlaying="{Binding Playback.IsPlaying}"
            Name="DynamicArtworkBackground"
            PresetSlot="{Binding VisualEffects.AppleMusicMeshPresetSlot}"
            PulseSource="{Binding Playback}"
            RenderScale="{Binding VisualEffects.AppleMusicMeshRenderScale}"
            RotationScale="{Binding VisualEffects.AppleMusicMeshRotationScale}" />
        <Border
            Background="{DynamicResource Brush.SidebarTranslucent}"
            Classes.lyricsExpanded="{Binding IsLyricsExpanded}"
            Grid.RowSpan="2"
            Name="Sidebar">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <StackPanel
                    Margin="12,0,0,16"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Viewbox
                        Height="34"
                        VerticalAlignment="Center"
                        Width="34">
                        <Grid Height="56" Width="56">
                            <Border Background="{DynamicResource Brush.Accent}" CornerRadius="20" />
                            <Path
                                Data="{StaticResource Icon.AppMusic}"
                                Fill="{DynamicResource Brush.OnAccent}"
                                Height="56"
                                Stretch="None"
                                Width="56" />
                        </Grid>
                    </Viewbox>
                    <TextBlock
                        FontSize="23"
                        FontWeight="SemiBold"
                        Text="{Translate {x:Static i18n:LanguageManager+Keys.AppName}}"
                        VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel
                    Grid.Row="1"
                    Margin="0,0,0,12"
                    Spacing="4">
                    <StackPanel.Styles>
                        <Style Selector="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </StackPanel.Styles>
                    <Button
                        Classes="nav"
                        Classes.active="{Binding Navigation.IsLibrary}"
                        Command="{Binding Navigation.NavigateCommand}"
                        CommandParameter="Library">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="icon" Data="{StaticResource Icon.Library}" />
                            <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Library}}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Classes="nav"
                        Classes.active="{Binding Navigation.IsSearch}"
                        Command="{Binding Navigation.NavigateCommand}"
                        CommandParameter="Search">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="icon" Data="{StaticResource Icon.Search}" />
                            <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Search}}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Classes="nav"
                        Classes.active="{Binding Navigation.IsAccounts}"
                        Command="{Binding Navigation.NavigateCommand}"
                        CommandParameter="Accounts"
                        Name="AccountsNavigationButton">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="icon" Data="{StaticResource Icon.Account}" />
                            <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Accounts}}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Classes="nav"
                        Classes.active="{Binding Navigation.IsOnline}"
                        Command="{Binding Navigation.NavigateCommand}"
                        CommandParameter="Online">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="icon" Data="{StaticResource Icon.Folder}" />
                            <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Online}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Grid Grid.Row="2" RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto" Margin="16,0,8,4">
                        <TextBlock
                            Classes="caption"
                            Text="{Translate {x:Static i18n:LanguageManager+Keys.Playlists}}"
                            VerticalAlignment="Center" />
                        <Button
                            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.CreatePlaylist}}"
                            Classes="ghost icon"
                            Click="OnCreatePlaylist"
                            Grid.Column="1"
                            IsEnabled="{Binding SharedContext.IsInitialized}"
                            ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.CreatePlaylist}}">
                            <Path Classes="icon small" Data="{StaticResource Icon.Add}" />
                        </Button>
                    </Grid>
                    <ListBox
                        Grid.Row="1"
                        IsEnabled="{Binding SharedContext.IsInitialized}"
                        ItemsSource="{Binding Playlists}"
                        Name="PlaylistList"
                        SelectedItem="{Binding SelectedPlaylist}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="shellVm:PlaylistMenuItemViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <sharedControls:Artwork
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Height="24"
                                        Loader="{Binding ArtworkLoader}"
                                        SourceUri="{Binding ArtworkUri}"
                                        VerticalAlignment="Center"
                                        Width="24" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Classes="caption"
                                        Grid.Column="2"
                                        Text="{Binding TrackCount}"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                <StackPanel
                    Grid.Row="3"
                    Margin="0,8,0,0"
                    Spacing="4">
                    <StackPanel.Styles>
                        <Style Selector="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </StackPanel.Styles>
                    <Button
                        Classes="nav"
                        Classes.active="{Binding Navigation.IsTools}"
                        Command="{Binding Navigation.NavigateCommand}"
                        CommandParameter="Tools">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="icon" Data="{StaticResource Icon.Tools}" />
                            <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Tools}}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Classes="nav"
                        Classes.active="{Binding Navigation.IsSettings}"
                        Command="{Binding Navigation.NavigateCommand}"
                        CommandParameter="Settings">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="icon" Data="{StaticResource Icon.Settings}" />
                            <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Settings}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Border
            Background="Transparent"
            IsVisible="False"
            Name="MacCaptionDragArea"
            WindowDecorationProperties.ElementRole="TitleBar" />
        <Border
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,0"
            Classes.lyricsExpanded="{Binding IsLyricsExpanded}"
            Grid.Column="1"
            Name="TopBar"
            WindowDecorationProperties.ElementRole="TitleBar">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition MaxWidth="448" Width="5*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center"
                    WindowDecorationProperties.ElementRole="User">
                    <Button
                        AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Back}}"
                        Classes="ghost compact"
                        Command="{Binding Navigation.BackCommand}"
                        Name="BackButton"
                        ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Back}}">
                        <Path Classes="icon" Data="{StaticResource Icon.Back}" />
                    </Button>
                    <Button
                        AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Forward}}"
                        Classes="ghost compact"
                        Command="{Binding Navigation.ForwardCommand}"
                        Name="ForwardButton"
                        ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Forward}}">
                        <Path Classes="icon" Data="{StaticResource Icon.Forward}" />
                    </Button>
                </StackPanel>
                <Grid
                    ColumnDefinitions="*,Auto"
                    Grid.Column="1"
                    Margin="16,0,12,0"
                    Name="SearchArea"
                    VerticalAlignment="Center"
                    WindowDecorationProperties.ElementRole="User">
                    <TextBox
                        AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.SearchMusic}}"
                        Classes="toolbarSearch"
                        IsEnabled="{Binding SharedContext.IsInitialized}"
                        KeyDown="OnSearchKeyDown"
                        Name="GlobalSearch"
                        PlaceholderText="{Translate {x:Static i18n:LanguageManager+Keys.SearchMusic}}"
                        Text="{Binding SearchQuery}"
                        VerticalContentAlignment="Center" />
                    <Button
                        AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.SearchMusic}}"
                        Classes="ghost icon compact"
                        Command="{Binding SearchCommand}"
                        Grid.Column="1"
                        Margin="4,0,0,0"
                        ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.SearchMusic}}">
                        <Path Classes="icon" Data="{StaticResource Icon.Search}" />
                    </Button>
                </Grid>
                <ProgressBar
                    AutomationProperties.Name="{Binding Status}"
                    Grid.Column="3"
                    Height="3"
                    IsHitTestVisible="False"
                    IsIndeterminate="True"
                    IsVisible="{Binding IsBusy}"
                    VerticalAlignment="Center"
                    Width="40" />
            </Grid>
        </Border>
        <Grid Classes.lyricsExpanded="{Binding IsLyricsExpanded}" Name="PageArea" RowDefinitions="Auto,*">
            <Border
                Background="{DynamicResource Brush.AccentSoft}"
                CornerRadius="10"
                IsVisible="{Binding SharedContext.Updates.ShowNotification}"
                Margin="0,0,0,12"
                Padding="14">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock
                        Foreground="{DynamicResource Brush.AccentText}"
                        Margin="0,0,12,0"
                        Text="{Binding SharedContext.Updates.AvailableVersionText}"
                        TextWrapping="Wrap"
                        VerticalAlignment="Center" />
                    <Button
                        Classes="ghost"
                        Command="{Binding SharedContext.Updates.OpenReleaseCommand}"
                        Content="{Translate {x:Static i18n:LanguageManager+Keys.UpdateViewRelease}}"
                        Grid.Column="1" />
                    <Button
                        AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.UpdateDismiss}}"
                        Classes="ghost icon"
                        Command="{Binding SharedContext.Updates.DismissCommand}"
                        Grid.Column="2"
                        Margin="8,0,0,0">
                        <Path Classes="icon" Data="{StaticResource Icon.Close}" />
                    </Button>
                </Grid>
            </Border>
            <ContentControl
                Content="{Binding Navigation.Host}"
                Grid.Row="1"
                HorizontalContentAlignment="Stretch"
                Name="PageContent"
                VerticalContentAlignment="Stretch" />
            <Grid
                Grid.Row="1"
                HorizontalAlignment="Left"
                IsVisible="{Binding Navigation.IsLyrics}"
                VerticalAlignment="Top"
                ZIndex="2">
                <Button
                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.ExpandLyricsView}}"
                    Classes="ghost compact"
                    Command="{Binding ToggleLyricsExpandedCommand}"
                    IsVisible="{Binding !IsLyricsExpanded}"
                    Name="ExpandLyricsViewButton"
                    ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.ExpandLyricsView}}">
                    <Path Classes="icon" Data="{StaticResource Icon.Expand}" />
                </Button>
                <Button
                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.RestoreLyricsView}}"
                    Classes="ghost compact"
                    Command="{Binding ToggleLyricsExpandedCommand}"
                    IsVisible="{Binding IsLyricsExpanded}"
                    Name="RestoreLyricsViewButton"
                    ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.RestoreLyricsView}}">
                    <Path Classes="icon" Data="{StaticResource Icon.Restore}" />
                </Button>
            </Grid>
        </Grid>
        <Border
            BoxShadow="0 4 18 0 #34000000"
            Classes.lyricsExpanded="{Binding IsLyricsExpanded}"
            CornerRadius="36"
            Margin="20,0,20,20"
            MaxWidth="860"
            Name="PlaybackBar"
            SizeChanged="OnPlaybackBarSizeChanged"
            VerticalAlignment="Bottom"
            ZIndex="1">
            <Grid>
                <Border
                    BackdropEffectCache="Retained"
                    Background="{DynamicResource Brush.PlaybackSurface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    CornerRadius="36"
                    IsHitTestVisible="False">
                    <Border.BackdropEffect>
                        <BlurEffect Radius="2" />
                    </Border.BackdropEffect>
                    <Grid>
                        <playbackControls:AudioVisualizer
                            Fill="{DynamicResource Brush.Accent}"
                            Height="54"
                            IsPlaying="{Binding Playback.IsPlaying}"
                            IsVisible="{Binding Playback.CanVisualizeAudio}"
                            Margin="28,0,28,2"
                            Opacity="0.25"
                            Source="{Binding Playback}"
                            StripCount="{Binding VisualEffects.AudioVisualizerStripCount}"
                            VerticalAlignment="Bottom" />
                        <sharedControls:LiquidGlassRim CornerRadius="35" />
                    </Grid>
                </Border>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Margin="14,5">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center">
                        <Button
                            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.DesktopLyrics}}"
                            Classes="ghost icon compact"
                            Classes.active="{Binding #DesktopWindow.IsDesktopLyricsOpen}"
                            Click="OnToggleDesktopLyrics"
                            Name="DesktopLyricsButton"
                            ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.DesktopLyrics}}">
                            <Path Classes="icon" Data="{StaticResource Icon.DesktopLyrics}" />
                        </Button>
                        <Button
                            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Previous}}"
                            Classes="ghost icon transport"
                            Command="{Binding Playback.PreviousCommand}"
                            IsEnabled="{Binding Playback.CanPrevious}"
                            ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Previous}}">
                            <Path Classes="icon transport" Data="{StaticResource Icon.Playback.Previous}" />
                        </Button>
                        <Button
                            AutomationProperties.Name="{Binding Playback.PlayLabel}"
                            Classes="ghost icon transport playPause"
                            Command="{Binding Playback.TogglePlaybackCommand}"
                            IsEnabled="{Binding Playback.CanTogglePlayback}"
                            ToolTip.Tip="{Binding Playback.PlayLabel}">
                            <Grid>
                                <Path
                                    Classes="icon transport"
                                    Data="{StaticResource Icon.Playback.Play}"
                                    IsVisible="{Binding !Playback.IsPlaying}" />
                                <Path
                                    Classes="icon transport"
                                    Data="{StaticResource Icon.Playback.Pause}"
                                    IsVisible="{Binding Playback.IsPlaying}" />
                            </Grid>
                        </Button>
                        <Button
                            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Next}}"
                            Classes="ghost icon transport"
                            Command="{Binding Playback.NextCommand}"
                            IsEnabled="{Binding Playback.CanNext}"
                            ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Next}}">
                            <Path Classes="icon transport" Data="{StaticResource Icon.Playback.Next}" />
                        </Button>
                        <Button
                            AutomationProperties.Name="{Binding Playback.ModeLabel}"
                            Classes="ghost icon compact"
                            Command="{Binding Playback.CycleModeCommand}"
                            IsEnabled="{Binding Playback.CanInteract}"
                            ToolTip.Tip="{Binding Playback.ModeLabel}">
                            <Grid>
                                <Path
                                    Classes="icon"
                                    Data="{StaticResource Icon.Sequential}"
                                    IsVisible="{Binding Playback.IsSequential}" />
                                <Path
                                    Classes="icon accent"
                                    Data="{StaticResource Icon.RepeatAll}"
                                    IsVisible="{Binding Playback.IsRepeatAll}" />
                                <Path
                                    Classes="icon accent"
                                    Data="{StaticResource Icon.Shuffle}"
                                    IsVisible="{Binding Playback.IsShuffle}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                    <Grid
                        Classes.seekHover="{Binding #Timeline.IsPointerOver}"
                        Grid.Column="1"
                        Name="NowPlaying"
                        RowDefinitions="50,12">
                        <Grid ClipToBounds="True">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="3,2,3,0" Name="TrackInfo">
                                <Button
                                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Lyrics}}"
                                    Classes="ghost"
                                    Command="{Binding Navigation.NavigateCommand}"
                                    CommandParameter="Lyrics"
                                    CornerRadius="9"
                                    Height="44"
                                    Name="NowPlayingArtworkButton"
                                    Padding="2"
                                    ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Lyrics}}"
                                    Width="44">
                                    <Panel Name="NowPlayingArtwork">
                                        <sharedControls:TransitionArtwork
                                            CornerRadius="7"
                                            Height="40"
                                            ReduceMotion="{Binding Playback.ReduceMotion}"
                                            Source="{Binding Playback.NowArtworkReference}"
                                            Width="40" />
                                        <Border Background="#72000000" CornerRadius="7" Name="ArtworkExpand">
                                            <Path Classes="icon onDark" Data="{StaticResource Icon.Expand}" />
                                        </Border>
                                    </Panel>
                                </Button>
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <DockPanel HorizontalAlignment="Left">
                                        <Button
                                            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSourceDetails}}"
                                            Classes="ghost qualityBadge"
                                            Click="OnToggleSourceDetails"
                                            DockPanel.Dock="Right"
                                            IsEnabled="{Binding Playback.HasSourceDetails}"
                                            IsVisible="{Binding Playback.HasCurrentTrack}"
                                            Margin="6,0,0,0"
                                            Name="CurrentAudioQuality"
                                            ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSourceDetails}}">
                                            <TextBlock FontSize="10" FontWeight="Medium" Text="{Binding Playback.QualityLabel}" />
                                        </Button>
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding Playback.NowTitle}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip.Tip="{Binding Playback.NowTitle}"
                                            VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock
                                        Classes="caption"
                                        Text="{Binding Playback.NowSubtitle}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip.Tip="{Binding Playback.NowSubtitle}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <Grid
                            ColumnDefinitions="*,*"
                            IsHitTestVisible="False"
                            Name="SeekTimes"
                            VerticalAlignment="Bottom">
                            <TextBlock Classes="seekTime" Name="SeekElapsed" Text="0:00" />
                            <TextBlock Classes="seekTime" Grid.Column="1" HorizontalAlignment="Right" Name="SeekRemaining" Text="—" />
                        </Grid>
                        <Slider
                            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Seek}}"
                            Foreground="{DynamicResource Brush.Text}"
                            Grid.Row="1"
                            IsEnabled="{Binding Playback.CanSeek}"
                            IsVisible="{Binding !Playback.IsBusy}"
                            Margin="0,-2,0,-2"
                            Maximum="{Binding Playback.DurationSeconds}"
                            Minimum="0"
                            Name="Timeline"
                            Theme="{StaticResource PlaybackTimeline}"
                            Value="{Binding Playback.PositionSeconds, Mode=OneWay}" />
                        <ProgressBar
                            AutomationProperties.Name="{Binding Playback.Status}"
                            Background="Transparent"
                            Foreground="{DynamicResource Brush.AccentText}"
                            Grid.Row="1"
                            Height="2"
                            IsHitTestVisible="False"
                            IsIndeterminate="True"
                            IsVisible="{Binding Playback.IsBusy}"
                            MinHeight="0"
                            VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                        <Button
                            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.DecoderControls}}"
                            Classes="ghost icon compact"
                            IsEnabled="{Binding SharedContext.IsInitialized}"
                            Name="DecoderButton"
                            ToolTip.Tip="{Binding SharedContext.DecoderControls.DecoderToolTip}">
                            <Grid Height="24" Width="24">
                                <Path Classes="icon" Data="{StaticResource Icon.Decoder}" />
                                <Ellipse
                                    Fill="{DynamicResource Brush.AccentText}"
                                    Height="5"
                                    HorizontalAlignment="Right"
                                    IsVisible="{Binding SharedContext.DecoderControls.UsingScopedProfile}"
                                    VerticalAlignment="Top"
                                    Width="5" />
                            </Grid>
                            <Button.Flyout>
                                <Flyout Placement="Top" VerticalOffset="2">
                                    <ScrollViewer MaxHeight="440" Width="310">
                                        <StackPanel Margin="4" Spacing="12">
                                            <TextBlock Classes="section" Text="{Translate {x:Static i18n:LanguageManager+Keys.DecoderControls}}" />
                                            <playbackViews:AudioOutputView
                                                DataContext="{Binding SharedContext.DecoderControls.QuickOutput}"
                                                IsVisible="{Binding DataContext, RelativeSource={RelativeSource Self}, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                ShowAdvanced="False" />
                                            <TextBlock
                                                Classes="caption"
                                                IsVisible="{Binding SharedContext.DecoderControls.QuickOutput, Converter={x:Static ObjectConverters.IsNull}}"
                                                Text="{Translate {x:Static i18n:LanguageManager+Keys.DecoderDefaultOutput}}" />
                                            <playbackViews:DecodeProfileView DataContext="{Binding SharedContext.DecoderControls.QuickProfile}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button
                            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Queue}}"
                            Classes="ghost icon compact"
                            Classes.active="{Binding IsQueueOpen}"
                            Command="{Binding ToggleQueueCommand}"
                            Name="QueueButton"
                            ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Queue}}">
                            <Path Classes="icon" Data="{StaticResource Icon.Queue}" />
                        </Button>
                        <Button
                            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Volume}}"
                            Classes="ghost icon compact"
                            Click="OnToggleVolume"
                            IsEnabled="{Binding Playback.CanAdjustVolume}"
                            Name="VolumeButton"
                            ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Volume}}">
                            <Grid>
                                <Path
                                    Classes="icon"
                                    Data="{StaticResource Icon.Volume}"
                                    IsVisible="{Binding !Playback.IsMuted}" />
                                <Path
                                    Classes="icon"
                                    Data="{StaticResource Icon.VolumeMuted}"
                                    IsVisible="{Binding Playback.IsMuted}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <Grid
            Classes.lyricsExpanded="{Binding IsLyricsExpanded}"
            IsHitTestVisible="False"
            Margin="20,0,20,0"
            MaxWidth="1020"
            Name="PlaybackNotifications"
            VerticalAlignment="Bottom"
            ZIndex="2">
            <Grid Margin="{DynamicResource Space.PlaybackInset}">
                <sharedControls:NotificationHost
                    HorizontalAlignment="Left"
                    Margin="12,0,0,0"
                    Name="MainNotifications"
                    Source="{Binding SharedContext.Notifications}" />
            </Grid>
        </Grid>
        <Popup
            Closed="OnSourceDetailsClosed"
            IsLightDismissEnabled="True"
            IsOpen="{Binding Playback.IsSourceDetailsOpen, Mode=TwoWay}"
            Name="SourceDetailsPopup"
            Opened="OnSourceDetailsOpened"
            OverlayDismissEventPassThrough="False"
            Placement="Top"
            PlacementTarget="CurrentAudioQuality"
            VerticalOffset="2">
            <Border
                Classes="popupCard"
                Focusable="True"
                KeyDown="OnSourceDetailsKeyDown"
                Name="SourceDetailsCard"
                Padding="20"
                Width="420">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" MaxHeight="440">
                    <StackPanel Spacing="16">
                        <TextBlock FontWeight="SemiBold" Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSourceDetails}}" />
                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="16"
                            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                            RowSpacing="8">
                            <TextBlock Classes="caption" Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSourceType}}" />
                            <SelectableTextBlock
                                Grid.Column="1"
                                Text="{Binding Playback.SourceType}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Classes="caption"
                                Grid.Row="1"
                                Text="{Translate {x:Static i18n:LanguageManager+Keys.ProviderId}}" />
                            <SelectableTextBlock
                                Grid.Column="1"
                                Grid.Row="1"
                                Text="{Binding Playback.SourceProvider}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Classes="caption"
                                Grid.Row="2"
                                Text="{Translate {x:Static i18n:LanguageManager+Keys.Namespace}}" />
                            <SelectableTextBlock
                                Grid.Column="1"
                                Grid.Row="2"
                                Text="{Binding Playback.SourceNamespace}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Classes="caption"
                                Grid.Row="3"
                                Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSourceKind}}" />
                            <SelectableTextBlock
                                Grid.Column="1"
                                Grid.Row="3"
                                Text="{Binding Playback.SourceKind}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Classes="caption"
                                Grid.Row="4"
                                Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSourceId}}" />
                            <SelectableTextBlock
                                Grid.Column="1"
                                Grid.Row="4"
                                Text="{Binding Playback.SourceId}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Classes="caption"
                                Grid.Row="5"
                                Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSourceQuality}}" />
                            <SelectableTextBlock
                                Grid.Column="1"
                                Grid.Row="5"
                                Text="{Binding Playback.QualityLabel}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Classes="caption"
                                Grid.Row="6"
                                Text="{Binding Playback.BitrateOrigin}" />
                            <SelectableTextBlock
                                Grid.Column="1"
                                Grid.Row="6"
                                Text="{Binding Playback.SourceBitrate}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Classes="caption"
                                Grid.Row="7"
                                Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSourcePlayer}}" />
                            <SelectableTextBlock
                                Grid.Column="1"
                                Grid.Row="7"
                                Text="{Binding Playback.SourcePlayer}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Classes="caption"
                                Grid.Row="8"
                                Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackCodec}}" />
                            <SelectableTextBlock
                                Grid.Column="1"
                                Grid.Row="8"
                                Text="{Binding Playback.SourceCodec}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Classes="caption"
                                Grid.Row="9"
                                Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSampleRate}}" />
                            <SelectableTextBlock
                                Grid.Column="1"
                                Grid.Row="9"
                                Text="{Binding Playback.SourceSampleRate}" />
                            <TextBlock
                                Classes="caption"
                                Grid.Row="10"
                                Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackBitDepth}}" />
                            <SelectableTextBlock
                                Grid.Column="1"
                                Grid.Row="10"
                                Text="{Binding Playback.SourceBitDepth}" />
                            <TextBlock
                                Classes="caption"
                                Grid.Row="11"
                                Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackChannels}}" />
                            <SelectableTextBlock
                                Grid.Column="1"
                                Grid.Row="11"
                                Text="{Binding Playback.SourceChannels}" />
                        </Grid>
                        <StackPanel Spacing="6">
                            <TextBlock Classes="caption" Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSourceLocation}}" />
                            <SelectableTextBlock
                                FontSize="12"
                                Name="PlaybackSourceLocation"
                                Text="{Binding Playback.SourceLocation}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
        <Popup
            Closed="OnVolumeClosed"
            IsLightDismissEnabled="True"
            Name="VolumePopup"
            Opened="OnVolumeOpened"
            OverlayDismissEventPassThrough="False"
            Placement="Top"
            PlacementTarget="VolumeButton"
            VerticalOffset="2">
            <Border
                Classes="popupCard"
                KeyDown="OnVolumeKeyDown"
                Padding="16"
                Width="220">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Volume}}" />
                        <TextBlock
                            Classes="caption"
                            Grid.Column="1"
                            Text="{Binding Playback.VolumeLabel}" />
                    </Grid>
                    <Slider
                        AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Volume}}"
                        IsEnabled="{Binding Playback.CanAdjustVolume}"
                        LargeChange="10"
                        Maximum="100"
                        Minimum="0"
                        Name="VolumeSlider"
                        SmallChange="1"
                        Value="{Binding Playback.VolumePercent, Mode=TwoWay}" />
                </StackPanel>
            </Border>
        </Popup>
        <Popup
            Closed="OnQueueClosed"
            IsLightDismissEnabled="True"
            IsOpen="{Binding IsQueueOpen, Mode=TwoWay}"
            Name="QueuePopup"
            Opened="OnQueueOpened"
            OverlayDismissEventPassThrough="False"
            Placement="AnchorAndGravity"
            PlacementAnchor="TopRight"
            PlacementConstraintAdjustment="None"
            PlacementGravity="BottomLeft"
            PlacementTarget="ShellRoot"
            ShouldUseOverlayLayer="True">
            <Border
                Background="Transparent"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1,0,0,0"
                BoxShadow="-2 0 8 0 #40000000"
                CornerRadius="16,0,0,16"
                Focusable="True"
                Height="{Binding #ShellRoot.Bounds.Height}"
                KeyDown="OnQueueKeyDown"
                Name="QueueCard"
                Width="380">
                <Grid>
                    <Border
                        BackdropEffectCache="Retained"
                        Background="{DynamicResource Brush.PlaybackSurface}"
                        ClipToBounds="True"
                        CornerRadius="16,0,0,16"
                        IsHitTestVisible="False">
                        <Border.BackdropEffect>
                            <BlurEffect Radius="12" />
                        </Border.BackdropEffect>
                        <sharedControls:LiquidGlassRim CornerRadius="16,0,0,16" />
                    </Border>
                    <ContentControl
                        Content="{Binding QueueDrawer}"
                        HorizontalContentAlignment="Stretch"
                        Padding="20,24,20,16"
                        VerticalContentAlignment="Stretch">
                        <ContentControl.DataTemplates>
                            <DataTemplate DataType="{x:Type playbackVm:PlaybackQueueViewModel}">
                                <playbackViews:QueueDrawerView />
                            </DataTemplate>
                        </ContentControl.DataTemplates>
                    </ContentControl>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
