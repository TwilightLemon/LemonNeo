<Window
  x:Class="LemonNeo.Desktop.Views.Shell.MainWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:sharedControls="using:LemonNeo.Desktop.Controls.Shared"
  xmlns:i18n="using:LemonNeo.Desktop.Services"
  xmlns:playbackViews="using:LemonNeo.Desktop.Views.Playback"
  xmlns:playbackVm="using:LemonNeo.Desktop.ViewModels.Playback"
  xmlns:shellVm="using:LemonNeo.Desktop.ViewModels.Shell"
  Name="DesktopWindow"
  Title="Lemon Neo"
  Icon="/Resources/Icons/App.ico"
  Width="1180"
  Height="790"
  MinWidth="880"
  MinHeight="620"
  x:DataType="shellVm:MainViewModel"
  Background="Transparent"
  ExtendClientAreaTitleBarHeightHint="56"
  TransparencyBackgroundFallback="{DynamicResource Brush.Sidebar}"
  TransparencyLevelHint="AcrylicBlur, Blur, None"
  WindowDecorations="Full"
  WindowDecorationsTheme="{StaticResource LemonWindowDecorations}"
  WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Thickness x:Key="Space.PlaybackInset">0,0,0,132</Thickness>
    <Thickness x:Key="Space.PlaybackFooterInset">0,12,0,132</Thickness>
    <Thickness x:Key="Space.PlaybackFloatingInset">0,0,16,132</Thickness>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Border#TopBar">
      <Setter Property="Padding" Value="24,10" />
    </Style>
    <Style Selector="Border#Sidebar">
      <Setter Property="Padding" Value="16,20,16,12" />
    </Style>
    <Style Selector="Border#TopBar.windows">
      <Setter Property="Padding" Value="24,10,164,10" />
    </Style>
    <Style Selector="Border#Sidebar.macos">
      <Setter Property="Padding" Value="16,32,16,12" />
    </Style>
    <Style Selector="ContentControl#PageContent ListBox:not(.serviceTabs):not(.playlistPicker) /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="Margin" Value="{DynamicResource Space.PlaybackInset}" />
    </Style>
    <Style Selector="ContentControl#PageContent ScrollViewer:not(#PART_ScrollViewer):not(#LyricsScrollViewer)">
      <Setter Property="Padding" Value="{DynamicResource Space.PlaybackInset}" />
    </Style>
  </Window.Styles>
  <Grid
    Name="ShellRoot"
    ClipToBounds="True"
    ColumnDefinitions="230,*"
    RowDefinitions="56,*">
    <Border
      Name="ContentBackground"
      Grid.RowSpan="2"
      Grid.Column="1"
      Background="{DynamicResource Brush.Canvas}"
      IsHitTestVisible="False" />
    <Border
      Name="Sidebar"
      Grid.RowSpan="2"
      Background="{DynamicResource Brush.SidebarTranslucent}">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel
          Margin="12,0,0,16"
          Orientation="Horizontal"
          Spacing="10">
          <Viewbox
            Width="34"
            Height="34"
            VerticalAlignment="Center">
            <Grid Width="56" Height="56">
              <Border Background="{DynamicResource Brush.Accent}" CornerRadius="20" />
              <Path
                Width="56"
                Height="56"
                Stretch="None"
                Data="{StaticResource Icon.AppMusic}"
                Fill="{DynamicResource Brush.OnAccent}" />
            </Grid>
          </Viewbox>
          <TextBlock
            VerticalAlignment="Center"
            FontSize="23"
            FontWeight="SemiBold"
            Text="{Translate {x:Static i18n:LanguageManager+Keys.AppName}}" />
        </StackPanel>
        <StackPanel
          Grid.Row="1"
          Margin="0,0,0,12"
          Spacing="4">
          <StackPanel.Styles>
            <Style Selector="TextBlock">
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
          </StackPanel.Styles>
          <Button
            Classes="nav"
            Classes.active="{Binding Navigation.IsLibrary}"
            Command="{Binding Navigation.NavigateCommand}"
            CommandParameter="Library">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Classes="icon" Data="{StaticResource Icon.Library}" />
              <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Library}}" />
            </StackPanel>
          </Button>
          <Button
            Classes="nav"
            Classes.active="{Binding Navigation.IsSearch}"
            Command="{Binding Navigation.NavigateCommand}"
            CommandParameter="Search">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Classes="icon" Data="{StaticResource Icon.Search}" />
              <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Search}}" />
            </StackPanel>
          </Button>
          <Button
            Name="AccountsNavigationButton"
            Classes="nav"
            Classes.active="{Binding Navigation.IsAccounts}"
            Command="{Binding Navigation.NavigateCommand}"
            CommandParameter="Accounts">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Classes="icon" Data="{StaticResource Icon.Account}" />
              <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Accounts}}" />
            </StackPanel>
          </Button>
          <Button
            Classes="nav"
            Classes.active="{Binding Navigation.IsOnline}"
            Command="{Binding Navigation.NavigateCommand}"
            CommandParameter="Online">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Classes="icon" Data="{StaticResource Icon.Folder}" />
              <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Online}}" />
            </StackPanel>
          </Button>
        </StackPanel>
        <Grid Grid.Row="2" RowDefinitions="Auto,*">
          <Grid Margin="16,0,8,4" ColumnDefinitions="*,Auto">
            <TextBlock
              VerticalAlignment="Center"
              Classes="caption"
              Text="{Translate {x:Static i18n:LanguageManager+Keys.Playlists}}" />
            <Button
              Grid.Column="1"
              AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.CreatePlaylist}}"
              Classes="ghost icon"
              Click="OnCreatePlaylist"
              IsEnabled="{Binding SharedContext.IsInitialized}"
              ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.CreatePlaylist}}">
              <Path Classes="icon" Data="{StaticResource Icon.Add}"
                    Stretch="Fill" Width="14" Height="14" />
            </Button>
          </Grid>
          <ListBox
            Name="PlaylistList"
            Grid.Row="1"
            IsEnabled="{Binding SharedContext.IsInitialized}"
            ItemsSource="{Binding Playlists}"
            SelectedItem="{Binding SelectedPlaylist}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="shellVm:PlaylistMenuItemViewModel">
                <Grid ColumnDefinitions="*,Auto">

                  <TextBlock
                    VerticalAlignment="Center"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
                  <TextBlock
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Classes="caption"
                    Text="{Binding TrackCount}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
        <StackPanel
          Grid.Row="3"
          Margin="0,8,0,0"
          Spacing="4">
          <StackPanel.Styles>
            <Style Selector="TextBlock">
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
          </StackPanel.Styles>
          <Button
            Classes="nav"
            Classes.active="{Binding Navigation.IsTools}"
            Command="{Binding Navigation.NavigateCommand}"
            CommandParameter="Tools">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Classes="icon" Data="{StaticResource Icon.Queue}" />
              <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Tools}}" />
            </StackPanel>
          </Button>
          <Button
            Classes="nav"
            Classes.active="{Binding Navigation.IsSettings}"
            Command="{Binding Navigation.NavigateCommand}"
            CommandParameter="Settings">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Classes="icon" Data="{StaticResource Icon.Settings}" />
              <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Settings}}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Border
      Name="MacCaptionDragArea"
      Background="Transparent"
      IsVisible="False"
      WindowDecorationProperties.ElementRole="TitleBar" />
    <Border
      Name="TopBar"
      Grid.Column="1"
      BorderBrush="{DynamicResource Brush.Border}"
      BorderThickness="0,0,0,0"
      WindowDecorationProperties.ElementRole="TitleBar">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="5*" MaxWidth="448" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel
          VerticalAlignment="Center"
          Orientation="Horizontal"
          Spacing="12"
          WindowDecorationProperties.ElementRole="User">
          <Button
            Name="BackButton"
            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Back}}"
            Classes="ghost compact"
            Command="{Binding Navigation.BackCommand}"
            ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Back}}">
            <Path Classes="icon" Data="{StaticResource Icon.Back}" />
          </Button>
          <Button
            Name="ForwardButton"
            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Forward}}"
            Classes="ghost compact"
            Command="{Binding Navigation.ForwardCommand}"
            ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Forward}}">
            <Path Classes="icon" Data="{StaticResource Icon.Forward}" />
          </Button>
        </StackPanel>
        <Grid
          Name="SearchArea"
          Grid.Column="1"
          Margin="16,0,12,0"
          VerticalAlignment="Center"
          ColumnDefinitions="*,Auto"
          WindowDecorationProperties.ElementRole="User">
          <TextBox
            Name="GlobalSearch"
            VerticalContentAlignment="Center"
            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.SearchMusic}}"
            Classes="toolbarSearch"
            IsEnabled="{Binding SharedContext.IsInitialized}"
            KeyDown="OnSearchKeyDown"
            PlaceholderText="{Translate {x:Static i18n:LanguageManager+Keys.SearchMusic}}"
            Text="{Binding SearchQuery}" />
          <Button
            Grid.Column="1"
            Margin="4,0,0,0"
            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.SearchMusic}}"
            Classes="ghost compact"
            Command="{Binding SearchCommand}"
            ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.SearchMusic}}">
            <Path Classes="icon" Data="{StaticResource Icon.Search}" />
          </Button>
        </Grid>
        <ProgressBar
          Grid.Column="3"
          Width="40"
          Height="3"
          VerticalAlignment="Center"
          AutomationProperties.Name="{Binding Status}"
          IsHitTestVisible="False"
          IsIndeterminate="True"
          IsVisible="{Binding IsBusy}" />
      </Grid>
    </Border>
    <Grid
      Name="PageArea"
      Grid.Row="1"
      Grid.Column="1"
      Margin="32,20,32,0"
      RowDefinitions="Auto,*">
      <Border
        Margin="0,0,0,12"
        Padding="14"
        Background="{DynamicResource Brush.DangerSoft}"
        CornerRadius="10"
        IsVisible="{Binding HasError}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock
            MaxHeight="90"
            Foreground="{DynamicResource Brush.Danger}"
            Text="{Binding Error}"
            TextWrapping="Wrap" />
          <Button
            Grid.Column="1"
            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.DismissError}}"
            Classes="ghost icon"
            Command="{Binding DismissErrorCommand}">
            <Path Classes="icon" Data="{StaticResource Icon.Close}" />
          </Button>
        </Grid>
      </Border>
      <ContentControl
        Name="PageContent"
        Grid.Row="1"
        SizeChanged="OnPageContentSizeChanged"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        Content="{Binding Navigation.Host}">
        <ContentControl.OpacityMask>
          <LinearGradientBrush StartPoint="0%,90%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="White" />
            <GradientStop Offset="1" Color="Transparent" />
          </LinearGradientBrush>
        </ContentControl.OpacityMask>
      </ContentControl>
    </Grid>
    <Border
      Name="PlaybackBar"
      Grid.Row="1"
      Grid.Column="1"
      ZIndex="1"
      MinHeight="100"
      Margin="20,0,20,20"
      VerticalAlignment="Bottom"
      Background="Transparent"
      BorderBrush="{DynamicResource Brush.Border}"
      BorderThickness="1"
      BoxShadow="0 8 28 0 #24000000"
      CornerRadius="20"
      SizeChanged="OnPlaybackBarSizeChanged">
      <Grid>
        <sharedControls:FrostedGlass
          Background="{DynamicResource Brush.PlaybackSurface}"
          CornerRadius="20"
          IsHitTestVisible="False" />
        <Grid Margin="16,24,16,16" RowDefinitions="Auto,*">
          <Grid
            Margin="0,0,0,4"
            ColumnDefinitions="*,Auto"
            IsVisible="{Binding Playback.HasError}">
            <TextBlock
              Foreground="{DynamicResource Brush.Danger}"
              Text="{Binding Playback.Error}"
              TextTrimming="CharacterEllipsis"
              ToolTip.Tip="{Binding Playback.Error}" />
            <Button
              Grid.Column="1"
              Height="20"
              MinHeight="20"
              Padding="4,0"
              AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.DismissError}}"
              Classes="ghost compact"
              Command="{Binding Playback.DismissErrorCommand}">
              <Path Classes="icon" Data="{StaticResource Icon.Close}" Width="12" Height="12" />
            </Button>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*">
            <Button
              Name="NowPlayingButton"
              Margin="0,0,76,0"
              Padding="8,0"
              HorizontalContentAlignment="Stretch"
              AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Lyrics}}"
              Classes="ghost"
              Command="{Binding Navigation.NavigateCommand}"
              CommandParameter="Lyrics"
              CornerRadius="12"
              ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Lyrics}}">
              <Grid ColumnDefinitions="48,*">
                <sharedControls:Artwork
                  Width="48"
                  Height="48"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="{Binding Playback.NowTitle}"
                  CornerRadius="10"
                  Source="{Binding Playback.NowArtwork}" />
                <StackPanel
                  Grid.Column="1"
                  Margin="12,0,0,0"
                  VerticalAlignment="Center"
                  Spacing="4">
                  <TextBlock
                    FontWeight="SemiBold"
                    Text="{Binding Playback.NowTitle}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip.Tip="{Binding Playback.NowTitle}" />
                  <TextBlock
                    Classes="caption"
                    Text="{Binding Playback.NowArtist}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip.Tip="{Binding Playback.NowArtist}" />
                </StackPanel>
              </Grid>
            </Button>
            <Button
              Name="DesktopLyricsButton"
              Margin="0,0,16,0"
              Padding="0"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.DesktopLyrics}}"
              Classes="ghost icon"
              Classes.active="{Binding #DesktopWindow.IsDesktopLyricsOpen}"
              Click="OnToggleDesktopLyrics"
              ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.DesktopLyrics}}">
              <Path Classes="icon" Data="{StaticResource Icon.DesktopLyrics}" />
            </Button>
            <StackPanel
              Name="PlaybackControls"
              Grid.Column="1"
              VerticalAlignment="Center"
              Orientation="Horizontal"
              Spacing="12">
              <Button
                Name="PreviousButton"
                Padding="0"
                AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Previous}}"
                Classes="ghost icon"
                Command="{Binding Playback.PreviousCommand}"
                IsEnabled="{Binding Playback.CanPrevious}"
                ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Previous}}">
                <Viewbox
                  Height="20"
                  MaxWidth="22"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                  <Path
                    Data="{StaticResource Icon.Playback.Previous}"
                    Fill="{DynamicResource Brush.Text}"
                    Stretch="Uniform" />
                </Viewbox>
              </Button>
              <Button
                Name="PlayPauseButton"
                Width="48"
                Height="48"
                Padding="0"
                AutomationProperties.Name="{Binding Playback.PlayLabel}"
                Classes="primary"
                Command="{Binding Playback.TogglePlaybackCommand}"
                CornerRadius="24"
                IsEnabled="{Binding Playback.CanTogglePlayback}"
                ToolTip.Tip="{Binding Playback.PlayLabel}">
                <Grid>
                  <Viewbox
                    Height="20"
                    MaxWidth="22"
                    Margin="4,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding !Playback.IsPlaying}">
                    <Path
                      Data="{StaticResource Icon.Playback.Play}"
                      Fill="{DynamicResource Brush.OnAccent}"
                      Stretch="Uniform" />
                  </Viewbox>
                  <Viewbox
                    Height="20"
                    MaxWidth="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding Playback.IsPlaying}">
                    <Path
                      Data="{StaticResource Icon.Playback.Pause}"
                      Fill="{DynamicResource Brush.OnAccent}"
                      Stretch="Uniform" />
                  </Viewbox>
                </Grid>
              </Button>
              <Button
                Name="NextButton"
                Padding="0"
                AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Next}}"
                Classes="ghost icon"
                Command="{Binding Playback.NextCommand}"
                IsEnabled="{Binding Playback.CanNext}"
                ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Next}}">
                <Viewbox
                  Height="20"
                  MaxWidth="22"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                  <Path
                    Data="{StaticResource Icon.Playback.Next}"
                    Fill="{DynamicResource Brush.Text}"
                    Stretch="Uniform" />
                </Viewbox>
              </Button>
            </StackPanel>
            <Grid
              Grid.Column="2"
              Margin="16,0,0,0"
              ColumnDefinitions="Auto,*">
              <Button
                Name="PlaybackModeButton"
                Padding="0"
                VerticalAlignment="Center"
                AutomationProperties.Name="{Binding Playback.ModeLabel}"
                Classes="ghost icon"
                Command="{Binding Playback.CycleModeCommand}"
                IsEnabled="{Binding Playback.CanInteract}"
                ToolTip.Tip="{Binding Playback.ModeLabel}">
                <Grid>
                  <Viewbox
                    Height="18"
                    MaxWidth="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding Playback.IsSequential}">
                    <Path
                      Data="{StaticResource Icon.Playback.Sequential}"
                      Fill="{DynamicResource Brush.TextSecondary}"
                      Stretch="Uniform" />
                  </Viewbox>
                  <Viewbox
                    Height="18"
                    MaxWidth="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding Playback.IsRepeatAll}">
                    <Path
                      Data="{StaticResource Icon.Playback.RepeatAll}"
                      Fill="{DynamicResource Brush.TextSecondary}"
                      Stretch="Uniform" />
                  </Viewbox>
                  <Viewbox
                    Height="18"
                    MaxWidth="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding Playback.IsShuffle}">
                    <Path
                      Data="{StaticResource Icon.Playback.Shuffle}"
                      Fill="{DynamicResource Brush.TextSecondary}"
                      Stretch="Uniform" />
                  </Viewbox>
                </Grid>
              </Button>
              <Grid
                Grid.Column="1"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                ColumnDefinitions="*,Auto,Auto">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                  <Button Name="CurrentAudioQuality" Classes="ghost" Padding="6,2"
                          Click="OnToggleSourceDetails" IsEnabled="{Binding Playback.HasSourceDetails}"
                          AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSourceDetails}}"
                          ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSourceDetails}}">
                    <TextBlock Classes="caption" Text="{Binding Playback.QualityLabel}"/>
                  </Button>
                  <TextBlock Classes="caption" Text="{Binding Playback.TimeLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button
                  Name="VolumeButton"
                  Grid.Column="1"
                  Margin="8,0,0,0"
                  Padding="0"
                  AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Volume}}"
                  Classes="ghost icon"
                  Click="OnToggleVolume"
                  IsEnabled="{Binding Playback.CanAdjustVolume}"
                  ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Volume}}">
                  <Grid>
                    <Viewbox Height="18" MaxWidth="20" IsVisible="{Binding !Playback.IsMuted}">
                      <Path Data="{StaticResource Icon.Volume}" Fill="{DynamicResource Brush.TextSecondary}" Stretch="Uniform" />
                    </Viewbox>
                    <Viewbox Height="18" MaxWidth="20" IsVisible="{Binding Playback.IsMuted}">
                      <Path Data="{StaticResource Icon.VolumeMuted}" Fill="{DynamicResource Brush.TextSecondary}" Stretch="Uniform" />
                    </Viewbox>
                  </Grid>
                </Button>
                <Button
                  Name="QueueButton"
                  Grid.Column="2"
                  Margin="8,0,0,0"
                  Padding="0"
                  AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Queue}}"
                  Classes="ghost icon"
                  Command="{Binding ToggleQueueCommand}"
                  ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Queue}}">
                  <Viewbox
                    Height="18"
                    MaxWidth="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Path
                      Data="{StaticResource Icon.Playback.Queue}"
                      Fill="{DynamicResource Brush.TextSecondary}"
                      Stretch="Uniform" />
                  </Viewbox>
                </Button>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
        <Slider
          Name="Timeline"
          Margin="20,2,20,0"
          VerticalAlignment="Top"
          AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Seek}}"
          IsEnabled="{Binding Playback.CanSeek}"
          IsVisible="{Binding !Playback.IsBusy}"
          Maximum="{Binding Playback.DurationSeconds}"
          Minimum="0"
          Theme="{StaticResource PlaybackTimeline}"
          Value="{Binding Playback.PositionSeconds, Mode=OneWay}" />
        <ProgressBar
          Name="PlaybackLoading"
          Height="2"
          MinHeight="0"
          Margin="20,10,20,0"
          VerticalAlignment="Top"
          AutomationProperties.Name="{Binding Playback.Status}"
          Background="Transparent"
          Foreground="{DynamicResource Brush.AccentText}"
          IsHitTestVisible="False"
          IsIndeterminate="True"
          IsVisible="{Binding Playback.IsBusy}" />
      </Grid>
    </Border>
    <Popup Name="SourceDetailsPopup"
           IsOpen="{Binding Playback.IsSourceDetailsOpen, Mode=TwoWay}"
           Opened="OnSourceDetailsOpened" Closed="OnSourceDetailsClosed"
           IsLightDismissEnabled="True" OverlayDismissEventPassThrough="False"
           Placement="TopEdgeAlignedRight" PlacementTarget="CurrentAudioQuality"
           VerticalOffset="-8" ShouldUseOverlayLayer="True">
      <Border Name="SourceDetailsCard" Width="420" Padding="20"
              Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}"
              BorderThickness="1" CornerRadius="16" BoxShadow="0 4 20 0 #26000000"
              Focusable="True" KeyDown="OnSourceDetailsKeyDown">
        <ScrollViewer MaxHeight="440" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="16">
            <TextBlock FontWeight="SemiBold" Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSourceDetails}}" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="16">
              <TextBlock Classes="caption" Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSourceType}}" />
              <SelectableTextBlock Grid.Column="1" Text="{Binding Playback.SourceType}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" Classes="caption" Text="{Translate {x:Static i18n:LanguageManager+Keys.ProviderId}}" />
              <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Playback.SourceProvider}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="2" Classes="caption" Text="{Translate {x:Static i18n:LanguageManager+Keys.Namespace}}" />
              <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Playback.SourceNamespace}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="3" Classes="caption" Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSourceKind}}" />
              <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Playback.SourceKind}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="4" Classes="caption" Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSourceId}}" />
              <SelectableTextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Playback.SourceId}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="5" Classes="caption" Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSourceQuality}}" />
              <SelectableTextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Playback.QualityLabel}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="6" Classes="caption" Text="{Binding Playback.BitrateOrigin}" />
              <SelectableTextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Playback.SourceBitrate}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="7" Classes="caption" Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSourcePlayer}}" />
              <SelectableTextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Playback.SourcePlayer}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="8" Classes="caption" Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackCodec}}" />
              <SelectableTextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Playback.SourceCodec}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="9" Classes="caption" Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSampleRate}}" />
              <SelectableTextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Playback.SourceSampleRate}" />
              <TextBlock Grid.Row="10" Classes="caption" Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackBitDepth}}" />
              <SelectableTextBlock Grid.Row="10" Grid.Column="1" Text="{Binding Playback.SourceBitDepth}" />
              <TextBlock Grid.Row="11" Classes="caption" Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackChannels}}" />
              <SelectableTextBlock Grid.Row="11" Grid.Column="1" Text="{Binding Playback.SourceChannels}" />
            </Grid>
            <StackPanel Spacing="6">
              <TextBlock Classes="caption" Text="{Translate {x:Static i18n:LanguageManager+Keys.PlaybackSourceLocation}}" />
              <SelectableTextBlock Name="PlaybackSourceLocation" Text="{Binding Playback.SourceLocation}" TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Popup>
    <Popup
      Name="VolumePopup"
      Closed="OnVolumeClosed"
      Opened="OnVolumeOpened"
      IsLightDismissEnabled="True"
      OverlayDismissEventPassThrough="False"
      Placement="TopEdgeAlignedRight"
      PlacementTarget="VolumeButton"
      VerticalOffset="-8"
      ShouldUseOverlayLayer="True">
      <Border
        Width="220"
        Padding="16"
        Background="{DynamicResource Brush.SurfaceRaised}"
        BorderBrush="{DynamicResource Brush.Border}"
        BorderThickness="1"
        CornerRadius="16"
        BoxShadow="0 4 20 0 #26000000"
        KeyDown="OnVolumeKeyDown">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.Volume}}" />
            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Playback.VolumeLabel}" />
          </Grid>
          <Slider
            Name="VolumeSlider"
            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Volume}}"
            Minimum="0"
            Maximum="100"
            SmallChange="1"
            LargeChange="10"
            IsEnabled="{Binding Playback.CanAdjustVolume}"
            Value="{Binding Playback.VolumePercent, Mode=TwoWay}" />
        </StackPanel>
      </Border>
    </Popup>
    <Popup
      Name="QueuePopup"
      Closed="OnQueueClosed"
      IsLightDismissEnabled="True"
      IsOpen="{Binding IsQueueOpen, Mode=TwoWay}"
      Opened="OnQueueOpened"
      OverlayDismissEventPassThrough="False"
      Placement="AnchorAndGravity"
      PlacementAnchor="TopRight"
      PlacementConstraintAdjustment="None"
      PlacementGravity="BottomLeft"
      PlacementTarget="ShellRoot"
      ShouldUseOverlayLayer="True">
      <Border
        Name="QueueCard"
        Width="380"
        Height="{Binding #ShellRoot.Bounds.Height}"
        Background="Transparent"
        BorderBrush="{DynamicResource Brush.Border}"
        BorderThickness="1,0,0,0"
        CornerRadius="16,0,0,16"
        Focusable="True"
        KeyDown="OnQueueKeyDown">
        <Grid>
          <sharedControls:FrostedGlass
          Background="{DynamicResource Brush.PlaybackSurface}"
          CornerRadius="16"
          IsHitTestVisible="False" />
          <ContentControl
            Padding="20,24,20,16"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Content="{Binding QueueDrawer}">
            <ContentControl.DataTemplates>
              <DataTemplate DataType="{x:Type playbackVm:PlaybackQueueViewModel}">
                <playbackViews:QueueDrawerView />
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>
        </Grid>
      </Border>
    </Popup>
  </Grid>
</Window>
