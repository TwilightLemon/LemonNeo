<UserControl
    x:Class="LemonNeo.Desktop.Views.Lyrics.LyricsView"
    x:DataType="lyricsVm:LyricsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:i18n="using:LemonNeo.Desktop.Services"
    xmlns:lyricsControls="using:LemonNeo.Desktop.Controls.Lyrics"
    xmlns:lyricsVm="using:LemonNeo.Desktop.ViewModels.Lyrics"
    xmlns:sharedControls="using:LemonNeo.Desktop.Controls.Shared"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <!-- Additive highlight: the colour the header adds to the artwork behind it, so the
             RGB value is what shows over a dark cover rather than an alpha composited grey. -->
        <Style Selector="TextBlock.additiveTitle">
            <Setter Property="Foreground" Value="#AEAEAE" />
        </Style>
        <Style Selector="TextBlock.additiveArtist">
            <Setter Property="Foreground" Value="#999999" />
        </Style>
    </UserControl.Styles>
    <Grid ClipToBounds="True" RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="44,*,44" Margin="0,0,0,18">
            <StackPanel
                Grid.Column="1"
                Spacing="6"
                VerticalAlignment="Center">
                <sharedControls:AdditiveTextBlock
                    Classes="additiveTitle"
                    FontSize="22"
                    FontWeight="Bold"
                    IsHighlightEnabled="True"
                    Text="{Binding Playback.NowTitle}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
                <sharedControls:AdditiveTextBlock
                    Classes="additiveArtist"
                    IsHighlightEnabled="True"
                    Text="{Binding Playback.NowArtist}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
                <!--<TextBlock
                    Classes="caption"
                    IsVisible="{Binding Playback.HasSourceDetails}"
                    Text="{Binding Playback.AudioFormatLabel}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />-->
            </StackPanel>
            <Button
                AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.LyricsDisplaySettings}}"
                Classes="ghost icon"
                Grid.Column="2"
                Name="LyricsSettingsButton"
                ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.LyricsDisplaySettings}}"
                VerticalAlignment="Top">
                <Path Classes="icon" Data="{StaticResource Icon.Settings}" />
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel
                            Margin="8"
                            Spacing="18"
                            Width="260">
                            <StackPanel.Styles>
                                <Style Selector="Button.lyricAlignment">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                </Style>
                                <Style Selector="Button.lyricAlignment:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                                </Style>
                                <Style Selector="Button.lyricAlignment.active, Button.lyricAlignment.active:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </StackPanel.Styles>
                            <TextBlock Classes="section" Text="{Translate {x:Static i18n:LanguageManager+Keys.LyricsDisplaySettings}}" />
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.LyricsFontFamilies}}" />
                                <sharedControls:FontFamilyPicker
                                    Name="LyricsFontPicker"
                                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.LyricsFontFamilies}}"
                                    PlaceholderText="{Translate {x:Static i18n:LanguageManager+Keys.FontFamiliesHint}}"
                                    SelectedFamilies="{Binding LyricFontFamilies, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.LyricsFontSize}}" />
                                    <TextBlock
                                        Classes="muted"
                                        Grid.Column="1"
                                        Text="{Binding LyricFontSize, StringFormat={}{0:0}}" />
                                </Grid>
                                <Slider
                                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.LyricsFontSize}}"
                                    IsSnapToTickEnabled="True"
                                    Maximum="100"
                                    Minimum="16"
                                    Name="LyricsFontSizeSlider"
                                    TickFrequency="1"
                                    Value="{Binding LyricFontSize, Mode=TwoWay}" />
                            </StackPanel>
                            <ToggleSwitch
                                Content="{Translate {x:Static i18n:LanguageManager+Keys.BoldLyrics}}"
                                IsChecked="{Binding BoldLyrics, Mode=TwoWay}"
                                Name="BoldLyricsToggle" />
                            <ToggleSwitch Content="{Translate {x:Static i18n:LanguageManager+Keys.ShowRomanization}}" IsChecked="{Binding ShowRomanization, Mode=TwoWay}" />
                            <ToggleSwitch Content="{Translate {x:Static i18n:LanguageManager+Keys.ShowTranslation}}" IsChecked="{Binding ShowTranslation, Mode=TwoWay}" />
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.LyricsAlignment}}" />
                                <Grid ColumnDefinitions="*,*">
                                    <Button
                                        Classes="lyricAlignment"
                                        Classes.active="{Binding IsLeftAligned}"
                                        Command="{Binding AlignLeftCommand}"
                                        Content="{Translate {x:Static i18n:LanguageManager+Keys.AlignLeft}}"
                                        Margin="0,0,4,0"
                                        Name="AlignLeftButton" />
                                    <Button
                                        Classes="lyricAlignment"
                                        Classes.active="{Binding IsCenterAligned}"
                                        Command="{Binding AlignCenterCommand}"
                                        Content="{Translate {x:Static i18n:LanguageManager+Keys.AlignCenter}}"
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        Name="AlignCenterButton" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>
        <Border
            Background="{DynamicResource Brush.DangerSoft}"
            CornerRadius="10"
            Grid.Row="1"
            IsVisible="{Binding HasError}"
            Margin="0,0,0,12"
            Padding="14">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    Foreground="{DynamicResource Brush.Danger}"
                    MaxHeight="90"
                    Text="{Binding Error}"
                    TextWrapping="Wrap" />
                <Button
                    AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.DismissError}}"
                    Classes="ghost icon"
                    Command="{Binding DismissErrorCommand}"
                    Grid.Column="1">
                    <Path Classes="icon" Data="{StaticResource Icon.Close}" />
                </Button>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <sharedControls:EmptyState
                Description="{Translate {x:Static i18n:LanguageManager+Keys.NoTrackDescription}}"
                Icon="{StaticResource Icon.Music}"
                IsVisible="{Binding !Playback.HasCurrentTrack}"
                Title="{Translate {x:Static i18n:LanguageManager+Keys.NoTrack}}" />
            <Grid
                ColumnDefinitions="3*,4*"
                IsVisible="{Binding Playback.HasCurrentTrack}"
                Margin="{DynamicResource Space.PlaybackInset}"
                Name="ListeningGrid">
                <Border
                    BoxShadow="0 12 32 0 #24000000"
                    CornerRadius="24"
                    HorizontalAlignment="Center"
                    Margin="0,0,28,0"
                    Name="CoverArea"
                    VerticalAlignment="Center">
                    <sharedControls:TransitionArtwork
                        AutomationProperties.Name="{Binding Playback.NowTitle}"
                        CornerRadius="24"
                        Name="NowPlayingCover"
                        ReduceMotion="{Binding ReduceMotion}"
                        Source="{Binding Playback.NowArtworkReference}" />
                </Border>
                <lyricsControls:LyricsPresenter
                    BoldLyrics="{Binding BoldLyrics}"
                    CanSeek="{Binding Playback.CanSeek}"
                    Document="{Binding Document}"
                    EmptyText="{Binding LyricsText}"
                    FollowLabel="{Translate {x:Static i18n:LanguageManager+Keys.FollowCurrentLyric}}"
                    FontSize="{Binding LyricFontSize}"
                    LyricFontFamilies="{Binding LyricFontFamilies}"
                    Foreground="{DynamicResource Brush.LyricText}"
                    Grid.Column="1"
                    IsPlaying="{Binding Playback.IsPlaying}"
                    IsStopped="{Binding IsStopped}"
                    MaxWidth="880"
                    Name="LyricsTimeline"
                    PositionMilliseconds="{Binding PositionMilliseconds}"
                    ReachedBrush="{DynamicResource Brush.LyricHighlight}"
                    ReduceMotion="{Binding ReduceMotion}"
                    SeekCommand="{Binding SeekLyricCommand}"
                    ShowRomanization="{Binding ShowRomanization}"
                    ShowTranslation="{Binding ShowTranslation}"
                    SubTextOpacity="0.8"
                    TextAlignment="{Binding LyricTextAlignment}"
                    UnreachedBrush="{DynamicResource Brush.LyricText}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
