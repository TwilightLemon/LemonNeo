<Window
    Background="#01000000"
    CanMaximize="False"
    CanMinimize="False"
    CanResize="True"
    Height="300"
    MinHeight="110"
    MinWidth="320"
    ShowActivated="False"
    ShowInTaskbar="False"
    SizeToContent="Manual"
    Title="{Translate {x:Static i18n:LanguageManager+Keys.DesktopLyrics}}"
    Topmost="True"
    TransparencyBackgroundFallback="#D9202328"
    TransparencyLevelHint="Transparent"
    Width="760"
    WindowDecorations="None"
    WindowStartupLocation="Manual"
    x:Class="LemonNeo.Desktop.Views.Lyrics.DesktopLyricsWindow"
    x:DataType="lyricsVm:LyricsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:i18n="using:LemonNeo.Desktop.Services"
    xmlns:lyricsControls="using:LemonNeo.Desktop.Controls.Lyrics"
    xmlns:lyricsVm="using:LemonNeo.Desktop.ViewModels.Lyrics"
    xmlns:sharedControls="using:LemonNeo.Desktop.Controls.Shared"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.Styles>
        <Style Selector="Border#HoverCard">
            <Setter Property="Background" Value="#01000000" />
        </Style>
        <Style Selector="Border#HoverCard:pointerover, Border#HoverCard.settingsOpen">
            <Setter Property="Background" Value="#D9202328" />
        </Style>
        <Style Selector="Border#Toolbar">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border#HoverCard:pointerover Border#Toolbar, Border#HoverCard.settingsOpen Border#Toolbar">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Button.desktopControl">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style Selector="Button.desktopControl Path.icon">
            <Setter Property="Fill" Value="White" />
        </Style>
        <Style Selector="Button.lineMode.active">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
        </Style>
    </Window.Styles>
    <!--  A nearly transparent input surface receives hover/drag on both native backends.  -->
    <Border
        CornerRadius="16"
        Margin="6"
        Name="HoverCard"
        Padding="16,6,16,14"
        PointerPressed="OnDragWindow">
        <Grid Name="DesktopLayout" RowDefinitions="40,*,Auto">
            <Border Name="Toolbar" VerticalAlignment="Center">
                <Grid Name="ToolbarLayout" ColumnDefinitions="*,Auto,*">
                    <TextBlock
                        Name="ToolbarDragHandle"
                        FontSize="20"
                        Foreground="#BFFFFFFF"
                        Text="⋮⋮"
                        ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.DragDesktopLyrics}}"
                        VerticalAlignment="Center" />
                    <StackPanel
                        Grid.Column="1"
                        Name="ToolbarButtons"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Previous}}"
                            Classes="ghost desktopControl"
                            Command="{Binding Playback.PreviousCommand}"
                            IsEnabled="{Binding Playback.CanPrevious}"
                            Name="DesktopPreviousButton"
                            ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Previous}}">
                            <Path Classes="icon" Data="{StaticResource Icon.Previous}" />
                        </Button>
                        <Button
                            AutomationProperties.Name="{Binding Playback.PlayLabel}"
                            Classes="ghost desktopControl"
                            Command="{Binding Playback.TogglePlaybackCommand}"
                            IsEnabled="{Binding Playback.CanTogglePlayback}"
                            Name="DesktopPlayPauseButton"
                            ToolTip.Tip="{Binding Playback.PlayLabel}">
                            <Grid>
                                <Path
                                    Classes="icon"
                                    Data="{StaticResource Icon.Play}"
                                    IsVisible="{Binding !Playback.IsPlaying}" />
                                <Path
                                    Classes="icon"
                                    Data="{StaticResource Icon.Pause}"
                                    IsVisible="{Binding Playback.IsPlaying}" />
                            </Grid>
                        </Button>
                        <Button
                            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.Next}}"
                            Classes="ghost desktopControl"
                            Command="{Binding Playback.NextCommand}"
                            IsEnabled="{Binding Playback.CanNext}"
                            Name="DesktopNextButton"
                            ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.Next}}">
                            <Path Classes="icon" Data="{StaticResource Icon.Next}" />
                        </Button>
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        Name="ToolbarActions"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button
                            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.LyricsDisplaySettings}}"
                            Classes="ghost desktopControl"
                            Name="DesktopLyricsSettingsButton"
                            ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.LyricsDisplaySettings}}">
                            <Path Classes="icon" Data="{StaticResource Icon.Settings}" />
                            <Button.Flyout>
                                <Flyout
                                    Closed="OnSettingsClosed"
                                    Opened="OnSettingsOpened"
                                    Placement="TopEdgeAlignedRight">
                                    <StackPanel
                                        Margin="8"
                                        Spacing="16"
                                        Width="240">
                                        <TextBlock Classes="section" Text="{Translate {x:Static i18n:LanguageManager+Keys.DesktopLyrics}}" />
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.LyricsDisplayMode}}" />
                                            <Grid ColumnDefinitions="*,*">
                                                <Button Classes="lineMode" Classes.active="{Binding IsHorizontalDesktopLyrics}"
                                                    Command="{Binding HorizontalDesktopLyricsCommand}"
                                                    Content="{Translate {x:Static i18n:LanguageManager+Keys.HorizontalLyrics}}" Margin="0,0,4,0" />
                                                <Button Grid.Column="1" Classes="lineMode" Classes.active="{Binding IsVerticalDesktopLyrics}"
                                                    Command="{Binding VerticalDesktopLyricsCommand}"
                                                    Content="{Translate {x:Static i18n:LanguageManager+Keys.VerticalLyrics}}" Margin="4,0,0,0" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.LyricsFontFamilies}}" />
                                            <sharedControls:FontFamilyPicker
                                                Name="DesktopLyricsFontPicker"
                                                AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.LyricsFontFamilies}}"
                                                PlaceholderText="{Translate {x:Static i18n:LanguageManager+Keys.FontFamiliesHint}}"
                                                SelectedFamilies="{Binding DesktopLyricFontFamilies, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.DesktopLyricsLines}}" />
                                            <Grid ColumnDefinitions="*,*">
                                                <Button
                                                    Classes="lineMode"
                                                    Classes.active="{Binding IsSingleDesktopLine}"
                                                    Command="{Binding SingleDesktopLineCommand}"
                                                    Content="{Translate {x:Static i18n:LanguageManager+Keys.SingleLyricLine}}"
                                                    Margin="0,0,4,0" />
                                                <Button
                                                    Classes="lineMode"
                                                    Classes.active="{Binding IsTwoDesktopLines}"
                                                    Command="{Binding TwoDesktopLinesCommand}"
                                                    Content="{Translate {x:Static i18n:LanguageManager+Keys.TwoLyricLines}}"
                                                    Grid.Column="1"
                                                    Margin="4,0,0,0" />
                                            </Grid>
                                        </StackPanel>
                                        <ToggleSwitch Content="{Translate {x:Static i18n:LanguageManager+Keys.ShowTranslation}}" IsChecked="{Binding DesktopShowTranslation, Mode=TwoWay}" />
                                        <ToggleSwitch Content="{Translate {x:Static i18n:LanguageManager+Keys.ShowRomanization}}" IsChecked="{Binding DesktopShowRomanization, Mode=TwoWay}" />
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{Translate {x:Static i18n:LanguageManager+Keys.LyricsFontSize}}" />
                                            <Slider
                                                AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.LyricsFontSize}}"
                                                IsSnapToTickEnabled="True"
                                                Maximum="64"
                                                Minimum="16"
                                                TickFrequency="1"
                                                Value="{Binding DesktopLyricFontSize, Mode=TwoWay}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button
                            AutomationProperties.Name="{Translate {x:Static i18n:LanguageManager+Keys.CloseDesktopLyrics}}"
                            Classes="ghost desktopControl"
                            Click="OnCloseWindow"
                            Name="DesktopLyricsCloseButton"
                            ToolTip.Tip="{Translate {x:Static i18n:LanguageManager+Keys.CloseDesktopLyrics}}">
                            <Path
                                Classes="icon"
                                Data="{StaticResource Icon.Close}"
                                Height="14"
                                Width="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <lyricsControls:LyricsPresenter
                BoldLyrics="True"
                Document="{Binding Document}"
                DurationMilliseconds="{Binding DurationMilliseconds}"
                EmptyText="{Binding Playback.NowTitle}"
                FontSize="{Binding DesktopLyricFontSize}"
                LyricFontFamilies="{Binding DesktopLyricFontFamilies}"
                IsVertical="{Binding IsVerticalDesktopLyrics}"
                Foreground="White"
                Grid.Row="1"
                IsPlaying="{Binding Playback.IsPlaying}"
                IsStopped="{Binding IsStopped}"
                MinHeight="40"
                Name="DesktopLyricsTimeline"
                PositionMilliseconds="{Binding PositionMilliseconds}"
                ReachedBrush="{DynamicResource Brush.Accent}"
                ReduceMotion="{Binding ReduceMotion}"
                ShowRomanization="{Binding DesktopShowRomanization}"
                ShowTranslation="{Binding DesktopShowTranslation}"
                TextAlignment="Center"
                UnreachedBrush="White"
                VisibleLineCount="{Binding DesktopLyricLineCount}">
                <lyricsControls:LyricsPresenter.Effect>
                    <DropShadowEffect
                        BlurRadius="4"
                        Color="Black"
                        OffsetX="0"
                        OffsetY="1"
                        Opacity="1" />
                </lyricsControls:LyricsPresenter.Effect>
            </lyricsControls:LyricsPresenter>
            <TextBlock
                Foreground="#FFFFB4AB"
                Grid.Row="2"
                IsVisible="{Binding HasError}"
                Margin="0,8,0,0"
                Name="DesktopLyricsError"
                Text="{Binding Error}"
                TextWrapping="Wrap" />
        </Grid>
    </Border>
</Window>
