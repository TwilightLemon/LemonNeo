<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <ApplicationIcon>Resources/Icons/App.ico</ApplicationIcon>
        <Version>0.1.3</Version>
        <IsLemonNeoHost>true</IsLemonNeoHost>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="LemonNeo.Tests" />
        <AvaloniaResource Include="Resources/Icons/App.ico" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
        <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Irihi.Lingua" Version="1.0.0" />
        <AdditionalFiles Include="Resources/Languages/*.json" />
        <ProjectReference Include="../LemonNeo.Hosting/LemonNeo.Hosting.csproj" />
        <ProjectReference Include="../LemonNeo.Application/LemonNeo.Application.csproj" />
        <ProjectReference Include="../LemonNeo.Abstractions/LemonNeo.Abstractions.csproj" />
        <ProjectReference Include="../LemonNeo.Core/LemonNeo.Core.csproj" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.13" />
    </ItemGroup>
    <ItemGroup>
      <Folder Include="Properties\" />
    </ItemGroup>
</Project>
