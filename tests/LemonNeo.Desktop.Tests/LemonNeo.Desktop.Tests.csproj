<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <ProjectReference Include="../../src/LemonNeo.Desktop/LemonNeo.Desktop.csproj" />
    <ProjectReference Include="../../plugins/LemonNeo.Plugin.LocalMusic/LemonNeo.Plugin.LocalMusic.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyLocalMusicTestPlugin" AfterTargets="Build">
    <ItemGroup>
      <LocalMusicTestAsset Include="../../plugins/LemonNeo.Plugin.LocalMusic/bin/$(Configuration)/net10.0/*" />
    </ItemGroup>
    <Copy SourceFiles="@(LocalMusicTestAsset)" DestinationFolder="$(TargetDir)plugins/LemonNeo.Plugin.LocalMusic/" SkipUnchangedFiles="true" />
  </Target>
</Project>
