<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="../../src/LemonNeo.Core/LemonNeo.Core.csproj" />
    <ProjectReference Include="../../src/LemonNeo.Plugin.Abstractions/LemonNeo.Plugin.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="DeployToPrototypeHost" AfterTargets="Build">
    <PropertyGroup>
      <PrototypePluginDirectory>$(MSBuildProjectDirectory)\..\..\src\LemonNeo.Console\bin\$(Configuration)\$(TargetFramework)\plugins\LemonNeo.Plugin.MockMusic\</PrototypePluginDirectory>
    </PropertyGroup>
    <MakeDir Directories="$(PrototypePluginDirectory)" />
    <ItemGroup>
      <PrototypePluginFiles Include="$(TargetPath)" />
      <PrototypePluginFiles Include="$(TargetDir)plugin.json" />
    </ItemGroup>
    <Copy SourceFiles="@(PrototypePluginFiles)"
          DestinationFolder="$(PrototypePluginDirectory)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
