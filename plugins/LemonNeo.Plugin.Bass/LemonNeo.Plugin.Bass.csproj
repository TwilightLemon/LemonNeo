<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/LemonNeo.Core/LemonNeo.Core.csproj"/>
        <ProjectReference Include="../../src/LemonNeo.Abstractions/LemonNeo.Abstractions.csproj"/>
        <Reference Include="Bass.Net">
            <HintPath>lib/Bass.Net.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>
    <ItemGroup>
        <None Update="plugin.json"
              CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest"/>
        <None Update="lib/win-x64/*.dll"
              Link="runtimes/win-x64/native/%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest"/>
        <None Update="lib/win-x86/*.dll"
              Link="runtimes/win-x86/native/%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest"/>
        <None Update="lib/linux-x64/*.so"
              Link="runtimes/linux-x64/native/%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest"/>
        <None Update="lib/linux-x86/*.so"
              Link="runtimes/linux-x86/native/%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest"/>
        <None Update="lib/linux-arm/*.so"
              Link="runtimes/linux-arm/native/%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest"/>
        <None Update="lib/linux-arm64/*.so"
              Link="runtimes/linux-arm64/native/%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest"/>
        <None Update="lib/osx-x64/*.dylib"
              Link="runtimes/osx-x64/native/%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest"/>
        <None Update="lib/osx-arm64/*.dylib"
              Link="runtimes/osx-arm64/native/%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest"/>
    </ItemGroup>
</Project>
