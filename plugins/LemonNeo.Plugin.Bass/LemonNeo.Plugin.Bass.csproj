<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="../../src/LemonNeo.Core/LemonNeo.Core.csproj" />
    <ProjectReference Include="../../src/LemonNeo.Plugin.Abstractions/LemonNeo.Plugin.Abstractions.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="Bass.Net">
      <HintPath>lib/Bass.Net.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="lib/win-x64/bass.dll"
          Link="runtimes/win-x64/native/bass.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="lib/win-x64/bassflac.dll"
          Link="runtimes/win-x64/native/bassflac.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="lib/win-x86/bass.dll"
          Link="runtimes/win-x86/native/bass.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="lib/win-x86/bassflac.dll"
          Link="runtimes/win-x86/native/bassflac.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="DeployToPrototypeHost" AfterTargets="Build">
    <PropertyGroup>
      <PrototypePluginDirectory>$(MSBuildProjectDirectory)\..\..\src\LemonNeo.Console\bin\$(Configuration)\$(TargetFramework)\plugins\LemonNeo.Plugin.Bass\</PrototypePluginDirectory>
    </PropertyGroup>
    <MakeDir Directories="$(PrototypePluginDirectory)" />
    <MakeDir Directories="$(PrototypePluginDirectory)runtimes\win-x64\native" />
    <MakeDir Directories="$(PrototypePluginDirectory)runtimes\win-x86\native" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)plugin.json;$(TargetDir)Bass.Net.dll"
          DestinationFolder="$(PrototypePluginDirectory)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)runtimes\win-x64\native\bass.dll;$(TargetDir)runtimes\win-x64\native\bassflac.dll"
          DestinationFolder="$(PrototypePluginDirectory)runtimes\win-x64\native"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)runtimes\win-x86\native\bass.dll;$(TargetDir)runtimes\win-x86\native\bassflac.dll"
          DestinationFolder="$(PrototypePluginDirectory)runtimes\win-x86\native"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
